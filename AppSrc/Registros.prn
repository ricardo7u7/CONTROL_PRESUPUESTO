80592>>>    Procedure AutoLocateDFFiles String sReportId
80594>>>        Integer eDatabaseMainType iTables iTable iSubReports iSubReport
80594>>>        String sOpenPath sDatabaseName sTableSchema sReportName sSubReportId
80594>>>        Boolean bIsFileList
80594>>>
80594>>>        Get DatabaseMainType sReportId to eDatabaseMainType
80595>>>        If (eDatabaseMainType = C_DRDF) Begin
80597>>>            Get_Attribute DF_OPEN_PATH to sOpenPath
80600>>>            Set psDatabaseConnection sReportId to sOpenPath
80601>>>
80601>>>            // This might the filelist or the first table name. If filelist we replace with the
80601>>>            // current filelist name. We find out if it is the filelist by calling a method
80601>>>            // IsFileList which Returns True when the file extension is .cfg.
80601>>>            Get psDatabaseName sReportId to sDatabaseName
80602>>>            Get IsFileList sDatabaseName to bIsFileList
80603>>>            If (bIsFileList) Begin
80605>>>                Get_Attribute DF_FILELIST_NAME to sDatabaseName
80608>>>                If (sDatabaseName <> "") Begin
80610>>>                    Set psDatabaseName sReportId to sDatabaseName
80611>>>                End
80611>>>>
80611>>>                Else Begin
80612>>>                    Error DFERR_CANT_OPEN_FILE_LIST
80613>>>>
80613>>>                End
80613>>>>
80613>>>            End
80613>>>>
80613>>>            Else Begin
80614>>>                If (not (DoesFileExist (sDatabaseName))) Begin
80616>>>                    Move (ExtractFileName (sDatabaseName)) to sDatabaseName
80617>>>                    Get FindTablePath sDatabaseName to sDatabaseName
80618>>>                    If (sDatabaseName <> "") Begin
80620>>>                        Set psDatabaseName sReportId to sDatabaseName
80621>>>                    End
80621>>>>
80621>>>                End
80621>>>>
80621>>>            End
80621>>>>
80621>>>            Get TableCount sReportId to iTables
80622>>>            If (iTables >= 1) Begin
80624>>>                // Enumerate the tables and change the table schema
80624>>>                Decrement iTables
80625>>>                For iTable from 0 to iTables
80631>>>>
80631>>>                    Get psTableSchema sReportId iTable to sTableSchema
80632>>>                    // sTableSchema is blank when the table was opened via the filelist
80632>>>                    If (sTableSchema <> "") Begin
80634>>>                        If (not (DoesFileExist (sTableSchema))) Begin
80636>>>                            Move (ExtractFileName (sTableSchema)) to sTableSchema
80637>>>                            Get FindTablePath sTableSchema to sTableSchema
80638>>>                            If (sTableSchema <> "") Begin
80640>>>                                Set psTableSchema sReportId iTable to sTableSchema
80641>>>                            End
80641>>>>
80641>>>                            Else Begin
80642>>>                                Get psReportName to sReportName
80643>>>                                Get psTableSchema sReportId iTable to sTableSchema
80644>>>                                Error DFERR_DATAFLEX_REPORTS (Sformat (C_$DRCannotLocateTable, sTableSchema, sReportName, iTable))
80645>>>>
80645>>>                            End
80645>>>>
80645>>>                        End
80645>>>>
80645>>>                    End
80645>>>>
80645>>>                Loop
80646>>>>
80646>>>            End
80646>>>>
80646>>>        End
80646>>>>
80646>>>
80646>>>        Get SubReportCount sReportId to iSubReports
80647>>>        Decrement iSubReports
80648>>>        For iSubReport from 0 to iSubReports
80654>>>>
80654>>>            Get SubReportId sReportId iSubReport to sSubReportId
80655>>>            Send AutoLocateDFFiles sSubReportId
80656>>>        Loop
80657>>>>
80657>>>    End_Procedure
