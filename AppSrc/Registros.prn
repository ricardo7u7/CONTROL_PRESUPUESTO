77425>>>            Case Begin
77425>>>                Case (ImageExportOptions.iImageType = C_drJPEG)
77427>>>                    Send CheckFileExtension of oFileNameForm ".jpg"
77428>>>                    Case Break
77429>>>                Case (ImageExportOptions.iImageType = C_drGIF)
77432>>>                    Send CheckFileExtension of oFileNameForm ".gif"
77433>>>                    Case Break
77434>>>                Case (ImageExportOptions.iImageType = C_drTIFF)
77437>>>                    Send CheckFileExtension of oFileNameForm ".tiff"
77438>>>                    Case Break
