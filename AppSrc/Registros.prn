83481>>>
83481>>>    // Returns the ID of the sub-report whose name is identical to the passed name
83481>>>    // If multiple sub-reports have the same name the first sub-report with this name
83481>>>    // will be returned
83481>>>    Function SubReportIDByName String sReportId String sSubReportName Returns String
83483>>>        Integer iSubReports iSubReport
83483>>>        String sSubReportId sReportName sReturnedReportId
83483>>>
83483>>>        If (sReportId = '') Begin
83485>>>            Get psReportId to sReportId
83486>>>        End
83486>>>>
83486>>>
83486>>>        Get SubReportCount sReportId to iSubReports
83487>>>        Decrement iSubReports
83488>>>        For iSubReport from 0 to iSubReports
83494>>>>
83494>>>            Get SubReportId sReportId iSubReport to sSubReportId
83495>>>            Get ComReportName sSubReportId to sReportName
83496>>>            If (Lowercase (sReportName) = Lowercase (sSubReportName)) Begin
83498>>>                Function_Return sSubReportId
83499>>>            End
83499>>>>
83499>>>            Get SubReportIDByName sSubReportId sSubReportName to sReturnedReportId
83500>>>            If (sReturnedReportId <> "") Begin
83502>>>                Function_Return sReturnedReportId
83503>>>            End
83503>>>>
83503>>>        Loop
83504>>>>
83504>>>
83504>>>        // This will only happen if no sub-report can be found with the passed name
83504>>>        Function_Return ''
83505>>>    End_Function
