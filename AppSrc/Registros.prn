84978>>>            Get AddTransparentImage "EqualHot.bmp" clLtGray  To iVoid // 2
84979>>>            Get AddTransparentImage "NextHot.bmp"  clLtGray  To iVoid // 3
84980>>>            Get AddTransparentImage "EndHot.bmp"   clLtGray  To iVoid // 4
84981>>>            Get AddTransparentImage "Prompt16.bmp" clFuchsia To iVoid // 5
84982>>>            Get AddTransparentImage "clr.bmp"      clLtGray  To iVoid // 6
84983>>>            Get AddTransparentImage "clra.bmp"     clLtGray  To iVoid // 7
84984>>>            Get AddTransparentImage "Save16.bmp"   clFuchsia To iVoid // 8
84985>>>            Get AddTransparentImage "Delete16.bmp" clFuchsia To iVoid // 9
84986>>>            Get AddTransparentImage "Cut16.bmp"    clFuchsia To iVoid // 10
84987>>>            Get AddTransparentImage "Copy16.bmp"   clFuchsia To iVoid // 11
84988>>>            Get AddTransparentImage "Paste16.bmp"  clFuchsia To iVoid // 12
84989>>>        End_Procedure
84990>>>    End_Object
