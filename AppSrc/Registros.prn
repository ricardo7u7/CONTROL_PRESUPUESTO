86831>>>>>
86831>>>>>//*****************************************************************************
86831>>>>>//*** Class  : cSQLConnection                                               ***
86831>>>>>//*** Purpose: Connection object for embedded SQL                           ***
86831>>>>>//***                                                                       ***
86831>>>>>//*** Description:                                                          ***
86831>>>>>//***   This provides the ability to create a connection for a driver.      ***
86831>>>>>//***   It will contain child statement objects                             ***
86831>>>>>//*****************************************************************************
86831>>>>>
86831>>>>>Class cSQLConnection is an Array
86832>>>>>
86832>>>>>    Procedure Construct_object Integer Image
86834>>>>>        Forward Send Construct_object Image
86836>>>>>
86836>>>>>        Property Integer phCLIHandle      Public 0
86837>>>>>        Property String  psDriverID       Public ""
86838>>>>>        Property Integer piBindFile       Public 0
86839>>>>>
86839>>>>>        Set Delegation_mode to NO_Delegation
86840>>>>>    End_procedure // COnstruct_object
86841>>>>>
86841>>>>>
86841>>>>>
86841>>>>>    //***
86841>>>>>    //*** Procedure: StoreHandleInfo
86841>>>>>    //*** Purpose  : Store basic information about the statement handle.
86841>>>>>    //***
86841>>>>>
86841>>>>>    Procedure StoreHandleInfo Integer iCLIHandle String sDrvrId Integer iParentHandle
86843>>>>>        Set phCLIHandle      To iCLIHandle
86844>>>>>        Set psDriverID       To sDrvrId
86845>>>>>    End_Procedure // StoreHandleInfo
86846>>>>>
86846>>>>>
86846>>>>>
86846>>>>>    //***
86846>>>>>    //*** Procedure: FreeHandle
86846>>>>>    //*** Purpose : Destroys handle object and all child statement objects
86846>>>>>    //***
86846>>>>>    Procedure FreeHandle
86848>>>>>        Send Destroy_Object
86849>>>>>    End_Procedure // FreeHandle
86850>>>>>
86850>>>>>
86850>>>>>
86850>>>>>    //***
86850>>>>>    //*** Function: SQLConnect
86850>>>>>    //*** Purpose : Make a connectin to an embedded SQL server
86850>>>>>    //*** Returns : The DataFlex handle to the connection
86850>>>>>    //***
86850>>>>>
86850>>>>>    Function SQLConnect string sDrvrID String sConnect Returns Integer
86852>>>>>        Local Integer ihdbc
86852>>>>>        Local String  sEmpty
86852>>>>>
86852>>>>>        //*** Initialize
86852>>>>>        Move "" To sEmpty
86853>>>>>        Move 0  To ihdbc
86854>>>>>
86854>>>>>        Indicate Err False
86855>>>>>
86855>>>>>        //*** Call the driver function to connect
86855>>>>>        Call_driver 0 sDrvrId Function FUNC_SQLCONNECT ;                    Callback current_object ;                    Passing sConnect sEmpty 0 ;                    Result ihdbc
86860>>>>>
86860>>>>>        //*** If there was an error, make result invalid
86860>>>>>        If (Err) ;            Move 0 To ihdbc
86863>>>>>
86863>>>>>        //*** Check result and store it
86863>>>>>        If (ihdbc <> 0) ;            Send StoreHandleInfo ihdbc sDrvrId 0
86866>>>>>
86866>>>>>        //*** Return success status
86866>>>>>        Function_Return (ihdbc <> 0)
86867>>>>>    End_function // SQLConnect
86868>>>>>
86868>>>>>
86868>>>>>
86868>>>>>    //***
86868>>>>>    //*** Function: SQLFileConnect
86868>>>>>    //*** Purpose : Use a connection of an already open file
86868>>>>>    //***
86868>>>>>
86868>>>>>    Function SQLFileConnect Integer iFileNum Returns Integer
86870>>>>>        Local Integer ihdbc
86870>>>>>        Local Integer bIsOpen
86870>>>>>        Local String  sDrvrId
86870>>>>>        Local String  sEmpty
86870>>>>>
86870>>>>>        //*** Initialize
86870>>>>>        Move "" To sEmpty
86871>>>>>        Move 0  To ihdbc
86872>>>>>
86872>>>>>        //*** Check if file is open
86872>>>>>        Get_attribute DF_FILE_OPENED Of iFileNum To bIsOpen
86875>>>>>        If (bIsOpen) Begin
86877>>>>>            //*** Fill the driver id, assume longest is 255 characters
86877>>>>>            Move (Repeat(' ', 255)) To sDrvrId
86878>>>>>            Get_attribute DF_FILE_DRIVER Of iFileNum To sDrvrId
86881>>>>>
86881>>>>>            Indicate Err False
86882>>>>>
86882>>>>>            //*** Call the driver function to connect
86882>>>>>            Call_driver iFileNum sDrvrId Function FUNC_SQLFILECONNECT ;                        Callback current_object ;                        Passing sEmpty sEmpty 0 ;                        Result ihdbc
86887>>>>>
86887>>>>>            //*** If there was an error, make result invalid
86887>>>>>            If (Err) ;                Move 0 To ihdbc
86890>>>>>
86890>>>>>            //*** Check result and store it
86890>>>>>            If (ihdbc <> 0) Begin
86892>>>>>                //*** Somehow Call_driver overwrites the sDrvrId variable, restore it here
86892>>>>>                Get_attribute DF_FILE_DRIVER Of iFileNum To sDrvrId
86895>>>>>                Send StoreHandleInfo ihdbc sDrvrId 0
86896>>>>>
86896>>>>>                //*** Set filenum so it can be used for fetching
86896>>>>>                Set piBindFile To iFileNum
86897>>>>>            End
86897>>>>>>
86897>>>>>        End
86897>>>>>>
86897>>>>>
86897>>>>>        //*** Return success status
86897>>>>>        Function_Return (ihdbc <> 0)
86898>>>>>    End_Function // SQLFileConnect
86899>>>>>
86899>>>>>
86899>>>>>
86899>>>>>    //***
86899>>>>>    //*** Procedure: SQLDisconnect
86899>>>>>    //*** Purpose  : Disconnect from an embedded SQL server and free allocated
86899>>>>>    //***            resources
86899>>>>>    //***
86899>>>>>
86899>>>>>    Procedure SQLDisconnect
86901>>>>>        Local Integer ihdbc
86901>>>>>        Local Integer iVoid
86901>>>>>        Local String  sDrvrId
86901>>>>>        Local String  sEmpty
86901>>>>>
86901>>>>>        //*** Initialize
86901>>>>>        Move "" To sEmpty
86902>>>>>
86902>>>>>        //*** Get the cli handle
86902>>>>>        Get phCLIHandle To ihdbc
86903>>>>>        Get psDriverId To sDrvrId
86904>>>>>
86904>>>>>        //*** Free the CLI handle
86904>>>>>        If (ihdbc <> 0) Begin
86906>>>>>            //*** Call the driver function to disconnect
86906>>>>>            Call_driver 0 sDrvrId Function FUNC_SQLDISCONNECT ;                        Callback Current_object ;                        Passing sEmpty sEmpty ihdbc ;                        Result iVoid
86911>>>>>
86911>>>>>            //*** Free the DataFlex handle
86911>>>>>            Send FreeHandle
86912>>>>>        End
86912>>>>>>
86912>>>>>    End_Procedure // SQLDisconnect
86913>>>>>
86913>>>>>
86913>>>>>
86913>>>>>    //***
86913>>>>>    //*** Function: CreateHandle
86913>>>>>    //*** Purpose : Creates a child statement handle
86913>>>>>    //***
86913>>>>>
86913>>>>>    Function CreateHandle Returns Integer
86915>>>>>        Local Integer hSQL
86915>>>>>
86915>>>>>        Object oSQLStatement Is A cSQLStatement
86917>>>>>            Move current_object To hSQL
86918>>>>>        End_Object // oSQLStatement
86919>>>>>
86919>>>>>        //*** If the connection has a default Bind File, assign it to the
86919>>>>>        //*** statement object. The default is set when you open a file with a
86919>>>>>        //*** SetFileConnection command.
86919>>>>>        Set piBindFile Of hSQL To (piBindFile(Current_object))
86920>>>>>
86920>>>>>        Function_Return hSQL
86921>>>>>    End_Function // CreateHandle
86922>>>>>
86922>>>>>
86922>>>>>
86922>>>>>    //***
86922>>>>>    //*** Function: SQLOpen
86922>>>>>    //*** Prupose : Open a statement for use
86922>>>>>    //***
86922>>>>>
86922>>>>>    Function SQLOpen Returns Integer
86924>>>>>        Local Integer hDFHandle
86924>>>>>        Local Integer ihdbc
86924>>>>>        Local Integer ihstmt
86924>>>>>        Local Integer iVoid
86924>>>>>        Local String  sDrvrId
86924>>>>>        Local String  sEmpty
86924>>>>>
86924>>>>>        //*** Initialize
86924>>>>>        Move "" To sEmpty
86925>>>>>
86925>>>>>        //*** Get the cli handle to the connection
86925>>>>>        Get phCLIHandle To ihdbc
86926>>>>>        Get psDriverId  To sDrvrId
86927>>>>>
86927>>>>>        //*** Allocate a new handle and populate it
86927>>>>>        If (ihdbc <> 0) Begin
86929>>>>>            //**** Create a new DataFlex handle
86929>>>>>            Get CreateHandle To hDFHandle
86930>>>>>
86930>>>>>            //*** Call the driver function to allocate a statement handle
86930>>>>>            Call_driver 0 sDrvrId Function FUNC_SQLOPEN ;                        Callback Current_object ;                        Passing hDFHandle sEmpty ihdbc ;                        Result ihstmt
86935>>>>>
86935>>>>>            //*** If unsuccessful destroy DF side info
86935>>>>>            If (ihstmt = 0) Begin
86937>>>>>                Send FreeHandle to hDFHandle
86938>>>>>                Move 0 to hDFHandle
86939>>>>>            End
86939>>>>>>
86939>>>>>            Else ;                Send StoreHandleInfo to hDFHandle ihstmt sDrvrId ihdbc
86941>>>>>        End
86941>>>>>>
86941>>>>>
86941>>>>>        Function_return hDFHandle
86942>>>>>    End_function // SQLOpen
86943>>>>>
86943>>>>>End_Class // cSQLConnection
86944>>>>>
86944>>>>>
86944>>>>>
86944>>>>>//*****************************************************************************
86944>>>>>//*** Class  : cSQLHandlemanager                                            ***
86944>>>>>//*** Purpose: Manager for embedded SQL handles.                            ***
86944>>>>>//***                                                                       ***
86944>>>>>//*** Description:                                                          ***
86944>>>>>//***   We want to be able to use multiple drivers and multiple             ***
86944>>>>>//***   connections within a driver and multiple statements within a        ***
86944>>>>>//***   connection. To allow this we have palced our own handle logic on    ***
86944>>>>>//***   top of the driver handle logic. This way we can handle the          ***
86944>>>>>//***   situation where two driver handles may be equal.                    ***
86944>>>>>//*****************************************************************************
86944>>>>>
86944>>>>>Class cSQLHandleManager Is A Array
86945>>>>>
86945>>>>>    Procedure Construct_object Integer Image
86947>>>>>        Forward Send Construct_object Image
86949>>>>>
86949>>>>>        Property String  psDefaultDriver     Public ""
86950>>>>>        Property String  psDefaultConnection Public ""
86951>>>>>
86951>>>>>        Set Delegation_mode to NO_Delegation
86952>>>>>    End_procedure // COnstruct_object
86953>>>>>
86953>>>>>
86953>>>>>
86953>>>>>    //***
86953>>>>>    //*** Function: CreateHandle
86953>>>>>    //*** Purpose : Allocate memory for the desired type of handle
86953>>>>>    //***
86953>>>>>
86953>>>>>    Function CreateHandle Returns Integer
86955>>>>>        Local Integer hSQL
86955>>>>>
86955>>>>>        //*** Create a connection object
86955>>>>>        Object oSQLConnection Is A cSQLConnection
86957>>>>>            Move current_object To hSQL
86958>>>>>        End_Object // oSQLConnection
86959>>>>>
86959>>>>>        Function_Return hSQL
86960>>>>>    End_Function // CreateHandle
86961>>>>>
86961>>>>>
86961>>>>>
86961>>>>>    //***
86961>>>>>    //*** Procedure: SQLSetConnect
86961>>>>>    //*** Purpose  : Store default connection information
86961>>>>>    //***
86961>>>>>
86961>>>>>    Procedure SQLSetConnect String sDriver String sConnect
86963>>>>>        Set psDefaultDriver      To sDriver
86964>>>>>        Set psDefaultConnection  To sConnect
86965>>>>>    End_Procedure // SQLSetConnect
86966>>>>>
86966>>>>>
86966>>>>>
86966>>>>>    //***
86966>>>>>    //*** Function: SQLConnect
86966>>>>>    //*** Purpose : Make a connectin to an embedded SQL server
86966>>>>>    //*** Returns : The DataFlex handle to the connection
86966>>>>>    //***
86966>>>>>
86966>>>>>    Function SQLConnect String sDrvrID String sConnect Returns integer
86968>>>>>        Local Integer hDFHandle
86968>>>>>        Local Integer bOK
86968>>>>>
86968>>>>>        //*** Check arguments
86968>>>>>        If (sDrvrID = "" And sConnect = "") Begin
86970>>>>>            Get psDefaultDriver      To sDrvrId
86971>>>>>            Get psDefaultConnection  To sConnect
86972>>>>>        End
86972>>>>>>
86972>>>>>
86972>>>>>        //*** Allocate a new handle
86972>>>>>        Get CreateHandle To hDFHandle
86973>>>>>        Get SQLConnect of hDFHandle sDrvrID sConnect To bOK
86974>>>>>
86974>>>>>        //*** If failure, kill the handle and return a 0 handle
86974>>>>>        If (Not(bOK)) Begin
86976>>>>>            Send FreeHandle to hDFHandle
86977>>>>>            Move 0 to hDFHandle
86978>>>>>        End
86978>>>>>>
86978>>>>>
86978>>>>>        Function_return hDFHandle
86979>>>>>    End_function // SQLConnect
86980>>>>>
86980>>>>>
86980>>>>>
86980>>>>>    //***
86980>>>>>    //*** Function: SQLFileConnect
86980>>>>>    //*** Purpose : Make an existing connection available for use with Embedded
86980>>>>>    //***           SQL. The connection is identified by the number opf a file
86980>>>>>    //***           that is open for that connection.
86980>>>>>    //***
86980>>>>>
86980>>>>>    Function SQLFileConnect Integer iFileNum Returns Integer
86982>>>>>        Local Integer hDFHandle
86982>>>>>        Local Integer bOK
86982>>>>>
86982>>>>>        //*** Allocate a new handle
86982>>>>>        Get CreateHandle To hDFHandle
86983>>>>>        Get SQLFileConnect of hDFHandle iFileNum To bOK
86984>>>>>
86984>>>>>        //*** If failure, kill the handle and return a 0 handle
86984>>>>>        If (Not(bOK)) Begin
86986>>>>>            Send FreeHandle to hDFHandle
86987>>>>>            Move 0 to hDFHandle
86988>>>>>        End
86988>>>>>>
86988>>>>>
86988>>>>>        Function_return hDFHandle
86989>>>>>    End_Function // SQLFileConnect
86990>>>>>
86990>>>>>End_Class // cSQLHandleManager
86991>>>>>
86991>>>>>
86991>>>>>
86991>>>>>//***
86991>>>>>//*** Function: CreateSQLManager
86991>>>>>//*** Purpose : Create the embedded SQL manager, this is an internal function!
86991>>>>>//***
86991>>>>>
86991>>>>>Function CreateSQLmanager For Desktop Returns Integer
86993>>>>>    Local Integer hoSQlMngr
86993>>>>>
86993>>>>>    Object oSQLHandleManager Is A cSQLHandleManager
86995>>>>>        MOve Current_object To hoSQLMngr
86996>>>>>    End_Object // oSQLHandleManager
86997>>>>>
86997>>>>>    Function_Return hoSQLMngr
86998>>>>>End_Function // CreateSQLMngr
86999>>>>>
86999>>>>>//*** Make sure the object is global by creating it under DESKTOP
86999>>>>>Get CreateSQLManager Of Desktop To _embsqlghoSQLHandleMngr
