85171>>>>>>>    //***
85171>>>>>>>
85171>>>>>>>    Function CKRevision Returns String
85173>>>>>>>        Local String  sDriverID
85173>>>>>>>        Local String  sRevision
85173>>>>>>>        Local String  sVoid
85173>>>>>>>        Local Integer iRetval
85173>>>>>>>
85173>>>>>>>        Get psDriverID To sDriverID
85174>>>>>>>        If (sDRiverID <> "") Begin
85176>>>>>>>            Move (Repeat(" ", 255)) To sRevision
85177>>>>>>>            Call_Driver 0 sDRiverID Function CLI_CKREVISION Callback 0 Passing sRevision sVoid 0 Result iRetval
85182>>>>>>>        End
85182>>>>>>>>
85182>>>>>>>
85182>>>>>>>        Function_Return sRevision
85183>>>>>>>    End_Function // CKRevision
85184>>>>>>>
85184>>>>>>>
85184>>>>>>>
85184>>>>>>>    //***
85184>>>>>>>    //*** Function: ExtractPartFromRevision
85184>>>>>>>    //*** Purpose : Extarct the Nth part of a a.b.c.d revsion string.
85184>>>>>>>    //***
85184>>>>>>>    //*** Returns : The part version number or -1 if there is no such part number.
85184>>>>>>>    //***
85184>>>>>>>
85184>>>>>>>    Function ExtractPartFromRevision Integer iPartNum String sRevision Returns Integer
85186>>>>>>>        Local Integer iPartRev
85186>>>>>>>        Local Integer iCurrentPart
85186>>>>>>>        Local Integer iSeparatorPos
85186>>>>>>>
85186>>>>>>>        If (iPartNum > 4) ;            Function_Return -1
85189>>>>>>>
85189>>>>>>>        Move 0 To iCurrentPart
85190>>>>>>>        Repeat
85190>>>>>>>>
85190>>>>>>>            Move (Pos(".", sRevision)) To iSeparatorPos
85191>>>>>>>            If (iSeparatorPos > 0) Begin
85193>>>>>>>                Move (Left(sRevision, iSeparatorPos - 1)) To iPartRev
85194>>>>>>>                Move (Right(sRevision, Length(sRevision) - iSeparatorPos)) To sRevision
85195>>>>>>>                Increment iCurrentPart
85196>>>>>>>            End
85196>>>>>>>>
85196>>>>>>>            Else If (sRevision <> "") Begin
85199>>>>>>>                Move sRevision To iPartRev
85200>>>>>>>                Move "" To sRevision
85201>>>>>>>                Increment iCurrentPart
85202>>>>>>>            End
85202>>>>>>>>
85202>>>>>>>            Else ;                Move -1 To iPartRev
85204>>>>>>>        Until (iCurrentPart >= iPartNum Or iPartRev = -1)
85206>>>>>>>
85206>>>>>>>        Function_Return iPartRev
85207>>>>>>>    End_Function // EcxtractPartFromRevision
85208>>>>>>>
85208>>>>>>>
85208>>>>>>>
