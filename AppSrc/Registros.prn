86177>>>// *************************************************************************
86177>>>//  Public message. This is the default message. It is expected that you will
86177>>>//   create your own message to override this
86177>>>// *************************************************************************
86177>>>
86177>>>Procedure Activate_About
86180>>>   Send DoAbout "" "" "" "" ""
86181>>>End_Procedure
86182>>>
86182>>>// *************************************************************************
86182>>>//  Public message. It is expected that you will send this message (most
86182>>>//  likely from Activate_About. This creates an about object, activates it
86182>>>//  and destroys it when done. It is not exepected that you will augment this.
86182>>>// *************************************************************************
86182>>>
86182>>>Procedure DoAbout string sTitle string sVersion string sCopyRight string sAuthor string sBitmap
86185>>>        integer hoObj hoMain
86185>>>
86185>>>        // create object
86185>>>        Object About is an AboutDialog
86187>>>            // if no title passed use the label of the main panel
86187>>>            // (if a main panel exists).
86187>>>            if sTitle     eq '' Begin
86189>>>                Get Main_Window of desktop to hoMain
86190>>>                if hoMain Get Label of hoMain to sTitle
86193>>>            end
86193>>>>
86193>>>            set productname to sTitle
86194>>>            set version     to sVersion
86195>>>            set copyright   to sCopyRight
86196>>>            set author      to sAuthor
86197>>>            If sBitmap    ne '' ;               set logo to sBitMap // square bitmaps of 42x42 work best
86200>>>            Move self to hoObj // object Id
86201>>>        End_Object
86202>>>        Send Popup   of hoObj    // popup the about object
86203>>>        Send Destroy of hoObj // when done, it will be destroyed
86204>>>End_procedure
