85224>>>>>>>
85224>>>>>>>    //***
85224>>>>>>>    //*** Function: IsMinimalRevision
85224>>>>>>>    //*** Purpose : Determines if the CK conforms to a passed minimal revsion.
85224>>>>>>>    //***
85224>>>>>>>
85224>>>>>>>    Function IsMinimalRevision Integer iMajor Integer iMinor Integer iRelease Integer iBuild Returns Integer
85226>>>>>>>        If (iMajor < CKMajorRevision(Current_object)) ;            Function_return (TRUE)
85229>>>>>>>        Else If (iMajor = CKMajorRevision(Current_object)) Begin
85232>>>>>>>            If (iMinor < CKMinorRevision(Current_object)) ;                Function_return (TRUE)
85235>>>>>>>            Else If (iMinor = CKMinorRevision(Current_object)) Begin
85238>>>>>>>                If (iRelease < CKReleaseRevision(Current_object)) ;                    Function_return (TRUE)
85241>>>>>>>                Else If (iRelease = CKReleaseRevision(Current_object) And iBuild <= CKBuildRevision(Current_object)) ;                    Function_return (TRUE)
85245>>>>>>>            End
85245>>>>>>>>
85245>>>>>>>        End
85245>>>>>>>>
85245>>>>>>>
85245>>>>>>>        Function_Return (FALSE)
85246>>>>>>>    End_Function // IsMinimalRevision
