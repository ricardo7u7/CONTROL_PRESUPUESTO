82898>>>
82898>>>        Set pbCanceled to False
82899>>>
82899>>>        Send OnPrintReport (&hPrinterDlg)
82900>>>        Get pbCanceled to bCancel // Developer might have canceled the report
82901>>>        If (not (bCancel)) Begin
