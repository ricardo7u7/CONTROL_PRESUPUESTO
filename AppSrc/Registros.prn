83250>>>    // Attempts to map a DataFlex application table.column reference to a report table.column
83250>>>    // reference.
83250>>>    // Expected usage:
83250>>>    //    Get ReportTableColumnName sReportId File_Field Customer.Name to sTableColumnName
83250>>>    //    Above returns either a blank string when not found or a {Customer.Name}
83250>>>    Function ReportTableColumnName String sReportId Handle hTable Handle hColumn Returns String
83252>>>        Boolean bOpened
83252>>>        String sTableName sColumnName sTableColumnName
83252>>>        String sReportTableName sReportTableColumnName
83252>>>        Integer iTables iTable iColumns iColumn
83252>>>
83252>>>        Send RedirectErrorsToLocalHandler True
83253>>>
83253>>>        If (sReportId = C_USEMAINDRREPORTID) Begin
83255>>>            Get psReportId to sReportId
83256>>>        End
83256>>>>
83256>>>
83256>>>        If (sReportId <> "") Begin
83258>>>            Get_Attribute DF_FILE_OPENED of hTable to bOpened
83261>>>            If (bOpened) Begin
83263>>>                Get DataFlexTableName hTable to sTableName
83264>>>                Get_Attribute DF_FIELD_NAME of hTable hColumn to sColumnName
83267>>>
83267>>>                Get TableCount sReportId to iTables
83268>>>                Move 0 to iTable
83269>>>                While (iTable < iTables and sTableColumnName = "")
83273>>>                    Get psTableName sReportId iTable to sReportTableName
83274>>>                    If (Uppercase (sReportTableName) = Uppercase (sTableName)) Begin
83276>>>                        Get TableColumnCount sReportId iTable to iColumns
83277>>>                        Move 0 to iColumn
83278>>>                        While (iColumn < iColumns and sTableColumnName = "")
83282>>>                            Get TableColumnName sReportId iTable iColumn to sReportTableColumnName
83283>>>                            If (Uppercase (sReportTableColumnName) = Uppercase (sColumnName)) Begin
83285>>>                                Get TableAliasName sReportId iTable to sTableName
83286>>>                                Move ("{" - sReportTableName - "." - sReportTableColumnName - "}") to sTableColumnName
83287>>>                            End
83287>>>>
83287>>>                            Increment iColumn
83288>>>                        Loop
83289>>>>
83289>>>                    End
83289>>>>
83289>>>                    Increment iTable
83290>>>                Loop
83291>>>>
83291>>>            End
83291>>>>
83291>>>        End
83291>>>>
83291>>>
83291>>>        Send RedirectErrorsToLocalHandler False
83292>>>
83292>>>        Function_Return sTableColumnName
83293>>>    End_Function
