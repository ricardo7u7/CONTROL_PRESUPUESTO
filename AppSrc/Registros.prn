80693>>>    // All errors are directed to this method.
80693>>>    Procedure Error_Report Integer iErrNum Integer iErrLine String sErrMsg
80695>>>        Handle hoError
80695>>>        Boolean bInError bDisplayError bCancelIfError
80695>>>
80695>>>        Get pbInError to bInError
80696>>>        If (not (bInError)) Begin
80698>>>            Set pbInError to True // prevents recursion
80699>>>            Set pbHasErrors to True  // an error has occurred in the report
80700>>>            Send OnError iErrNum iErrLine sErrMsg
80701>>>            Get pbDisplayError to bDisplayError
80702>>>            If (bDisplayError) Begin // if we display, direct to old error object
80704>>>                Get phOldErrorObject to hoError
80705>>>                If (hoError <> 0) Begin
80707>>>                    Send Error_Report of hoError iErrNum iErrLine sErrMsg
80708>>>                End
80708>>>>
80708>>>                Else Begin
80709>>>                    Send Error_Report of Desktop iErrNum iErrLine sErrMsg
80710>>>                End
80710>>>>
80710>>>            End
80710>>>>
80710>>>            Get pbCancelIfError to bCancelIfError
80711>>>            If (bCancelIfError) Begin
80713>>>                Send CancelReport // Sets pbCanceled to true
80714>>>            End
80714>>>>
80714>>>            Set pbInError to False
80715>>>        End
80715>>>>
80715>>>    End_Procedure
80716>>>
80716>>>
80716>>>    // Enumerates the psDataPath to find the table and returns the path if present.
80716>>>    Function FindTablePath String sTableName Returns String
80718>>>        Handle hoWorkspace
80718>>>        Integer iDataPaths iDataPath
80718>>>        String sDataPaths sDataPath sTestTableName
80718>>>
80718>>>        If (ghoApplication > 0) Begin
80720>>>            Get phoWorkspace of ghoApplication to hoWorkspace
80721>>>            If (hoWorkspace > 0) Begin
80723>>>                Get psDataPath of hoWorkspace to sDataPaths
80724>>>                Get CountOfPaths of hoWorkspace sDataPaths to iDataPaths
80725>>>                For iDataPath from 1 to iDataPaths
80731>>>>
80731>>>                    Get PathAtIndex of hoWorkspace sDataPaths iDataPath to sDataPath
80732>>>                    Move (Trim (sDataPath)) to sDataPath
80733>>>                    If (Right (sDataPath, 1) <> SysConf (SYSCONF_DIR_SEPARATOR)) Begin
80735>>>                        Move (sDataPath - SysConf (SYSCONF_DIR_SEPARATOR)) to sDataPath
80736>>>                    End
80736>>>>
80736>>>                    Move (sDataPath - sTableName) to sTestTableName
80737>>>                    If (DoesFileExist (sTestTableName)) Begin
80739>>>                        Function_Return sTestTableName
80740>>>                    End
80740>>>>
80740>>>                Loop
80741>>>>
80741>>>            End
80741>>>>
80741>>>        End
80741>>>>
80741>>>
80741>>>        Function_Return ""
80742>>>    End_Function
