87776>>>              Get SQLColumnValue of hstmt69   4 to nTOTAL_PGO
87777>>>              Get SQLColumnValue of hstmt69   5 to nPENDIENTE_PAGO
87778>>>              Get SQLColumnValue of hstmt69   6 to nDISPONIBLE
87779>>>           End
87779>>>>
