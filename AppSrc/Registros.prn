87658>>>    Procedure Liquidar 
87661>>>        Local String sQ 
87661>>>        Local Handle hdbc69 hstmt69
87661>>>        Local Number nValor_Disponible nValor_Liquidar
87661>>>        
87661>>>        Move '' to sQ
87662>>>        Move 0  to nValor_Disponible
87663>>>        Append sQ " SELECT DISPONIBLE FROM dbo.fn_ObtenerTotalesPresupuesto(" PRESUPUESTO.NUMERO ",3, 'todos'); " 
