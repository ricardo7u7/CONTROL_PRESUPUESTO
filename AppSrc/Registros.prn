77934>>>>>>>Define PD_CURRENTPAGE                           for |CI$00400000 // If this flag is set, the Current Page radio button is selected. If none of the PD_PAGENUMS, PD_SELECTION, or PD_CURRENTPAGE flags is set, the All radio button is selected.
77934>>>>>>>Define PD_NOCURRENTPAGE                         for |CI$00800000 // Disables the Current Page radio button.
