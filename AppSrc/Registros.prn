81053>>>    // Method to enumerate all reports that contain the passed function name. Internal because of the byref usage. It
81053>>>    // is called from the ReportIdsForFunction function.
81053>>>    Procedure CollectReportIdsForFunction String sReportId String sFunctionName tReportFunctionId[] ByRef ReportFunctionIds
81055>>>        Integer iElement iFunction iSubReports iSubReport
81055>>>        String sSubReportId
81055>>>
81055>>>        Get FunctionIdByName sReportId sFunctionName to iFunction
81056>>>        If (iFunction >= 0) Begin
81058>>>            Move (SizeOfArray (ReportFunctionIds)) to iElement
81059>>>            Move iFunction to ReportFunctionIds[iElement].iFunction
81060>>>            Move sReportId to ReportFunctionIds[iElement].sReportId
81061>>>        End
81061>>>>
81061>>>
81061>>>        Get SubReportCount sReportId to iSubReports
81062>>>        If (iSubReports > 0) Begin
81064>>>            Decrement iSubReports
81065>>>            For iSubReport from 0 to iSubReports
81071>>>>
81071>>>                Get SubReportId sReportId iSubReport to sSubReportId
81072>>>                Send CollectReportIdsForFunction sSubReportId sFunctionName (&ReportFunctionIds)
81073>>>            Loop
81074>>>>
81074>>>        End
81074>>>>
81074>>>    End_Procedure
81075>>>
