86156>>>>>        Handle hoVersionInfo
86156>>>>>        Boolean bIncluded
86156>>>>>        Integer iMajor iMinor iRelease iBuild
86156>>>>>        String sLabel
86156>>>>>
86156>>>>>        Get Label Of oVersion To sLabel
86157>>>>>        If (sLabel = C_$VERSION) Begin
86159>>>>>            // set it To the version info Of the program, if available
86159>>>>>            If (ghoApplication <> 0) Begin
86161>>>>>                Get phoVersionInfo of ghoApplication to hoVersionInfo
86162>>>>>                If (hoVersionInfo <> 0) Begin
86164>>>>>                    Get pbIncluded of hoVersionInfo to bIncluded
86165>>>>>                    If (bIncluded) Begin
86167>>>>>                        Get piVersionMajor of hoVersionInfo to iMajor
86168>>>>>                        Get piVersionMinor of hoVersionInfo to iMinor
86169>>>>>                        Get piVersionRelease of hoVersionInfo to iRelease
86170>>>>>                        Get piVersionBuild of hoVersionInfo to iBuild
86171>>>>>                        Move (SFormat (C_$VERSION + ": %1.%2.%3.%4", iMajor, iMinor, iRelease, iBuild)) to sLabel
86172>>>>>                        Set Version to sLabel
86173>>>>>                    End
86173>>>>>>
86173>>>>>                End
86173>>>>>>
86173>>>>>            End
86173>>>>>>
86173>>>>>        End
86173>>>>>>
86173>>>>>
86173>>>>>        Forward Send End_Construct_Object
86175>>>>>    End_Procedure
