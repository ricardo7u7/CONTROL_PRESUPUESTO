86801>>>>>    //***
86801>>>>>    //*** Procedure: SQLFetchActivatesBuffer
86801>>>>>    //*** Purpose  : Setup a file that will be acivated after a succesfull
86801>>>>>    //***            fetch on the statement
86801>>>>>    //***
86801>>>>>
86801>>>>>    Procedure SQLFetchActivatesBuffer Integer iFileNum Integer bState
86803>>>>>        Local Integer ihdbc
86803>>>>>        Local Integer ihstmt
86803>>>>>        Local String  sDrvrId
86803>>>>>        Local Integer iResult
86803>>>>>        Local Integer bIsOpen
86803>>>>>        Local Integer iVoid
86803>>>>>        Local String  sFileType
86803>>>>>
86803>>>>>        //*** Check if file is open
86803>>>>>        Get_attribute DF_FILE_OPENED Of iFileNum To bIsOpen
86806>>>>>        If (bIsOpen) Begin
86808>>>>>            //*** Get the cli handle to the connection
86808>>>>>            Get phCLIHandle       To ihstmt
86809>>>>>            Get psDriverId        To sDrvrId
86810>>>>>            Get phStmtConnection  To ihdbc
86811>>>>>
86811>>>>>            //*** Call the procedure
86811>>>>>            If (ihstmt <> 0 And ihdbc <> 0 And sDrvrId <> "") Begin
86813>>>>>                //*** Check if the file has the correct type
86813>>>>>                Get_attribute DF_FILE_DRIVER Of iFileNum To sFileType
86816>>>>>                If (sFileType = sDrvrId) Begin
86818>>>>>                    //*** Setup the buffer
86818>>>>>                    Call_driver iFileNum sDrvrId Function FUNC_SQLBUFFERSTATUS ;                                Callback Current_Object ;                                Passing ihdbc bState ihstmt  ;                                Result iVoid
86823>>>>>                End
86823>>>>>>
86823>>>>>                Else ;                    Send StmtError CLIERR_SQLINVALID_BIND_FILE ("File" * String(iFileNum) * "type incompatible with statement ("  + sFileType + ")") "SQLBindFile"
86825>>>>>            End
86825>>>>>>
86825>>>>>            Else ;                Send HandleError ihstmt ihdbc sDrvrId "SQLFetchActivatesBuffer"
86827>>>>>        End
86827>>>>>>
86827>>>>>        Else ;            Send StmtError CLIERR_SQLINVALID_BUFFER ("File not open (number =" * String(iFileNum) + ")") "SQLFetchActivatesBuffer"
86829>>>>>    End_Procedure // SQLFetchActivatesBuffer
86830>>>>>
86830>>>>>End_Class // cSQLStatement
