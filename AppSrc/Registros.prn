85859>>>>>    Procedure Show_Systemresources
85861>>>>>        tWinMemoryStatusEx MemoryStatusInfo
85861>>>>>        tWinMemoryStatusEx MemoryStatusInfo
85861>>>>>        Integer iRetval
85861>>>>>
85861>>>>>        Move (SizeOfType (tWinMemoryStatusEx)) to MemoryStatusInfo.dwLength
85862>>>>>        Move (GlobalMemoryStatusEx (AddressOf (MemoryStatusInfo))) to iRetval
85863>>>>>        If (iRetval = 0) Begin
85865>>>>>            Move (ShowLastError ()) to iRetval
85866>>>>>        End
85866>>>>>>
85866>>>>>
85866>>>>>        Send AppendTextLn (SFormat (C_$AvailableMemory, MemoryStatusInfo.ullTotalPhys))
85867>>>>>        Send AppendTextLn (SFormat (C_$MemoryUtilization, MemoryStatusInfo.dwMemoryLoad))
85868>>>>>        Send AppendTextLn (SFormat (C_$AvailablePhysicalMemory, Real (MemoryStatusInfo.ullAvailPhys) / Real (MemoryStatusInfo.ullTotalPhys) * 100.0))
85869>>>>>        Send AppendTextLn (SFormat (C_$AvailablePagefileSpace, Real (MemoryStatusInfo.ullAvailPageFile) / Real (MemoryStatusInfo.ullTotalPageFile) * 100.0))
85870>>>>>        Send AppendTextLn (SFormat (C_$AvailableVirtualMemory, Real (MemoryStatusInfo.ullAvailVirtual) / Real (MemoryStatusInfo.ullTotalVirtual) * 100.0))
85871>>>>>    End_Procedure
