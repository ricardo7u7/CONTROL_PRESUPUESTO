76800>>>>>Function DRPathFindExtension Desktop String sPath Returns String
76802>>>>>    String sRetVal
76802>>>>>    Pointer pExtension pPath
76802>>>>>
76802>>>>>    Move (sPath - Character (0)) to sPath
76803>>>>>    Move (AddressOf (sPath)) to pPath
76804>>>>>    Move (DR_WinAPI_PathFindExtension (pPath)) to pExtension
76805>>>>>    Move (pExtension - pPath) to pPath
76806>>>>>    Move (Right (sPath, Length (sPath) - pPath)) to sRetVal
76807>>>>>
76807>>>>>    Function_Return (Trim (CString (sRetVal)))
76808>>>>>End_Function
76809>>>>>
76809>>>>>Function DRPathFindFileName Desktop String sPath Returns String
76811>>>>>    String sRetVal
76811>>>>>    Pointer pFileName pPath
76811>>>>>
76811>>>>>    Move (sPath - Character (0)) to sPath
76812>>>>>    Move (AddressOf (sPath)) to pPath
76813>>>>>    Move (DR_WinAPI_PathFindFileName (pPath)) to pFileName
76814>>>>>    Move (pFileName - pPath) to pPath
76815>>>>>    Move (Right (sPath, Length (sPath) - pPath)) to sRetVal
76816>>>>>
76816>>>>>    Function_Return (Trim (CString (sRetVal)))
76817>>>>>End_Function
