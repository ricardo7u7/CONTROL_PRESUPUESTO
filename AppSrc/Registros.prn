88535>>>    // RV 03/07/2025: VDF REPORT 
88535>>>     Object oReporte_VDF is a cDRReport
88537>>>            Set psReportName to 'PPTO.dr'
88538>>>            
88538>>>            Procedure OnInitializeReport 
88541>>>                // Basic Variables
88541>>>                String sReportId sUsuario sQuery3 sTemp  sEmpresa
88541>>>                Variant[][] vResultSQL 
88542>>>                Integer iRow iFicha
88542>>>                Handle  hdbc2 hstmt2
88542>>>                Local Date dFechaIni dFechaFin
88542>>>                Local String @Empresa @CtroCsto
88542>>>                Local Integer iNivel
88542>>>                Get psReportId  to sReportId
88543>>>                
88543>>>                // =============================  EJECUCION SQL =====================================
88543>>>                
88543>>>                Move 0 to iRow
88544>>>                Append sQuery3 "SELECT P.CLAVE, IIF( E.ES_FIJO_SN = 'S', 'Gastos Fijos', 'Gastos Variables'), E.DESCRIPCION, ";                                " CONVERT(VARCHAR, E.FECHA_REALIZADO, 103) AS FECHA_REALIZADO," ;                               " E.MONTO_PROYECTADO, E.MONTO, (E.MONTO_PROYECTADO - E.MONTO) AS DIFERENCIA FROM EGRESOS E ";                                " INNER JOIN TIPO_GASTO TG ON E.TIPO = TG.CLAVE INNER JOIN PRESUPUESTO P ON E.PRESUPUESTO = P.NUMERO " ;                               " WHERE E.PRESUPUESTO = " PRESUPUESTO.NUMERO " AND (E.MONTO <> 0 OR E.MONTO_PROYECTADO <> 0)" ;                               " ORDER BY E.ES_FIJO_SN DESC, E.MONTO DESC,  E.TIPO, FECHA_REALIZADO asc"
88552>>>                SQLFileConnect EGRESOS to hdbc2
88553>>>                SQLOpen hdbc2 to hstmt2
88556>>>                SQLExecDirect hstmt2 sQuery3 
88559>>>                
88559>>>                Repeat
88559>>>>
88559>>>                    SQLFileFetch hstmt2
88565>>>                    Number iSalarioTotal
88565>>>                    If (SQLResult <> 0) Begin
88567>>>                        Move (ToOEM(hstmt2)) to hstmt2 // TRADUCIMOS CON SIGNOS ESPECIALES
88568>>>                        Get SQLColumnValue of hstmt2 1 to vResultSQL[iRow][0] 
88569>>>                        Get SQLColumnValue of hstmt2 2 to vResultSQL[iRow][1] 
88570>>>                        Get SQLColumnValue of hstmt2 3 to vResultSQL[iRow][2] 
88571>>>                        Get SQLColumnValue of hstmt2 4 to vResultSQL[iRow][3] 
88572>>>                        Get SQLColumnValue of hstmt2 5 to vResultSQL[iRow][4] 
88573>>>                        Get SQLColumnValue of hstmt2 6 to vResultSQL[iRow][5] 
88574>>>                        Get SQLColumnValue of hstmt2 7 to vResultSQL[iRow][6] 
88575>>>//                        Get SQLColumnValue of hstmt2 8 to vResultSQL[iRow][7] 
88575>>>                    End
88575>>>>
88575>>>                    Increment iRow
88576>>>                Until (SQLResult = 0)  
88578>>>                
88578>>>                // CERRAR SQL ==========================================================================
88578>>>                Send SQLClose of hstmt2
88579>>>                Send SQLDisconnect of hdbc2
88580>>>                
88580>>>                tDRTableName[] TableNames
88580>>>                tDRTableName[] TableNames
88581>>>                Get RDSTableNames sReportId to TableNames
88582>>>                
88582>>>                //Enviar informacion a Tablas
88582>>>                Send TableData sReportId 0 vResultSQL
88583>>>                
88583>>>            End_Procedure
88584>>>            
88584>>>            Procedure PreviewClick
88587>>>            End_Procedure
88588>>>     End_Object // fin de VDF report
