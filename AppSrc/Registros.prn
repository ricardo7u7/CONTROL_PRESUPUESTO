79731>>>>>
79731>>>>>
79731>>>>>Class cCJSkinFramework is a cCJComSkinFramework
79732>>>>>    
79732>>>>>    Procedure Construct_Object
79734>>>>>        Forward Send Construct_Object
79736>>>>>        
79736>>>>>        Property String psSkinFile ""
79737>>>>>        Property String psSkinIni ""
79738>>>>>        Property Boolean pbLoadPreference False
79739>>>>>        
79739>>>>>        Set peAutoCreate to acAutoCreate
79740>>>>>        
79740>>>>>        Move Self to ghoSkinFramework
79741>>>>>    End_Procedure
79742>>>>>    
79742>>>>>    // return the default skin path, which is the programs directory.
79742>>>>>    // This requires an application object.
79742>>>>>    // If you want to different skin path, override this.
79742>>>>>    Function SkinPath Returns String
79744>>>>>        String sPath sPaths
79744>>>>>        Handle hoWorkspace
79744>>>>>        If ghoApplication Begin
79746>>>>>            Get phoWorkspace of ghoApplication to hoWorkspace
79747>>>>>            Get psProgramPath of hoWorkspace to sPaths
79748>>>>>            Get PathAtIndex of hoWorkspace sPaths 1 to sPath
79749>>>>>        End
79749>>>>>>
79749>>>>>        Else Begin
79750>>>>>            Error DFERR_PROGRAM C_$ApplicationObjectNotCreated
79751>>>>>>
79751>>>>>        End
79751>>>>>>
79751>>>>>        Function_Return sPath
79752>>>>>    End_Function
79753>>>>>    
79753>>>>>    // Returns the Qualified name of psSkinFile. If the file is already qualified it just
79753>>>>>    // returns itself. If it is not, it uses SkinPath to get the path.
79753>>>>>    Function SkinQFile Returns String
79755>>>>>        String sFile sPath sSep
79755>>>>>        Boolean bQualified
79755>>>>>        Get psSkinFile to sFile
79756>>>>>        If not (IsFileNameQualified(sFile)) Begin
79758>>>>>            Get SkinPath to sPath
79759>>>>>            Move (SysConf(SYSCONF_DIR_SEPARATOR)) to sSep
79760>>>>>            Move (sPath - sSep - sFile) to sFile
79761>>>>>        End
79761>>>>>>
79761>>>>>        Function_Return sFile
79762>>>>>    End_Function
79763>>>>>        
79763>>>>>    // defines the default VDF window class mapping.    
79763>>>>>    Procedure OnAddVDFWindowClasses
79765>>>>>        Send ComAddWindowClass "DFlistbox"               "ListBox"
79766>>>>>        Send ComAddWindowClass "DFentry"                 "Edit"
79767>>>>>        Send ComAddWindowClass "DFtextbox"               "Edit"
79768>>>>>        Send ComAddWindowClass "DFRichEditCtrl"          "Edit"
79769>>>>>        Send ComAddWindowClass "DFcombobox"              "ComboBox"
79770>>>>>        Send ComAddWindowClass "DFformlist"              "Edit"
79771>>>>>        Send ComAddWindowClass "DFFormListHeader"        "SysHeader32"
79772>>>>>        Send ComAddWindowClass "DFbutton"                "Button"
79773>>>>>        Send ComAddWindowClass "HPromptBtn"              "Button"
79774>>>>>        Send ComAddWindowClass "Hspinbtn"                "msctls_updown32"
79775>>>>>        Send ComAddWindowClass "DFSysTabControl32"       "SysTabControl32"
79776>>>>>        Send ComAddWindowClass "DFMDIClient"             "MDIClient" 
79777>>>>>        Send ComAddWindowClass "DFedit"                  "edit"
79778>>>>>        Send ComAddWindowClass "DFlistedit"              "edit"
79779>>>>>        Send ComAddWindowClass "DFscrollbar"             "scrollbar"
79780>>>>>        Send ComAddWindowClass "DFgroup"                 "Button"
79781>>>>>        Send ComAddWindowClass "DFComboGrid"             "ComboBox"
79782>>>>>        // External class
79782>>>>>        Send ComAddWindowClass "cVdfAnimation"           "SysAnimate32"
79783>>>>>        Send ComAddWindowClass "cVdfProgressBar"         "msctls_progress32"
79784>>>>>        Send ComAddWindowClass "cVdfStatusBar"           "msctls_statusbar32"
79785>>>>>        Send ComAddWindowClass "cVdfToolbar"             "ToolbarWindow32"
79786>>>>>        Send ComAddWindowClass "cObsoleteVdfProgressBar" "msctls_progress32"
79787>>>>>        Send ComAddWindowClass "cVdfTrackBar"            "msctls_trackbar32"
79788>>>>>        Send ComAddWindowClass "cObsoleteBasicStatusBar" "msctls_statusbar32"
79789>>>>>        Send ComAddWindowClass "cVdfTreeView"            "SysTreeView32"
79790>>>>>    End_Procedure
79791>>>>>    
79791>>>>>    // Used to support developer designed class mappings (e.g. COM controls)
79791>>>>>    Procedure OnAddCustomWindowClasses
79793>>>>>    End_Procedure
79794>>>>>
79794>>>>>    // called when object is created during end_construct_object.
79794>>>>>    Procedure OnCreate
79796>>>>>        Integer iOpts
79796>>>>>        Boolean bUseWindowsFont
79796>>>>>        Forward Send OnCreate
79798>>>>>        
79798>>>>>        // if we are using the windows fonts we will disable the apply metrics which
79798>>>>>        // never really looked good anyway. This test only exists or legacy purposes
79798>>>>>        Get pbUseWindowsFont of Desktop to bUseWindowsFont
79799>>>>>        If bUseWindowsFont Begin
79801>>>>>            Get ComApplyOptions to iOpts
79802>>>>>            Set ComApplyOptions to (RemoveBitValue(xtpSkinApplyMetrics, iOpts))
79803>>>>>        End
79803>>>>>>
79803>>>>>
79803>>>>>        // this works around a CJ issue where skins applied to other threads causes an exception upon close down. 
79803>>>>>        // We saw this with our mssql driver but it could occur elsewhere. This has been reported in the CJ newsgroup
79803>>>>>        // and this was the suggested workaround.
79803>>>>>        Set ComAutoApplyNewThreads to False
79804>>>>>
79804>>>>>        Send OnAddVDFWindowClasses
79805>>>>>        Send OnAddCustomWindowClasses
79806>>>>>        
79806>>>>>        // if preferences are used, it will set psSkinFile and psSkinIni
79806>>>>>        If (pbLoadPreference(Self)) Begin
79808>>>>>            Send LoadSkinPreference
79809>>>>>        End
79809>>>>>>
79809>>>>>        // if a skin file name exists, we apply the skin.    
79809>>>>>        If (psSkinFile(Self)<>"") Begin
79811>>>>>            Send ApplySkin
79812>>>>>        End        
79812>>>>>>
79812>>>>>    End_Procedure
79813>>>>>    
79813>>>>>    // called by framework as part of application exit.
79813>>>>>    Procedure Broadcast_Notify_Exit_Application
79815>>>>>        Send Notify_Exit_Application
79816>>>>>    End_Procedure // Notify_Exit_Application
79817>>>>>
79817>>>>>    Procedure Notify_Exit_Application
79819>>>>>        If (pbLoadPreference(Self)) Begin
79821>>>>>            Send SaveSkinPreference
79822>>>>>        End
79822>>>>>>
79822>>>>>    End_Procedure
79823>>>>>
79823>>>>>    Procedure NotifyPreApplySkin
