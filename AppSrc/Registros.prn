83235>>>    // This function retrieves the reports folder and if this exists it checks if there is
83235>>>    // a sub-folder with the name Cache and if that folder exists. If so the full pathname is returned.
83235>>>    Function ReportsCacheFolder Returns String
83237>>>        String sReportsFolder sCacheFolder
83237>>>        Boolean bIsDirectory
83237>>>
83237>>>        Get ReportsFolder to sReportsFolder
83238>>>        If (sReportsFolder <> '') Begin
83240>>>            If (Right (sReportsFolder, 1) <> SysConf (SYSCONF_DIR_SEPARATOR)) Begin
83242>>>                Move (sReportsFolder - SysConf (SYSCONF_DIR_SEPARATOR)) to sReportsFolder
83243>>>            End
83243>>>>
83243>>>
83243>>>            Move (sReportsFolder - "Cache\") to sCacheFolder
83244>>>            Get IsDirectory sCacheFolder to bIsDirectory
83245>>>            If (bIsDirectory) Begin
83247>>>                Function_Return sCacheFolder
83248>>>            End
83248>>>>
83248>>>        End
83248>>>>
83248>>>
83248>>>        Function_Return ''
83249>>>    End_Function
