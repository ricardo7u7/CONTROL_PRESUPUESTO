83160>>>                    Get ReportIdForFunction sSubReportId sFunctionName to ReportFunctionId
83161>>>                    If (ReportFunctionId.iFunction >= 0) Begin
83163>>>                        Function_Return ReportFunctionId
83164>>>                    End
83164>>>>
83164>>>                Loop
83165>>>>
83165>>>            End
83165>>>>
83165>>>        End
83165>>>>
83165>>>        Else Begin
83166>>>            Move sReportId to ReportFunctionId.sReportId
83167>>>        End
83167>>>>
83167>>>
83167>>>        Function_Return ReportFunctionId
83168>>>    End_Function
