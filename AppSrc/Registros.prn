83426>>>        Boolean bShowStatusPanel bIsActive
83426>>>        Handle hoStatusPanel
83426>>>        Integer eDelegationMode
83426>>>
83426>>>        Get pbShowStatusPanel to bShowStatusPanel
83427>>>        If (bShowStatusPanel) Begin
83429>>>            Get phoStatusPanel to hoStatusPanel
83430>>>            If (hoStatusPanel <> 0) Begin
83432>>>                Get Active_State of hoStatusPanel to bIsActive
83433>>>                If (bIsActive) Begin
83435>>>                    Register_Procedure SetStatusText
83435>>>                    Get Delegation_Mode of hoStatusPanel to eDelegationMode
83436>>>                    Set Delegation_Mode of hoStatusPanel to No_Delegate_Or_Error
83437>>>                    Send SetStatusText of hoStatusPanel C_$DRLoadingReportPleaseWait
83438>>>                    Set Delegation_Mode of hoStatusPanel to eDelegationMode
83439>>>                End
83439>>>>
83439>>>            End
83439>>>>
83439>>>        End
83439>>>>
83439>>>    End_Procedure
