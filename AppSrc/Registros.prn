81323>>>    Function ExportFileNamesSet String sExtension Integer iPageNumber Returns String[]
81325>>>        Integer iPages iPage iElement
81325>>>        String sCacheFolder sHEXUUID sBaseName
81325>>>        String[] sFileNames
