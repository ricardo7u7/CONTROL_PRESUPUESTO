84946>>>Use cToolbar.pkg
84946>>>
84946>>>// A toolbar for the Contacts sample.
84946>>>// shows:
84946>>>//    Buttons with text underneath (toolbar's pbShowLabels property set to True, and each button's psLabel property to the text)
84946>>>//    Multiline tooltips (embed "\n" in the psTooltip property to force a newline)
84946>>>//    "Hot" images, using a second imagelist (set the phoImageListHot property)
84946>>>
84946>>>Object oToolBar is a cToolBar
84948>>>    Set pbShowLabels To True // display the psLabel property on th button
84949>>>    Object oImages is a cImageList
84951>>>        Set piMaxImages To 12
84952>>>        Procedure OnCreate
84955>>>            Integer iVoid
84955>>>            Get AddTransparentImage "bgn.bmp"      clLtGray  To iVoid // 0
84956>>>            Get AddTransparentImage "prev.bmp"     clLtGray  To iVoid // 1
84957>>>            Get AddTransparentImage "equal.bmp"    clLtGray  To iVoid // 2
84958>>>            Get AddTransparentImage "next.bmp"     clLtGray  To iVoid // 3
84959>>>            Get AddTransparentImage "end.bmp"      clLtGray  To iVoid // 4
84960>>>            Get AddTransparentImage "Prompt16.bmp" clFuchsia To iVoid // 5
84961>>>            Get AddTransparentImage "clr.bmp"      clLtGray  To iVoid // 6
84962>>>            Get AddTransparentImage "clra.bmp"     clLtGray  To iVoid // 7
84963>>>            Get AddTransparentImage "Save16.bmp"   clFuchsia To iVoid // 8
84964>>>            Get AddTransparentImage "Delete16.bmp" clFuchsia To iVoid // 9
84965>>>            Get AddTransparentImage "Cut16.bmp"    clFuchsia To iVoid // 10
84966>>>            Get AddTransparentImage "Copy16.bmp"   clFuchsia To iVoid // 11
84967>>>            Get AddTransparentImage "Paste16.bmp"  clFuchsia To iVoid // 12
84968>>>        End_Procedure
84969>>>    End_Object
84970>>>    
84970>>>    Object oImagesHot is a cImageList
84972>>>        // These images are shown when the mouse cursor hovers over the button
84972>>>        // There must be a matching number of images in all imagelists.
84972>>>        Set piMaxImages To 12
84973>>>        Procedure OnCreate
84976>>>            Integer iVoid
