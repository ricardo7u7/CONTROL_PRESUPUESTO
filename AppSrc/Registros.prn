82908>>>                Procedure_Return
82909>>>            End
82909>>>>
82909>>>
82909>>>            Get IsComObjectCreated to bComObjectCreated
82910>>>            If (bComObjectCreated) Begin
82912>>>                Get piPreviewCurrentPage to iCurrentPage
82913>>>                If (hPrinterDlg <> 0) Begin
82915>>>                    Send DisplayStatusPanel True
82916>>>                    Send ComReportPrint sReportId hPrinterDlg
82917>>>                    Send DisplayStatusPanel False
82918>>>                End
82918>>>>
82918>>>                Else Begin
82919>>>                    Get phoPrintDialog to hoPrintDialog
82920>>>                    Get ReportPageCount to iPages
82921>>>                    Set piMaxPage of hoPrintDialog to iPages
82922>>>                    Send InitPageRanges Of hoPrintDialog iPages
82923>>>                    Get PaperOrientation sReportID to ePaperOrientation
82924>>>                    Get PaperSize sReportID to iPaperSize
82925>>>                    Set pePaperSize of hoPrintDialog to iPaperSize
82926>>>                    Set peOrientation of hoPrintDialog to ePaperOrientation
82927>>>                    Get psPrinterName to sPrinterName
82928>>>                    If (sPrinterName <> "") Begin
82930>>>                        Get ReadPrinterDevMode of hoPrintDialog sPrinterName to iResult
82931>>>                        If (iResult = PD_RESULT_CANCEL) Begin
82933>>>                            Get PrintDialog of hoPrintDialog to iResult
82934>>>                        End
82934>>>>
82934>>>                    End
82934>>>>
82934>>>                    Else Begin
82935>>>                        Get PrintDialog of hoPrintDialog to iResult
82936>>>                    End
82936>>>>
82936>>>                    If (iResult = PD_RESULT_PRINT) Begin
82938>>>                        Get phPrintDlg of hoPrintDialog to hPrinterDlg
82939>>>                        If (hPrinterDlg <> 0) Begin
82941>>>                            Send DisplayStatusPanel True
82942>>>                            Send ComReportPrint sReportId hPrinterDlg
82943>>>                            Send DisplayStatusPanel False
82944>>>                        End
82944>>>>
82944>>>                    End
82944>>>>
82944>>>                    Else Begin
82945>>>                        Set pbCanceled to True
82946>>>                    End
82946>>>>
82946>>>                End
82946>>>>
82946>>>                Set piPreviewCurrentPage to iCurrentPage
82947>>>            End
82947>>>>
82947>>>            Else Begin
82948>>>                Error DFERR_DATAFLEX_REPORTS (Sformat (C_$DRReportOCXNotInitialised, Name (Self)))
82949>>>>
82949>>>            End
82949>>>>
82949>>>        End
82949>>>>
82949>>>        Send OnPostPrintReport
82950>>>        Send CheckFunctionErrorInfo
82951>>>
82951>>>        Send RedirectErrorsToLocalHandler False
82952>>>    End_Procedure
