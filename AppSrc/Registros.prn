82599>>>    // Returns information about a given parameter in a given report. The returned information contains
82599>>>    // length, type, name, precision (if numeric)
82599>>>    Function ParameterInfo String sReportId Integer iParameter Returns tDRParameter
82601>>>        tDRParameter ParameterInfo
82601>>>        tDRParameter ParameterInfo
82601>>>        Boolean bComObjectCreated
82601>>>
82601>>>        Send RedirectErrorsToLocalHandler True
82602>>>
82602>>>        If (sReportId = C_USEMAINDRREPORTID) Begin
82604>>>            Get psReportId to sReportId
82605>>>        End
82605>>>>
82605>>>
82605>>>        If (sReportId <> "") Begin
82607>>>            Get IsComObjectCreated to bComObjectCreated
82608>>>            If (bComObjectCreated) Begin
82610>>>                Get ComParameterName sReportId iParameter to ParameterInfo.sName
82611>>>                Get ComParameterType sReportId iParameter to ParameterInfo.iType
82612>>>                Case Begin
82612>>>                    Case (ParameterInfo.iType = SQL_INTEGER)
82614>>>                        Move 10 to ParameterInfo.iLength
82615>>>                        Case Break
82616>>>                    Case (ParameterInfo.iType = SQL_DATETIME)
82619>>>                        Move 23 to ParameterInfo.iLength
82620>>>                        Case Break
82621>>>                    Case (ParameterInfo.iType = SQL_TIME)
82624>>>                    Case (ParameterInfo.iType = SQL_TYPE_TIME)
82627>>>                    Case (ParameterInfo.iType = SQL_TYPE_TIMESTAMP)
82630>>>                        Move 8 to ParameterInfo.iLength
82631>>>                        Case Break
82632>>>                    Case (ParameterInfo.iType = SQL_TYPE_DATE)
82635>>>                        Move 10 to ParameterInfo.iLength
82636>>>                        Case Break
82637>>>                    Case (ParameterInfo.iType = SQL_NUMERIC)
82640>>>                    Case (ParameterInfo.iType = SQL_DECIMAL)
82643>>>                    Case (ParameterInfo.iType = SQL_DOUBLE)
82646>>>                        Get ComParameterLength sReportId iParameter to ParameterInfo.iLength
82647>>>                        Get ComParameterPrecision sReportId iParameter to ParameterInfo.iPrecision
82648>>>                        Case Break
82649>>>                    Case Else
82649>>>                        Get ComParameterLength sReportId iParameter to ParameterInfo.iLength
82650>>>                        Case Break
82651>>>                Case End
82651>>>            End
82651>>>>
82651>>>        End
82651>>>>
82651>>>
82651>>>        Send RedirectErrorsToLocalHandler False
82652>>>
82652>>>        Function_Return ParameterInfo
82653>>>    End_Function
