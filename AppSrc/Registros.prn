80787>>>
80787>>>    Function ProcessModules Returns String[]
80789>>>        DWord dwProcessId
80789>>>        Handle hProcess
80789>>>        Handle[] hModules
80790>>>        Integer iSize iVoid iModules iModule iLength
80790>>>        Boolean bOk
80790>>>        String[] sModuleNames
80791>>>
80791>>>        Move (DR_WinAPI_GetCurrentProcessId ()) to dwProcessId
80792>>>        If (dwProcessId <> 0) Begin
80794>>>            Move (DR_WinAPI_OpenProcess (PROCESS_VM_READ + PROCESS_QUERY_INFORMATION, False, dwProcessId)) to hProcess
80795>>>            If (hProcess <> 0) Begin
80797>>>                Move 0 to iSize
80798>>>                Move (DR_WinAPI_EnumProcessModules (hProcess, AddressOf (hModules), 0, AddressOf (iSize))) to bOk
80799>>>                If (not (bOk)) Begin
80801>>>                    Get ShowLastError to iVoid
80802>>>                End
80802>>>>
80802>>>                Else Begin
80803>>>                    Move (iSize / SizeOfType (Handle)) to iModules
80804>>>                    Move (ResizeArray (hModules, iModules)) to hModules
80805>>>                    Move (DR_WinAPI_EnumProcessModules (hProcess, AddressOf (hModules), iSize, AddressOf (iSize))) to bOk
80806>>>                    If (not (bOk)) Begin
80808>>>                        Get ShowLastError to iVoid
80809>>>                    End
80809>>>>
80809>>>                    Else Begin
80810>>>                        Move (ResizeArray (sModuleNames, iModules, Repeat (Character (0), MAX_PATH))) to sModuleNames
80811>>>                        Decrement iModules
80812>>>                        For iModule from 0 to iModules
80818>>>>
80818>>>                            Move (GetModuleFileName (hModules[iModule], AddressOf (sModuleNames[iModule]), MAX_PATH)) to iLength
80819>>>                        Loop
80820>>>>
80820>>>                    End
80820>>>>
80820>>>                End
80820>>>>
80820>>>                Move (DR_WinAPI_CloseHandle (hProcess)) to bOk
80821>>>            End
80821>>>>
80821>>>        End
80821>>>>
80821>>>
80821>>>        Function_Return sModuleNames
80822>>>    End_Function
80823>>>
80823>>>    // Redirect to local error handler or Restore the global error handler
80823>>>    Procedure RedirectErrorsToLocalHandler Boolean bRedirect
80825>>>        Integer iLocalErrorRedirectCount
80825>>>        String sStackDump
80825>>>
80825>>>        Get piLocalErrorRedirectCount to iLocalErrorRedirectCount
80826>>>        If (bRedirect) Begin
80828>>>            If (iLocalErrorRedirectCount = 0) Begin
80830>>>                Set phOldErrorObject to Error_Object_Id
80831>>>                Move Self to Error_Object_Id
80832>>>            End
80832>>>>
80832>>>            Increment iLocalErrorRedirectCount
80833>>>            Set piLocalErrorRedirectCount to iLocalErrorRedirectCount
80834>>>        End
80834>>>>
80834>>>        Else Begin
80835>>>            If (iLocalErrorRedirectCount = 1) Begin
80837>>>                Get phOldErrorObject to Error_Object_Id
80838>>>                Set phOldErrorObject to 0
80839>>>            End
80839>>>>
80839>>>            Decrement iLocalErrorRedirectCount
80840>>>            If (iLocalErrorRedirectCount < 0) Begin
80842>>>                CallStackDump sStackDump
80843>>>                Send Stop_Box ("RedirectErrorsToLocalHandler\nThis should not happen!\n\nPlease report to Data Access Europe\n\n" + sStackDump) C_$DRDataFlexReports
80844>>>            End
80844>>>>
80844>>>            Set piLocalErrorRedirectCount to iLocalErrorRedirectCount
80845>>>        End
80845>>>>
80845>>>    End_Procedure
