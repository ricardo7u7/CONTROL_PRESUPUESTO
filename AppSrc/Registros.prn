83310>>>    // Quick function to test if the main report or any of the sub-reports uses ODBC as database type
83310>>>    Function ReportUsesODBC String sReportId Returns Boolean
83312>>>        Integer eDatabaseMainType iSubReports iSubReport
83312>>>        String sSubReportId
83312>>>        Boolean bODBCBasedReport
83312>>>
83312>>>        Get DatabaseMainType sReportId to eDatabaseMainType
83313>>>        If (eDatabaseMainType = C_DRODBC) Begin
83315>>>            Move True to bODBCBasedReport
83316>>>        End
83316>>>>
83316>>>        Else Begin
83317>>>            Get SubReportCount sReportId to iSubReports
83318>>>            Decrement iSubReports
83319>>>            For iSubReport from 0 to iSubReports
83325>>>>
83325>>>                Get SubReportId sReportId iSubReport to sSubReportId
83326>>>                Get ReportUsesODBC sSubReportId to bODBCBasedReport
83327>>>                If (bODBCBasedReport) ;                    Break
83330>>>            Loop
83331>>>>
83331>>>        End
83331>>>>
83331>>>
83331>>>        Function_Return bODBCBasedReport
