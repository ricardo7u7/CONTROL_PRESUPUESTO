87524>>>    Function GetClientArea Returns Handle
87527>>>        Handle hoClient
87527>>>        Move (oClientArea(oMain(ghoApplication))) to hoClient
87528>>>        Function_Return hoClient
87529>>>    End_Function
87530>>>
87530>>>    Object oEGRESOS_DD is a cEGRESOSDataDictionary
87532>>>        //Set DDO_Server to oTIPO_GASTO_DD
87532>>>        Set Constrain_file to PRESUPUESTO.File_number
87533>>>        Set DDO_Server to oPRESUPUESTO_DD
87534>>>        
87534>>>        Procedure Relate_Main_File
87537>>>            Forward Send Relate_Main_File
87539>>>            Clear TIPO_GASTO
87540>>>            Move Egresos.TIPO to TIPO_GASTO.CLAVE
87541>>>            Find eq TIPO_GASTO by Index.2
87542>>>>
87542>>>        End_Procedure
87543>>>        
87543>>>       Procedure OnConstrain
87546>>>            Forward Send OnConstrain
87548>>>            Set pbUseDDSQLFilters to True
87549>>>            Local String @Filtro @Filtro2 @Tipo_Gasto
87549>>>            Local Integer @Vista 
87549>>>            
87549>>>            Move '' to @Filtro2
87550>>>            
87550>>>            // Usa una referencia directa al oClientArea
87550>>>            Get psFiltro       to @Filtro
87551>>>            Get piOpcionVista  to @Vista
87552>>>            Get psOpcionPago   to @Tipo_Gasto
87553>>>            
87553>>>            If (@Filtro ne '') Begin
87555>>>                Append @Filtro2 @Filtro 
87556>>>            End
87556>>>>
87556>>>            
87556>>>            If (@Tipo_Gasto ne 'TODOS' and @Tipo_Gasto ne '') Begin
87558>>>                If (@Filtro ne '') Append @Filtro2 ' AND FORMA_PAGO = ' ("'"+@Tipo_Gasto+"'")
87562>>>                Else               Append @Filtro2 ' FORMA_PAGO = ' ("'"+@Tipo_Gasto+"'")
87565>>>            End
87565>>>>
87565>>>            
87565>>>            If (@Vista ne 3) Begin
87567>>>                If (@Filtro ne '') Append @Filtro2 " AND "
87570>>>                If (@Vista EQ 0) Append @Filtro2   " PAGADO_SN = 'N'"
87573>>>                If (@Vista EQ 1) Append @Filtro2   " PAGADO_SN = 'S'"
87576>>>                If (@Vista EQ 2) Append @Filtro2   " MONTO > MONTO_PROYECTADO"
87579>>>            End
87579>>>>
87579>>>            
87579>>>            Set psSQLFilter to @Filtro2
87580>>>        End_Procedure
87581>>>    End_Object
