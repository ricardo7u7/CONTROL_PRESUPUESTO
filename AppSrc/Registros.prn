85954>>>>>    //***
85954>>>>>    //*** BW
85954>>>>>    //*** Procedure: Show_Drivers
85954>>>>>    //*** Purpose  : Show loaded database drivers
85954>>>>>    //***
85954>>>>>
85954>>>>>    Procedure Show_Drivers
85956>>>>>        String sCurrentDriver sRevNumber
85956>>>>>        String sLoadedDrivers
85956>>>>>        Integer iNumberOfDrivers iCount
85956>>>>>        Boolean bOK
85956>>>>>
85956>>>>>        Move "" To sLoadedDrivers
85957>>>>>        Get_Attribute DF_NUMBER_DRIVERS To iNumberOfDrivers
85960>>>>>        For iCount From 1 To iNumberOfDrivers
85966>>>>>>
85966>>>>>            Get_Attribute DF_DRIVER_NAME Of iCount To sCurrentDriver
85969>>>>>            If (sLoadedDrivers <> "") Begin
85971>>>>>                Move (Append (sLoadedDrivers, ", ")) To sLoadedDrivers
85972>>>>>            End
85972>>>>>>
85972>>>>>            Get IsDataAccessCK sCurrentDriver to bOK
85973>>>>>            If (bOK) Begin
85975>>>>>                Get CKRevisionNumber sCurrentDriver to sRevNumber
85976>>>>>                Move (sCurrentDriver * "(" + sRevNumber + ")") to sCurrentDriver
85977>>>>>            End
85977>>>>>>
85977>>>>>            Move (Append (sLoadedDrivers, sCurrentDriver)) To sLoadedDrivers
85978>>>>>        Loop
85979>>>>>>
85979>>>>>        Send AppendTextLn (SFormat (C_$DatabaseDriver, sLoadedDrivers))
85980>>>>>    End_Procedure
