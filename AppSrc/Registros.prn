79922>>>>>    // Can be called to apply the current skin.
79922>>>>>    Procedure ApplySkin
79924>>>>>        Boolean bOk
79924>>>>>        String sSkin sIni
79924>>>>>        If (IsComObjectCreated(Self)) Begin
79926>>>>>            Get SkinQFile to sSkin
79927>>>>>            Get psSkinIni to sIni
79928>>>>>            
79928>>>>>            Send NotifyPreApplySkin
79929>>>>>            // when skins are used we don't want to use built in Visual Styles
79929>>>>>            Send EnableVisualStyles of Desktop (sSkin="")
79930>>>>>            Get ComLoadSkin sSkin sIni to bOK
79931>>>>>            If (sSkin<>"" and not(bOk)) Begin
79933>>>>>                // if not ok, no skin was appied. Enable visual styles
79933>>>>>                Send EnableVisualStyles of Desktop True
79934>>>>>            End
79934>>>>>>
79934>>>>>            Send NotifyPostApplySkin
79935>>>>>        End
79935>>>>>>
79935>>>>>    End_Procedure
