85881>>>>>    //****************************************************************************
85881>>>>>    // If workspaces are used, we will send the message EnumerateWorkspaceData
85881>>>>>    // To the workspace object passing the an object and message To send back
85881>>>>>    // To this object. It is expected that the workspace object will send this
85881>>>>>    // message for every line Of information it wants displayed (passing the
85881>>>>>    // information To be displayed
85881>>>>>    //****************************************************************************
85881>>>>>    Register_Procedure EnumerateWorkspaceData Integer hObjId Integer hmMessId
85881>>>>>
85881>>>>>    Procedure Show_ServicePack
85883>>>>>        String sKey sVersionDescription sVersion 
85883>>>>>        Handle hoRegistry
85883>>>>>        Boolean bExists bOpened
85883>>>>>        
85883>>>>>        Get Create (RefClass (cRegistry)) to hoRegistry
85884>>>>>        Set phRootKey of hoRegistry to HKEY_LOCAL_MACHINE
85885>>>>>        Set pfAccessRights of hoRegistry to KEY_READ
85886>>>>>
85886>>>>>        Move C_DFVersionRegistryRoot to sKey
85887>>>>>        Get KeyExists of hoRegistry sKey to bExists
85888>>>>>        If (bExists) Begin
85890>>>>>            Get OpenKey of hoRegistry sKey to bOpened
85891>>>>>            If (bOpened) Begin
85893>>>>>                Get ValueExists of hoRegistry "CurrentVersionDescription" to bExists
85894>>>>>                If (bExists) Begin
85896>>>>>                    Get ReadString of hoRegistry "CurrentVersionDescription" to sVersionDescription
85897>>>>>                End
85897>>>>>>
85897>>>>>                
85897>>>>>                Get ValueExists of hoRegistry "CurrentVersion" to bExists
85898>>>>>                If (bExists) Begin
85900>>>>>                    Get ReadString of hoRegistry "CurrentVersion" to sVersion
85901>>>>>                End                
85901>>>>>>
85901>>>>>                Send CloseKey of hoRegistry
85902>>>>>            End
85902>>>>>>
85902>>>>>        End
85902>>>>>>
85902>>>>>        Send Destroy of hoRegistry
85903>>>>>
85903>>>>>        If (sVersionDescription <> "") Begin
85905>>>>>           Send AppendTextLn (sVersionDescription * "-" * sVersion)
85906>>>>>           Send AppendTextLn ""
85907>>>>>        End
85907>>>>>>
85907>>>>>    End_Procedure
85908>>>>>    
85908>>>>>
85908>>>>>    Procedure Show_WorkspaceInformation
85910>>>>>        Integer hoWorkspace
85910>>>>>
85910>>>>>        If (ghoApplication <> 0) Begin
85912>>>>>            Get phoWorkspace of ghoApplication to hoWorkspace
85913>>>>>            If (hoWorkspace <> 0) Begin
85915>>>>>                Send EnumerateWorkspaceData of hoWorkspace Self (Refproc (AppendTextLn))
85916>>>>>                Send AppendTextLn ""
85917>>>>>            End
85917>>>>>>
85917>>>>>        End
85917>>>>>>
85917>>>>>    End_Procedure
85918>>>>>
85918>>>>>    Function VersionStr Integer iVer Integer iRev Integer iBld Returns String
85920>>>>>        Function_Return (String (iVer) - "." - String (iRev) - "." - String (iBld))
85921>>>>>    End_Function
