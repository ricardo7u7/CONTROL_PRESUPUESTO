79037>>>>>>>    // On WM_MOUSEWHEEL scroll the preview window contents or zoom in/out
79037>>>>>>>    Procedure OnMouseWheel Integer wParam Integer lParam
79039>>>>>>>        Integer iResult iDelta iFactor
79039>>>>>>>        
79039>>>>>>>        Get piPreviewZoom to iFactor
79040>>>>>>>
79040>>>>>>>        Move (Hi(wParam)) to iResult
79041>>>>>>>        Move (Cast(iResult,Short)) to iDelta
79042>>>>>>>
79042>>>>>>>        Case Begin
79042>>>>>>>            Case (Low(wParam) = MK_CONTROL)
79044>>>>>>>                // Zoom window
79044>>>>>>>                If (iDelta < 0) Begin
79046>>>>>>>                    Set piPreviewZoom to ((iFactor - 10) max 25)
79047>>>>>>>                End
79047>>>>>>>>
79047>>>>>>>                Else Begin
79048>>>>>>>                    If (iDelta > 0) Begin
79050>>>>>>>                        Set piPreviewZoom to ((iFactor + 10) min 500)
79051>>>>>>>                    End
79051>>>>>>>>
79051>>>>>>>                End
79051>>>>>>>>
79051>>>>>>>                Case Break
79052>>>>>>>            Case (Low(wParam) = MK_SHIFT)
79055>>>>>>>                Case Break // no action
79056>>>>>>>            Case Else
79056>>>>>>>                // Scroll window
79056>>>>>>>                If (iDelta < 0) Begin
79058>>>>>>>                    Send PreviewVScroll SB_ROWDOWN 0
79059>>>>>>>                End
79059>>>>>>>>
79059>>>>>>>                Else Begin
79060>>>>>>>                    If (iDelta > 0) Begin
79062>>>>>>>                        Send PreviewVScroll SB_ROWUP 0
79063>>>>>>>                    End
79063>>>>>>>>
79063>>>>>>>                End
79063>>>>>>>>
79063>>>>>>>                Case Break
79064>>>>>>>        Case End
79064>>>>>>>    End_Procedure
