87800>>>
87800>>>    Procedure Cargar_Eg_Fijos
87803>>>        Local String sQ sFechaInicio
87803>>>        Local Handle hdbc69 hstmt69
87803>>>        Local Date dToday
87803>>>        Local String sTipoQuincena
87803>>>        Local Integer iDiaInicio
87803>>>        
87803>>>        Sysdate dToday
87804>>>        Move PRESUPUESTO.FECHA_INICIO to sFechaInicio
87805>>>        
87805>>>        // Extraer el d¡a: saltar 3 caracteres (MM/) y leer 2 (dd)
87805>>>        Move (Integer(Mid(sFechaInicio, 2, 1))) to iDiaInicio
87806>>>        
87806>>>        // Determinar tipo de quincena del presupuesto actual
87806>>>        If (iDiaInicio <= 15) Begin
87808>>>            Move 'PQ' to sTipoQuincena  // Primera Quincena
87809>>>        End
87809>>>>
87809>>>        Else Begin
87810>>>            Move 'SQ' to sTipoQuincena  // Segunda Quincena
87811>>>        End
87811>>>>
87811>>>        
87811>>>        // Construir query para insertar gastos fijos
87811>>>        Move '' to sQ
87812>>>        Append sQ "INSERT INTO EGRESOS (NUMERO, TIPO, DESCRIPCION, FECHA_REALIZADO, ES_FIJO_SN, MONTO, MONTO_PROYECTADO, PRESUPUESTO, FORMA_PAGO) "
87813>>>        Append sQ "SELECT "
87814>>>        Append sQ "(SELECT COALESCE(MAX(NUMERO), 0) FROM EGRESOS WHERE PRESUPUESTO = " PRESUPUESTO.NUMERO ") + ROW_NUMBER() OVER (ORDER BY EF.TIPO), "
87817>>>        Append sQ "EF.TIPO, "
87818>>>        Append sQ "EF.DESCRIPCION, "
87819>>>        Append sQ (fSQL_date(dToday)) ", "
87821>>>        Append sQ "'S', "  // ES_FIJO_SN
87822>>>        Append sQ "0, "    // MONTO (inicial en 0)
87823>>>        Append sQ "EF.MONTO_PROYECTADO, "
87824>>>        Append sQ PRESUPUESTO.NUMERO ", "
87826>>>        Append sQ "EF.FORMA_PAGO "
87827>>>        Append sQ "FROM EGRESOS_FIJOS EF "
87828>>>        Append sQ "WHERE EF.QUINCENA = '2Q' "  // Siempre incluir los que aplican a ambas
87829>>>        Append sQ "OR EF.QUINCENA = '" sTipoQuincena "'"  // M s los espec¡ficos de esta quincena
87832>>>        
87832>>>        SQLFileConnect EGRESOS to hdbc69
87833>>>        SQLOpen hdbc69 to hstmt69
87836>>>        SQLExecDirect hstmt69 sQ
87839>>>        
87839>>>        Send Request_Find of oEGRESOS_DD ge Egresos.File_Number 1
87840>>>        
87840>>>        SQLClose hstmt69
87843>>>        SQLDisconnect hdbc69
87846>>>    End_Procedure
