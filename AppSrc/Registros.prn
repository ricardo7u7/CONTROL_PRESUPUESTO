83333>>>    // Quick function to test if the main report or any of the sub-reports uses RDS as database type
83333>>>    Function ReportUsesRDS String sReportId Returns Boolean
83335>>>        Integer eDatabaseMainType iSubReports iSubReport
83335>>>        String sSubReportId
83335>>>        Boolean bRDSBasedReport
83335>>>
83335>>>        Get DatabaseMainType sReportId to eDatabaseMainType
83336>>>        If (eDatabaseMainType = C_DRRDS) Begin
83338>>>            Move True to bRDSBasedReport
83339>>>        End
83339>>>>
83339>>>        Else Begin
83340>>>            Get SubReportCount sReportId to iSubReports
83341>>>            Decrement iSubReports
83342>>>            For iSubReport from 0 to iSubReports
83348>>>>
83348>>>                Get SubReportId sReportId iSubReport to sSubReportId
83349>>>                Get ReportUsesRDS sSubReportId to bRDSBasedReport
83350>>>                If (bRDSBasedReport) ;                    Break
83353>>>            Loop
83354>>>>
83354>>>        End
83354>>>>
83354>>>
83354>>>        Function_Return bRDSBasedReport
83355>>>    End_Function
