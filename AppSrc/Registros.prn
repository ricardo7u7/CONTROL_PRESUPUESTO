79893>>>>>    // Save the skin preference. This requires an application object.
79893>>>>>    // Only do this if the application object allows it. 
79893>>>>>    // This is called during startup if pbLoadPreference is True
79893>>>>>    // Suitable for override
79893>>>>>    Procedure SaveSkinPreference 
79895>>>>>        String sSkin sIni
79895>>>>>        If ghoApplication Begin
79897>>>>>            If (pbPreserveEnvironment(ghoApplication)) Begin
79899>>>>>                Get psSkinFile to sSkin
79900>>>>>                Get psSkinIni to sIni
79901>>>>>                Send WriteString of ghoApplication "Preferences" "SkinFile" sSkin
79902>>>>>                Send WriteString of ghoApplication "Preferences" "SkinIni" sIni
79903>>>>>            End
79903>>>>>>
79903>>>>>        End
79903>>>>>>
79903>>>>>        Else Begin
79904>>>>>            Error DFERR_PROGRAM C_$ApplicationObjectNotCreated
79905>>>>>>
79905>>>>>        End
79905>>>>>>
79905>>>>>    End_Procedure
79906>>>>>
79906>>>>>    // Load the skin preference. This requires an application object.
