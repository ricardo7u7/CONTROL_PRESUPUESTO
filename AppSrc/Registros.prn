89256>>>            
89256>>>            // SI ES A FAVOR LOS TOTALES SON CON DIFERENTE LOGICA 
89256>>>            If (DEUDA_H.A_FAVOR eq 'N') Send Totales
89259>>>            Else Send Totales2
89261>>>            
89261>>>            Set Shadow_State of oDEUDA_H_CLAVE        to True
89262>>>            Set Shadow_State of oDEUDA_H_MONTO        to True
89263>>>            Set Shadow_State of oDEUDA_H_TIPO         to True 
