78216>>>>>    // Initializes the DEVNAMES structure and returns handle
78216>>>>>    Function InitDevNames Returns Handle
78218>>>>>        String sDriverName sDeviceName sOutputName
78218>>>>>        Integer iResult iSize
78218>>>>>        Pointer pDevNames
78218>>>>>        Handle hDevNames
78218>>>>>        DEVNAMES dn
78218>>>>>        DEVNAMES dn
78218>>>>>
78218>>>>>        // Free peviously allocated memory
78218>>>>>        Get phDevNames to hDevNames
78219>>>>>        If (hDevNames) Begin
78221>>>>>            Move (GlobalFree (hDevNames)) to iResult
78222>>>>>            Set phDevNames to 0
78223>>>>>        End
78223>>>>>>
78223>>>>>
78223>>>>>        // Calculate size
78223>>>>>        Get psDriverName to sDriverName
78224>>>>>        Get psDeviceName to sDeviceName
78225>>>>>        Get psOutputName to sOutputName
78226>>>>>
78226>>>>>        Move (sDriverName + Character(0)) to sDriverName
78227>>>>>        Move (sDeviceName + Character(0)) to sDeviceName
78228>>>>>        Move (sOutputName + Character(0)) to sOutputName
78229>>>>>
78229>>>>>        Move (Length (sDriverName) + Length (sDeviceName) + Length (sOutputName)) to iSize
78230>>>>>
78230>>>>>        // Allocate memory for DEVNAMES structure
78230>>>>>        Move (GlobalAlloc (GMEM_MOVEABLE, SizeOfType (DEVNAMES) + iSize)) to hDevNames
78231>>>>>        If (hDevNames = 0) Begin
78233>>>>>            Function_Return 0
78234>>>>>        End
78234>>>>>>
78234>>>>>
78234>>>>>        // Lock allocated memory
78234>>>>>        Move (GlobalLock (hDevNames)) to pDevNames
78235>>>>>        If (pDevNames = 0) Begin
78237>>>>>            Move (GlobalFree (hDevNames)) to iResult
78238>>>>>            Function_Return 0
78239>>>>>        End
78239>>>>>>
78239>>>>>
78239>>>>>        // Copy the driver, device and output names in the extension of the struct
78239>>>>>        Move (SizeOfType (DEVNAMES)) to iSize
78240>>>>>        Move iSize to dn.wDriverOffset
78241>>>>>        Move (CopyMemory (pDevNames + iSize, AddressOf (sDriverName), Length (sDriverName))) to iResult
78242>>>>>
78242>>>>>        Move (iSize + Length (sDriverName)) to iSize
78243>>>>>        Move iSize to dn.wDeviceOffset
78244>>>>>        Move (CopyMemory (pDevNames + iSize, AddressOf (sDeviceName), Length (sDeviceName))) to iResult
78245>>>>>
78245>>>>>        Move (iSize + Length (sDeviceName)) to iSize
78246>>>>>        Move iSize to dn.wOutputOffset
78247>>>>>        Move (CopyMemory (pDevNames + iSize, AddressOf (sOutputName), Length (sOutputName))) to iResult
78248>>>>>
78248>>>>>        // Copy the DEVNAMES structure and unlock memory
78248>>>>>        Move (CopyMemory (pDevNames, AddressOf (dn), SizeOfType (DEVNAMES))) to iResult
78249>>>>>        Move (GlobalUnlock (hDevNames)) to iResult
78250>>>>>        
78250>>>>>        // Store the memory handle
78250>>>>>        Set phDevNames to hDevNames
78251>>>>>
78251>>>>>        Function_Return hDevNames
78252>>>>>    End_Function
