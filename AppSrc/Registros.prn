86725>>>>>    Function SQLGetArgument Integer iArgnum Returns String
86727>>>>>        Local Integer ihdbc
86727>>>>>        Local Integer ihstmt
86727>>>>>        Local String  sDrvrId
86727>>>>>        Local Integer iVoid
86727>>>>>        Local String  sEmpty
86727>>>>>        Local String  sArgument
86727>>>>>        Local Integer iLen
86727>>>>>
86727>>>>>        //*** Initialize
86727>>>>>        Move "" To sEmpty
86728>>>>>        Move "" To sArgument
86729>>>>>
86729>>>>>        //*** Get the cli handle to the connection
86729>>>>>        Get phCLIHandle       To ihstmt
86730>>>>>        Get psDriverId        To sDrvrId
86731>>>>>        Get phStmtConnection  To ihdbc
86732>>>>>
86732>>>>>        //*** Call the procedure
86732>>>>>        If (ihstmt <> 0 And ihdbc <> 0 And sDrvrId <> "") Begin
86734>>>>>            //*** Pass the information
86734>>>>>            Call_driver 0 sDrvrId Function FUNC_SQLCOLUMNINFO ;                        Callback Current_Object ;                        Passing ihdbc iArgnum ihstmt ;                        Result iVoid
86739>>>>>
86739>>>>>            //*** Get the length
86739>>>>>            Call_driver 0 sDrvrId Function FUNC_SQLGETPROCARGLEN ;                        Callback Current_Object ;                        Passing sEmpty sEmpty 0 ;                        Result iLen
86744>>>>>
86744>>>>>            If (iLen) Begin
86746>>>>>                //*** Allocate
86746>>>>>                Move (Repeat(' ', iLen)) To sArgument
86747>>>>>
86747>>>>>                //*** Pass the argument
86747>>>>>                Call_driver 0 sDrvrId Function FUNC_SQLGETPROCARG ;                            Callback Current_Object ;                            Passing sArgument sEmpty 0 ;                            Result iVoid
86752>>>>>            End
86752>>>>>>
86752>>>>>        End
86752>>>>>>
86752>>>>>        Else ;            Send HandleError ihstmt ihdbc sDrvrId "SQLGetArgument"
86754>>>>>
86754>>>>>        Function_Return sArgument
86755>>>>>    End_Function // SQLGetArgument
