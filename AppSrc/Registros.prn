81233>>>                Error DFERR_DATAFLEX_REPORTS C_$DRNoReportIdSpecified
81234>>>>
81234>>>                Send RedirectErrorsToLocalHandler False
81235>>>                Procedure_Return
81236>>>            End
81236>>>>
81236>>>
81236>>>            Get IsComObjectCreated to bComObjectCreated
81237>>>            If (bComObjectCreated) Begin
81239>>>                Get pePreviewStyle to ePreviewStyle
81240>>>                Case Begin
81240>>>                    Case (ePreviewStyle = C_DRPREVIEW_MODAL)
81242>>>                        Get phoPreviewContainer to hoPreviewContainer
81243>>>                        If (hoPreviewContainer <> 0) Begin
81245>>>                            Set phoReport of hoPreviewContainer to Self
81246>>>                            Get psPreviewCaptionLabel to sPreviewCaptionLabel
81247>>>                            If (sPreviewCaptionLabel = "") Begin
81249>>>                                Get psReportName to sPreviewCaptionLabel
81250>>>                            End
81250>>>>
81250>>>                            Set Label of hoPreviewContainer to sPreviewCaptionLabel
81251>>>                            Send Popup_Modal of hoPreviewContainer
81252>>>                        End
81252>>>>
81252>>>                        Case Break
81253>>>                    Case (ePreviewStyle = C_DRPREVIEW_VIEW)
81256>>>                    Case (ePreviewStyle = C_DRPREVIEW_TOOLPANEL)
81259>>>                    Case (ePreviewStyle = C_DRPREVIEW_DESKTOPVIEW)
81262>>>                        Get phoPreviewContainer to hoPreviewContainer
81263>>>                        If (hoPreviewContainer = 0) Begin
81265>>>                            Get Client_Id to hoClientArea
81266>>>                            If (hoClientArea <> 0) Begin
81268>>>                                Get phcPreviewer to hcPreviewer
81269>>>                                If (hcPreviewer <> 0) Begin
81271>>>                                    Get Create of hoClientArea hcPreviewer to hoPreviewContainer
81272>>>                                    Set phoReport of hoPreviewContainer to Self
81273>>>                                    Get psPreviewCaptionLabel to sPreviewCaptionLabel
81274>>>                                    If (sPreviewCaptionLabel = "") Begin
81276>>>                                        Get psReportName to sPreviewCaptionLabel
81277>>>                                    End
81277>>>>
81277>>>                                    Set Label of hoPreviewContainer to sPreviewCaptionLabel
81278>>>                                    Set phoPreviewContainer to hoPreviewContainer
81279>>>                                End
81279>>>>
81279>>>                            End
81279>>>>
81279>>>                        End
81279>>>>
81279>>>                        If (hoPreviewContainer <> 0) Begin
81281>>>                            Send DisplayStatusPanel True
81282>>>                            Get Active_State of hoPreviewContainer to bPreviewContainerIsActive
81283>>>                            If (not (bPreviewContainerIsActive)) Begin
81285>>>                                Send Activate_View of hoPreviewContainer
81286>>>                            End
81286>>>>
81286>>>                            Else Begin
81287>>>                                Send UpdateViewer of hoPreviewContainer
81288>>>                                Send Activate of hoPreviewContainer
81289>>>                            End
81289>>>>
81289>>>                            Send ComReportPreview sReportId
81290>>>                            Send DisplayStatusPanel False
81291>>>                        End
81291>>>>
81291>>>                        Case Break
81292>>>                    Case (ePreviewStyle = C_DRPREVIEW_EMBEDDED)
81295>>>                        Set phoPreviewContainer to 0
81296>>>                        Send DisplayStatusPanel True
81297>>>                        Send ComReportPreview sReportId
81298>>>                        Send DisplayStatusPanel False
81299>>>                        Case Break
81300>>>                Case End
81300>>>            End
81300>>>>
81300>>>            Else Begin
81301>>>                Error DFERR_DATAFLEX_REPORTS (Sformat (C_$DRReportOCXNotInitialised, Name (Self)))
81302>>>>
81302>>>            End
81302>>>>
81302>>>        End
81302>>>>
81302>>>        Send OnPostDisplayReport
81303>>>        Send CheckFunctionErrorInfo
81304>>>
81304>>>        Send RedirectErrorsToLocalHandler False
