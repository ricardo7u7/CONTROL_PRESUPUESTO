79833>>>>>    // returns an array of all skins in the path. If path is "", use the default path.
79833>>>>>    // If the default path is used, returns the file names as relative names, else use full path.
79833>>>>>    Function EnumerateSkins String sPath Boolean bRecursive Returns tSkinInformation[]
79835>>>>>        tSkinInformation[] Skins
79835>>>>>        tSkinInformation[] Skins
79836>>>>>        String sSkinName sSkinFile sDefaultPath sSep
79836>>>>>        Variant vSkinDescriptions vSkinDescription vSkinIniFile
79836>>>>>        Handle hSkinDescriptions hSkinDescription hSkinIniFile
79836>>>>>        Integer iSkinsCount iSkinFilesCount iNumSkins iNumSkinFiles iArrayItem
79836>>>>>        Integer iPos iDfltLen
79836>>>>>        Boolean bUseRelativePath
79836>>>>>        
79836>>>>>        Move (SysConf(SYSCONF_DIR_SEPARATOR)) to sSep
79837>>>>>        
79837>>>>>        Get SkinPath to sDefaultPath
79838>>>>>        If (sPath="") Begin
79840>>>>>            Move sDefaultPath to sPath
79841>>>>>        End
79841>>>>>>
79841>>>>>        Move (Uppercase(sDefaultPath)) to sDefaultPath
79842>>>>>        Move (Length(sDefaultPath)) to iDfltLen
79843>>>>>        Move (sDefaultPath=Uppercase(sPath)) to bUseRelativePath
79844>>>>>
79844>>>>>        Get ComEnumerateSkinDirectory sPath bRecursive to vSkinDescriptions
79845>>>>>        If (not(IsNullComObject(vSkinDescriptions))) Begin
79847>>>>>
79847>>>>>            Get Create U_cCJSkinDescriptions to hSkinDescriptions
79848>>>>>            Get Create U_cCJSkinDescription to hSkinDescription
79849>>>>>            Get Create U_cCJSkinIniFile to hSkinIniFile
79850>>>>>            
79850>>>>>            Set pvComObject of hSkinDescriptions to vSkinDescriptions
79851>>>>>            Get ComCount of hSkinDescriptions to iNumSkinFiles
79852>>>>>            
79852>>>>>            For iSkinFilesCount from 0 to (iNumSkinFiles-1)
79858>>>>>>
79858>>>>>                Get ComSkin of hSkinDescriptions iSkinFilesCount to vSkinDescription
79859>>>>>                Set pvComObject of hSkinDescription to vSkinDescription
79860>>>>>
79860>>>>>                Get ComCount of hSkinDescription to iNumSkins
79861>>>>>                    
79861>>>>>                For iSkinsCount from 0 to (iNumSkins-1)
79867>>>>>>
79867>>>>>                    Get ComIniFile of hSkinDescription iSkinsCount to vSkinIniFile
79868>>>>>                    Set pvComObject of hSkinIniFile to vSkinIniFile
79869>>>>>
79869>>>>>                    Get ComName of hSkinDescription to Skins[iArrayItem].sName
79870>>>>>                    Get ComPath of hSkinDescription to sSkinFile
79871>>>>>                    If bUseRelativePath Begin
79873>>>>>                        Move (pos(sDefaultPath,uppercase(sSkinFile))) to iPos
79874>>>>>                        If iPos Begin
79876>>>>>                            Move (Remove(sSkinFile,iPos,iDfltLen)) to sSkinFile   
79877>>>>>                            While (Left(sSkinFile,1)=sSep)
79881>>>>>                                Move (Remove(sSkinFile,1,1)) to sSkinFile   
79882>>>>>                            Loop                         
79883>>>>>>
79883>>>>>                        End
79883>>>>>>
79883>>>>>                    End
79883>>>>>>
79883>>>>>                    Move sSkinFile to Skins[iArrayItem].sSkinfile
79884>>>>>                    Get ComIniFileName of hSkinIniFile to Skins[iArrayItem].sSkinIni
79885>>>>>
79885>>>>>                    Increment iArrayItem
79886>>>>>                Loop
79887>>>>>>
79887>>>>>            Loop
79888>>>>>>
79888>>>>>                            
79888>>>>>            Send Destroy of hSkinDescriptions
79889>>>>>            Send Destroy of hSkinDescription
79890>>>>>            Send Destroy of hSkinIniFile
79891>>>>>                
79891>>>>>        End
79891>>>>>>
79891>>>>>        Function_Return Skins
79892>>>>>    End_Function 
