81365>>>
81365>>>            If (iExportType <> C_DRImage and iExportType <> C_DRPDF and iExportType <> C_DRCSV and iExportType <> C_DRHTML and iExportType <> C_DRXLS and iExportType <> C_DRRTF) Begin
81367>>>                Error DFERR_DATAFLEX_REPORTS (Sformat (C_$DRNoValidExportTypeSpecified, iExportType))
81368>>>>
