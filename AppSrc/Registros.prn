88439>>>        Object oGenerarMovimiento is a Button
88441>>>            Set Size to 23 30
88442>>>            Set Location to 61 418
88443>>>            Set Label to 'Print'
88444>>>            Set Bitmap to 'bajar.bmp'
88445>>>        
88445>>>            // fires when the button is clicked
88445>>>            Procedure OnClick
88448>>>                Local Integer iConfirm
88448>>>                Local Date dSysdate
88448>>>                Sysdate dSysdate
88449>>>                If (PRESUPUESTO.ESTATUS ne 'B') Begin
88451>>>                    Get Confirm 'Se generar  movimiento a partir de saldo anterior, desea continuar?' to iConfirm
88452>>>                    If (iConfirm eq 0) Begin
88454>>>                        
88454>>>                        If (PRESUPUESTO.SALDO_INICIAL gt 0) Begin
88456>>>                            Reread PRESUPUESTO
88460>>>                            Add PRESUPUESTO.SALDO_INICIAL to PRESUPUESTO.VLR_EFECTIVO
88461>>>                            SaveRecord PRESUPUESTO
88462>>>                            Unlock
88463>>>>
88463>>>                            Send Request_Save to oPRESUPUESTO_DD
88464>>>                        End
88464>>>>
88464>>>                        Else Begin
88465>>>                            // Obtenemos el numero ultimo 
88465>>>                            Local String sQ 
88465>>>                            Local Handle hdbc69 hstmt69
88465>>>                            Local Number nProx 
88465>>>                            
88465>>>                            Move '' to sQ
88466>>>                            Move 0  to nProx
88467>>>                            Append sQ " SELECT MAX(NUMERO) FROM EGRESOS WHERE PRESUPUESTO = " PRESUPUESTO.NUMERO 
88469>>>                            SQLFileConnect EGRESOS to hdbc69
88470>>>                            SQLOpen hdbc69 to hstmt69
88473>>>                            SQLExecDirect hstmt69 sQ
88476>>>                            Repeat
88476>>>>
88476>>>                               SQLFileFetch hstmt69
88482>>>                               If (SQLResult) Begin
88484>>>                                  Get SQLColumnValue of hstmt69   1 to nProx
88485>>>                               End
88485>>>>
88485>>>                            Until (not(SQLResult))
88487>>>                            SQLClose hstmt69
88490>>>                            SQLDisconnect hdbc69
88493>>>                            
88493>>>                            Clear EGRESOS
88494>>>                            Move (nProx+1)          to EGRESOS.NUMERO
88495>>>                            Move PRESUPUESTO.NUMERO to EGRESOS.PRESUPUESTO
88496>>>                            Move 0                  to EGRESOS.MONTO
88497>>>                            Move (PRESUPUESTO.SALDO_INICIAL*-1) to EGRESOS.MONTO_PROYECTADO
88498>>>                            Move 'N'                to EGRESOS.ES_FIJO_SN
88499>>>                            Move 'OT'               to EGRESOS.TIPO
88500>>>                            Move 'Gasto generado de saldo Inicial' to EGRESOS.DESCRIPCION
88501>>>                            Move  dSysdate          to EGRESOS.FECHA_REALIZADO
88502>>>                            Move 'N'                to EGRESOS.PAGADO_SN
88503>>>                            Move 'TD'               to EGRESOS.FORMA_PAGO
88504>>>                            Save EGRESOS
88506>>>                            Send Beginning_of_Data to oEgresos
88507>>>                        End
88507>>>>
88507>>>                    End
88507>>>>
88507>>>                    Else Procedure_Return
88509>>>                End
88509>>>>
88509>>>                Else Begin
88510>>>                    Send UserError 'Presupuesto cerrado, imposible continuar...' 'Atencion!'
88511>>>                    Procedure_Return
88512>>>                End
88512>>>>
88512>>>            End_Procedure
