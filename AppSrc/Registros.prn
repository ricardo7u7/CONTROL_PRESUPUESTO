85986>>>>>            If (eHelpType = htHtmlHelp and ghoHtmlHelp) Begin
85988>>>>>                Get GetHelpFile Of ghoHtmlHelp To sHelpFile
85989>>>>>            End
85989>>>>>>
85989>>>>>            Else If (eHelpType = htWinHelp and Help_object_id) Begin
85992>>>>>                Get Help_filename Of Help_object_id To sHelpFile
85993>>>>>            End
85993>>>>>>
85993>>>>>            Else Begin
85994>>>>>                Move C_$ThereIsNoHelpfileDefined To sHelpFile
85995>>>>>            End
85995>>>>>>
85995>>>>>
85995>>>>>            Send AppendTextLn ""
85996>>>>>            Send AppendTextLn (SFormat (C_$HelpFile, sHelpFile))
85997>>>>>        End
85997>>>>>>
85997>>>>>    End_Procedure
