89281>>>    
89281>>>    //FUNCIONES Y PROCEDIMIENTOS
89281>>>    Procedure Totales 
89284>>>        Local String sQ
89284>>>        Local Handle hdbc69 hstmt69
89284>>>        Local Number nMonto nMontoEsp nTotalDeuda 
89284>>>    
89284>>>        Move '' to sQ
89285>>>        Move 0  to nMonto
89286>>>        Move 0  to nMontoEsp
89287>>>        Append sQ " SELECT SUM(MONTO) FROM DEUDA_D WHERE PAGADO_SN = 'S' AND DEUDA_H =  " DEUDA_H.NUMERO 
89289>>>        SQLFileConnect EGRESOS to hdbc69
89290>>>        SQLOpen hdbc69 to hstmt69
89293>>>        SQLExecDirect hstmt69 sQ
89296>>>        Repeat
89296>>>>
89296>>>           SQLFileFetch hstmt69
89302>>>           If (SQLResult) Begin
89304>>>              Get SQLColumnValue of hstmt69   1 to nMonto
89305>>>           End
89305>>>>
89305>>>        Until (not(SQLResult))
89307>>>        SQLClose hstmt69
89310>>>        SQLDisconnect hdbc69
89313>>>        
89313>>>        Move '' to sQ
89314>>>        Append sQ " SELECT SUM(MONTO_PROYECTADO) FROM DEUDA_D WHERE DEUDA_H =  " DEUDA_H.NUMERO 
89316>>>        SQLFileConnect EGRESOS to hdbc69
89317>>>        SQLOpen hdbc69 to hstmt69
89320>>>        SQLExecDirect hstmt69 sQ
89323>>>        Repeat
89323>>>>
89323>>>           SQLFileFetch hstmt69
89329>>>           If (SQLResult) Begin
89331>>>              Get SQLColumnValue of hstmt69   1 to nMontoEsp
89332>>>           End
89332>>>>
89332>>>        Until (not(SQLResult))
89334>>>        SQLClose hstmt69
89337>>>        SQLDisconnect hdbc69
89340>>>        
89340>>>        Get Value of oDEUDA_H_MONTO to nTotalDeuda
89341>>>        
89341>>>        Move (DEUDA_H.MONTO -nMonto)    to nMonto
89342>>>        Move (DEUDA_H.MONTO -nMontoEsp) to nMontoEsp
89343>>>        
89343>>>        Set Value of oTOTAL         to nMonto
89344>>>        Set Value of oTOTAL_PROYECT to nMontoEsp
89345>>>        Set Value of oTextDIFERENCIA to '--'
89346>>>        
89346>>>    End_Procedure
89347>>>    
89347>>>    
89347>>>    //FUNCIONES Y PROCEDIMIENTOS
89347>>>    Procedure Totales2 
89350>>>        Local String sQ
89350>>>        Local Handle hdbc69 hstmt69
89350>>>        Local Number nMonto nMontoEsp nTotalDeuda nDiferencia
89350>>>    
89350>>>        Move '' to sQ
89351>>>        Move 0  to nMonto
89352>>>        Move 0  to nMontoEsp
89353>>>        Append sQ " SELECT SUM(MONTO) FROM DEUDA_D WHERE PAGADO_SN = 'S' AND DEUDA_H =  " DEUDA_H.NUMERO 
89355>>>        SQLFileConnect EGRESOS to hdbc69
89356>>>        SQLOpen hdbc69 to hstmt69
89359>>>        SQLExecDirect hstmt69 sQ
89362>>>        Repeat
89362>>>>
89362>>>           SQLFileFetch hstmt69
89368>>>           If (SQLResult) Begin
89370>>>              Get SQLColumnValue of hstmt69   1 to nMonto
89371>>>           End
89371>>>>
89371>>>        Until (not(SQLResult))
89373>>>        SQLClose hstmt69
89376>>>        SQLDisconnect hdbc69
89379>>>        
89379>>>        Move '' to sQ
89380>>>        Append sQ " SELECT SUM(MONTO_PROYECTADO) FROM DEUDA_D WHERE DEUDA_H =  " DEUDA_H.NUMERO 
89382>>>        SQLFileConnect EGRESOS to hdbc69
89383>>>        SQLOpen hdbc69 to hstmt69
89386>>>        SQLExecDirect hstmt69 sQ
89389>>>        Repeat
89389>>>>
89389>>>           SQLFileFetch hstmt69
89395>>>           If (SQLResult) Begin
89397>>>              Get SQLColumnValue of hstmt69   1 to nMontoEsp
89398>>>           End
89398>>>>
89398>>>        Until (not(SQLResult))
89400>>>        SQLClose hstmt69
89403>>>        SQLDisconnect hdbc69
89406>>>        
89406>>>        Set Value of oTOTAL         to nMonto
89407>>>        Set Value of oTOTAL_PROYECT to nMontoEsp
89408>>>        Move (nMontoEsp-nMonto) to nDiferencia
89409>>>        Set Value of oTextDIFERENCIA to ("Pendiente: "+String(nDiferencia))
89410>>>        
89410>>>        
89410>>>        Reread DEUDA_H
