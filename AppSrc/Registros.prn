85600>>>>>>>//*****************************************************************************
85600>>>>>>>//*** Class  : cDfbtrdrvHandler                                                  ***
85600>>>>>>>//*** Purpose: An instance of this class can be used as a broker object to  ***
85600>>>>>>>//***          call several Dfbtrdrv releated methods.                           ***
85600>>>>>>>//*****************************************************************************
85600>>>>>>>
85600>>>>>>>Class cDFBtrDrvHandler Is An Array
85601>>>>>>>
85601>>>>>>>    Procedure Construct_Object Integer iImage
85603>>>>>>>        Forward Send Construct_object iImage
85605>>>>>>>
85605>>>>>>>        Property String  psDriverID       Public "DFBTRDRV"
85606>>>>>>>    End_Procedure // Construct_Object
85607>>>>>>>
85607>>>>>>>
85607>>>>>>>
85607>>>>>>>    //***
85607>>>>>>>    //*** Function: CKRevsion
85607>>>>>>>    //*** Purpose : The revsion of a Dfbtrdrv Connectivity Kit
85607>>>>>>>    //***
85607>>>>>>>
85607>>>>>>>    Function CKRevision Returns String
85609>>>>>>>        Local String  sDriverID
85609>>>>>>>        Local String  sRevision
85609>>>>>>>        Local String  sVoid
85609>>>>>>>        Local Integer iRetval
85609>>>>>>>
85609>>>>>>>        // Ignore error 20491 DFBTRERR_INVALID_DRIVER_FUNCTION_CALL.
85609>>>>>>>        // This error would otherwise be raised when we have an older
85609>>>>>>>        // DFBTRDRV version that has no DFBTRFN_CKREVISION function
85609>>>>>>>        Send Ignore_error To Error_object_Id 20491
85610>>>>>>>        Get psDriverID To sDriverID
85611>>>>>>>        Move (Repeat(" ", 255)) To sRevision
85612>>>>>>>        Call_Driver 0 sDRiverID Function DFBTRFN_CKREVISION Callback 0 Passing sRevision sVoid 0 Result iRetval
85617>>>>>>>        Send Trap_Error To Error_object_Id 20491
85618>>>>>>>        If (Trim(sRevision) = "") Begin
85620>>>>>>>            // Unable to get the revision. return all zeroes.
85620>>>>>>>            Move "0.0.0.0" To sRevision
85621>>>>>>>        End
85621>>>>>>>>
85621>>>>>>>        Function_Return sRevision
85622>>>>>>>    End_Function // CKRevision
85623>>>>>>>
85623>>>>>>>    Function CkUsesUri Returns Integer
85625>>>>>>>        Local String  sDriverID
85625>>>>>>>        Local String  sVoid1
85625>>>>>>>        Local String  sVoid2
85625>>>>>>>        Local Integer iRetval
85625>>>>>>>
85625>>>>>>>        Get psDriverID To sDriverID
85626>>>>>>>
85626>>>>>>>        Move 0 To iRetval
85627>>>>>>>        // Ignore error 20491 DFBTRERR_INVALID_DRIVER_FUNCTION_CALL.
85627>>>>>>>        // This error would otherwise be raised when we have an older
85627>>>>>>>        // DFBTRDRV version that has no DFBTRFN_CKUSESURI function
85627>>>>>>>        Send Ignore_error To Error_object_Id 20491
85628>>>>>>>        Call_Driver 0 sDRiverID Function DFBTRFN_CKUSESURI Callback 0 Passing sVoid1 sVoid2 0 Result iRetval
85633>>>>>>>        Send Trap_Error To Error_object_Id 20491
85634>>>>>>>
85634>>>>>>>        Function_Return iRetval
85635>>>>>>>    End_Function // CKUsesUri
85636>>>>>>>
85636>>>>>>>
85636>>>>>>>
85636>>>>>>>    //***
85636>>>>>>>    //*** Function: ExtractPartFromRevsion
85636>>>>>>>    //*** Purpose : Extarct the Nth part of a a.b.c.d revsion string.
85636>>>>>>>    //***
85636>>>>>>>    //*** Returns : The part version number or -1 if there is no such part number.
85636>>>>>>>    //***
85636>>>>>>>
85636>>>>>>>    Function ExtractPartFromRevision Integer iPartNum String sRevision Returns Integer
85638>>>>>>>        Local Integer iPartRev
85638>>>>>>>        Local Integer iCurrentPart
85638>>>>>>>        Local Integer iSeparatorPos
85638>>>>>>>
85638>>>>>>>        If (iPartNum > 4) ;            Function_Return -1
85641>>>>>>>
85641>>>>>>>        Move 0 To iCurrentPart
85642>>>>>>>        Repeat
85642>>>>>>>>
85642>>>>>>>            Move (Pos(".", sRevision)) To iSeparatorPos
85643>>>>>>>            If (iSeparatorPos > 0) Begin
85645>>>>>>>                Move (Left(sRevision, iSeparatorPos - 1)) To iPartRev
85646>>>>>>>                Move (Right(sRevision, Length(sRevision) - iSeparatorPos)) To sRevision
85647>>>>>>>                Increment iCurrentPart
85648>>>>>>>            End
85648>>>>>>>>
85648>>>>>>>            Else If (sRevision <> "") Begin
85651>>>>>>>                Move sRevision To iPartRev
85652>>>>>>>                Move "" To sRevision
85653>>>>>>>                Increment iCurrentPart
85654>>>>>>>            End
85654>>>>>>>>
85654>>>>>>>            Else ;                Move -1 To iPartRev
85656>>>>>>>        Until (iCurrentPart >= iPartNum Or iPartRev = -1)
85658>>>>>>>
85658>>>>>>>        Function_Return iPartRev
85659>>>>>>>    End_Function // EcxtractPartFromRevision
85660>>>>>>>
85660>>>>>>>
85660>>>>>>>
85660>>>>>>>    //***
85660>>>>>>>    //*** Function: CKMajorRevision
85660>>>>>>>    //*** Purpose : Returns the major revision of the CK
85660>>>>>>>    //***
85660>>>>>>>
85660>>>>>>>    Function CKMajorRevision Returns Integer
85662>>>>>>>        Function_Return (ExtractPartFromRevision (Current_Object, 1, CKRevision(Current_Object)))
85663>>>>>>>    End_Function // CKMajorRevision
85664>>>>>>>
85664>>>>>>>
85664>>>>>>>
85664>>>>>>>    //***
85664>>>>>>>    //*** Function: CKMinorRevision
85664>>>>>>>    //*** Purpose : Returns the minor revision of the CK
85664>>>>>>>    //***
85664>>>>>>>
85664>>>>>>>    Function CKMinorRevision Returns Integer
85666>>>>>>>        Function_Return (ExtractPartFromRevision (Current_Object, 2, CKRevision(Current_Object)))
85667>>>>>>>    End_Function // CKMinorRevision
85668>>>>>>>
85668>>>>>>>
85668>>>>>>>
85668>>>>>>>    //***
85668>>>>>>>    //*** Function: CKReleaseRevision
85668>>>>>>>    //*** Purpose : Returns the release revision of the CK
85668>>>>>>>    //***
85668>>>>>>>
85668>>>>>>>    Function CKReleaseRevision Returns Integer
85670>>>>>>>        Function_Return (ExtractPartFromRevision (Current_Object, 3, CKRevision(Current_Object)))
85671>>>>>>>    End_Function // CKReleaseRevision
85672>>>>>>>
85672>>>>>>>
85672>>>>>>>
85672>>>>>>>    //***
85672>>>>>>>    //*** Function: CKBuildRevision
85672>>>>>>>    //*** Purpose : Returns the major revision of the CK
85672>>>>>>>    //***
85672>>>>>>>
85672>>>>>>>    Function CKBuildRevision Returns Integer
85674>>>>>>>        Function_Return (ExtractPartFromRevision (Current_Object, 4, CKRevision(Current_Object)))
85675>>>>>>>    End_Function // CKBuildRevision
85676>>>>>>>
85676>>>>>>>
85676>>>>>>>
85676>>>>>>>    //***
85676>>>>>>>    //*** Function: IsMinimalRevision
85676>>>>>>>    //*** Purpose : Determines if the CK conforms to a passed minimal revsion.
85676>>>>>>>    //***
85676>>>>>>>
85676>>>>>>>    Function IsMinimalRevision Integer iMajor Integer iMinor Integer iRelease Integer iBuild Returns Integer
85678>>>>>>>        If (iMajor < CKMajorRevision(Current_object)) ;            Function_return (TRUE)
85681>>>>>>>        Else If (iMajor = CKMajorRevision(Current_object)) Begin
85684>>>>>>>            If (iMinor < CKMinorRevision(Current_object)) ;                Function_return (TRUE)
85687>>>>>>>            Else If (iMinor = CKMinorRevision(Current_object)) Begin
85690>>>>>>>                If (iRelease < CKReleaseRevision(Current_object)) ;                    Function_return (TRUE)
85693>>>>>>>                Else If (iRelease = CKReleaseRevision(Current_object) And iBuild <= CKBuildRevision(Current_object)) ;                    Function_return (TRUE)
85697>>>>>>>            End
85697>>>>>>>>
85697>>>>>>>        End
85697>>>>>>>>
85697>>>>>>>
85697>>>>>>>        Function_Return (FALSE)
85698>>>>>>>    End_Function // IsMinimalRevision
85699>>>>>>>
85699>>>>>>>    //   Functions to query the Pervasive.SQL version:
85699>>>>>>>    //       PSQLRequesterVersionInfo    Integer iFileNum Returns String
85699>>>>>>>    //       PSQLLocalEngineVersionInfo  Integer iFileNum Returns String
85699>>>>>>>    //       PSQLServerEngineVersionInfo Integer iFileNum Returns String
85699>>>>>>>    //
85699>>>>>>>    //   All 3 functions return the version of a Pervasive.SQL component
85699>>>>>>>    //   in the following format:
85699>>>>>>>    //       <version>.<revision>.<type>
85699>>>>>>>    //   possible values for <type>:
85699>>>>>>>    //       9 for 32-bit Windows workstation/workgroup engine or Linux
85699>>>>>>>    //         server using Workgroup authentication mode
85699>>>>>>>    //       C for client cache engine
85699>>>>>>>    //       D for DOS workstation
85699>>>>>>>    //       N for client Requester
85699>>>>>>>    //       S for NetWare server
85699>>>>>>>    //       T for 32-bit Windows server engine
85699>>>>>>>    //       U for Linux server using PAM or BTPASSWD authentication
85699>>>>>>>    //
85699>>>>>>>    //   example:
85699>>>>>>>    //       8.50.T
85699>>>>>>>    //   will be returned for a Pervasive.SQL 8.5 Server Engine running on
85699>>>>>>>    //   32-bits Windows server.
85699>>>>>>>    //
85699>>>>>>>    //   The FileNumber parameter must specify an opened table or 0.
85699>>>>>>>    //   For PSQLServerEngineVersionInfo the FileNumber can not be 0.
85699>>>>>>>    //
85699>>>>>>>    //   If the version information is not available or can not be obtained
85699>>>>>>>    //   the functions will return "0.0.0"
85699>>>>>>>
85699>>>>>>>
85699>>>>>>>    //***
85699>>>>>>>    //*** Function: PSQLRequesterVersionInfo
85699>>>>>>>    //*** Purpose : Returns the version information of the
85699>>>>>>>    //***           Pervasive.SQL Client requester.
85699>>>>>>>
85699>>>>>>>    Function PSQLRequesterVersionInfo Integer iFileNum Returns String
85701>>>>>>>
85701>>>>>>>        Local String  sDriverID
85701>>>>>>>        Local String  sVersion
85701>>>>>>>        Local String  sVoid
85701>>>>>>>        Local Integer iRetval
85701>>>>>>>
85701>>>>>>>        // Ignore error 20491 DFBTRERR_INVALID_DRIVER_FUNCTION_CALL.
85701>>>>>>>        // This error would otherwise be raised when we have an older
85701>>>>>>>        // DFBTRDRV version that has no DFBTRFN_CKREVISION function
85701>>>>>>>        Send Ignore_error To Error_object_Id 20491
85702>>>>>>>        Get psDriverID To sDriverID
85703>>>>>>>        Move (Repeat(" ", 255)) To sVersion
85704>>>>>>>        Call_Driver iFileNum sDRiverID Function DFBTRFN_PSQLREQUESTERVERSIONINFO Callback 0 Passing sVersion sVoid 0 Result iRetval
85709>>>>>>>        Send Trap_Error To Error_object_Id 20491
85710>>>>>>>        If (Trim(sVersion) = "") Begin
85712>>>>>>>            // Unable to get the revision. return all zeroes.
85712>>>>>>>            Move "0.0.0" To sVersion
85713>>>>>>>        End
85713>>>>>>>>
85713>>>>>>>        Function_Return sVersion
85714>>>>>>>    End_Function //  PSQLRequesterVersion
85715>>>>>>>
85715>>>>>>>    //***
85715>>>>>>>    //*** Function: PSQLLocalEngineVersionInfo
85715>>>>>>>    //*** Purpose : Returns the version information of the
85715>>>>>>>    //***           Pervasive.SQL Local Engine
85715>>>>>>>
85715>>>>>>>    Function PSQLLocalEngineVersionInfo Integer iFileNum Returns String
85717>>>>>>>
85717>>>>>>>        Local String  sDriverID
85717>>>>>>>        Local String  sVersion
85717>>>>>>>        Local String  sVoid
85717>>>>>>>        Local Integer iRetval
85717>>>>>>>
85717>>>>>>>        // Ignore error 20491 DFBTRERR_INVALID_DRIVER_FUNCTION_CALL.
85717>>>>>>>        // This error would otherwise be raised when we have an older
85717>>>>>>>        // DFBTRDRV version that has no DFBTRFN_CKREVISION function
85717>>>>>>>        Send Ignore_error To Error_object_Id 20491
85718>>>>>>>        Get psDriverID To sDriverID
85719>>>>>>>        Move (Repeat(" ", 255)) To sVersion
85720>>>>>>>        Call_Driver iFileNum sDRiverID Function DFBTRFN_PSQLLOCALENGINEVERSIONINFO Callback 0 Passing sVersion sVoid 0 Result iRetval
85725>>>>>>>        Send Trap_Error To Error_object_Id 20491
85726>>>>>>>        If (Trim(sVersion) = "") Begin
85728>>>>>>>            // Unable to get the revision. return all zeroes.
85728>>>>>>>            Move "0.0.0" To sVersion
85729>>>>>>>        End
85729>>>>>>>>
85729>>>>>>>        Function_Return sVersion
85730>>>>>>>    End_Function //  PSQLLocalEngineVersion
85731>>>>>>>
85731>>>>>>>    //***
85731>>>>>>>    //*** Function: PSQLServerEngineVersionInfo
85731>>>>>>>    //*** Purpose : Returns the version information of the
85731>>>>>>>    //***           Pervasive.SQL Server Engine
85731>>>>>>>
85731>>>>>>>    Function PSQLServerEngineVersionInfo Integer iFileNum Returns String
85733>>>>>>>
85733>>>>>>>        Local String  sDriverID
85733>>>>>>>        Local String  sVersion
85733>>>>>>>        Local String  sVoid
85733>>>>>>>        Local Integer iRetval
85733>>>>>>>
85733>>>>>>>        // Ignore error 20491 DFBTRERR_INVALID_DRIVER_FUNCTION_CALL.
85733>>>>>>>        // This error would otherwise be raised when we have an older
85733>>>>>>>        // DFBTRDRV version that has no DFBTRFN_CKREVISION function
85733>>>>>>>        Send Ignore_error To Error_object_Id 20491
85734>>>>>>>        Get psDriverID To sDriverID
85735>>>>>>>        Move (Repeat(" ", 255)) To sVersion
85736>>>>>>>        Call_Driver iFileNum sDRiverID Function DFBTRFN_PSQLSERVERENGINEVERSIONINFO Callback 0 Passing sVersion sVoid 0 Result iRetval
85741>>>>>>>        Send Trap_Error To Error_object_Id 20491
85742>>>>>>>        If (Trim(sVersion) = "") Begin
85744>>>>>>>            // Unable to get the revision. return all zeroes.
85744>>>>>>>            Move "0.0.0" To sVersion
85745>>>>>>>        End
85745>>>>>>>>
85745>>>>>>>        Function_Return sVersion
85746>>>>>>>    End_Function //  PSQLServerEngineVersion
85747>>>>>>>
85747>>>>>>>End_Class // cDfbtrdrvHandler
