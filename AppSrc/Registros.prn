87502>>>        Procedure Relate_Main_File
87505>>>            Forward Send Relate_Main_File
87507>>>            Set Shadow_State of oPRESUPUESTO_CLAVE          to True
87508>>>            Set Shadow_State of oPRESUPUESTO_FECHA_INICIO   to True
87509>>>            Set Shadow_State of oPRESUPUESTO_FECHA_FIN      to True
87510>>>            Set Shadow_State of oPRESUPUESTO_VLR_QUINCENA   to True 
87511>>>            Set Shadow_State of oPRESUPUESTO_VLR_EFECTIVO   to True 
87512>>>            
87512>>>            If (PRESUPUESTO.ESTATUS eq 'B') Begin
87514>>>                Set Bitmap of  oEstatus to 'lock-close.bmp'
87515>>>                Set Read_Only_State of oEgresos to True
87516>>>                Set Read_Only_State of oSubEgresos to True
87517>>>            End
87517>>>>
87517>>>            Else Begin
87518>>>                Set Bitmap of  oEstatus to 'lock-open.bmp'
87519>>>                Set Read_Only_State of oEgresos to False
87520>>>                Set Read_Only_State of oSubEgresos to False
87521>>>            End
87521>>>>
87521>>>            Send Totales
87522>>>        End_Procedure
87523>>>    End_Object
