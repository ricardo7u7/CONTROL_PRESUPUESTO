79908>>>>>        String sSkin sIni
79908>>>>>        Boolean bExists
79908>>>>>        If ghoApplication Begin
79910>>>>>            If (pbPreserveEnvironment(ghoApplication)) Begin
79912>>>>>                Get ValueExists of ghoApplication "Preferences" "SkinFile" to bExists
79913>>>>>                If bExists Begin
79915>>>>>                    Get ReadString of ghoApplication "Preferences" "SkinFile" "" to sSkin
79916>>>>>                    Get ReadString of ghoApplication "Preferences" "SkinIni" "" to sIni
79917>>>>>                    Set psSkinFile to sSkin
79918>>>>>                    Set psSkinIni to sIni
79919>>>>>                End
79919>>>>>>
79919>>>>>            End
79919>>>>>>
79919>>>>>        End
79919>>>>>>
79919>>>>>        Else Begin
79920>>>>>            Error DFERR_PROGRAM C_$ApplicationObjectNotCreated
79921>>>>>>
79921>>>>>        End
79921>>>>>>
79921>>>>>    End_Procedure
