85922>>>>>    Procedure Show_Versions
85924>>>>>        Integer iVersion iRevision iBuild
85924>>>>>
85924>>>>>        Version_Information iVersion iRevision iBuild
85926>>>>>
85926>>>>>        Send AppendTextLn (SFormat (C_$RuntimeVersion, VersionStr(Self,iVersion,iRevision,iBuild) ))
85927>>>>>        Send AppendTextLn (SFormat (C_$PackageVersion, VersionStr(Self,PKG_VERSION, PKG_REVISION, PKG_BUILD) ))
85928>>>>>        Send AppendTextLn (SFormat (C_$FMACVersion, VersionStr(Self,FMAC_VERSION, FMAC_REVISION, FMAC_BUILD) ))
85929>>>>>    End_Procedure
85930>>>>>    
85930>>>>>    Function CKRevisionNumber String sDriverID Returns String
85932>>>>>        Handle hoCLIHandler
85932>>>>>        Handle hoDFBtrDrvHandler
85932>>>>>        String sCKRevision
85932>>>>>
85932>>>>>
85932>>>>>        If (sDriverID = "MSSQLDRV" or sDriverID = "ODBC_DRV" or sDriverID = "DB2_DRV") Begin
85934>>>>>            Get Create (RefClass(cCLIHandler)) to hoCLIHandler
85935>>>>>            Set psDriverID of hoCLIHandler to sDriverID
85936>>>>>            Move (CKRevision(hoCLIHandler)) to sCKRevision
85937>>>>>            Send Destroy of hoCLIHandler
85938>>>>>        End
85938>>>>>>
85938>>>>>        Else Begin
85939>>>>>            If (sDriverID = "DFBTRDRV") Begin
85941>>>>>                Get Create (RefClass(cDFBtrDrvHandler)) to hoDFBtrDrvHandler
85942>>>>>                Set psDriverID of hoDFBtrDrvHandler to sDriverID
85943>>>>>                Move (CKRevision(hoDFBtrDrvHandler)) to sCKRevision
85944>>>>>                Send Destroy of hoDFBtrDrvHandler
85945>>>>>            End
85945>>>>>>
85945>>>>>        End
85945>>>>>>
85945>>>>>        
85945>>>>>        Function_Return sCKRevision
85946>>>>>    End_Function
85947>>>>>    
85947>>>>>    
85947>>>>>    Function IsDataAccessCK String sDriverID Returns Boolean
85949>>>>>        
85949>>>>>        If (sDriverID = "DATAFLEX") Begin
85951>>>>>            Function_Return False
85952>>>>>        End
85952>>>>>>
85952>>>>>    
85952>>>>>        Function_Return (sDriverID = "MSSQLDRV" or sDriverID = "ODBC_DRV" or sDriverID = "DB2_DRV" or sDriverID = "DFBTRDRV")
85953>>>>>    End_Function    
