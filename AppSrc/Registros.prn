78579>>>>>>>                Set pvComObject of hoAction to vAction
78580>>>>>>>                // Contains the object ID of the control
78580>>>>>>>                Get ComTag of hoAction to hoActionPointer
78581>>>>>>>            End
78581>>>>>>>>
78581>>>>>>>            
78581>>>>>>>            Send Destroy of hoAction
78582>>>>>>>            Send Destroy of hoControl
78583>>>>>>>            
78583>>>>>>>            If (hoActionPointer <> 0) Begin
78585>>>>>>>                Send BuddyButtonClicked of hoActionPointer vControl
78586>>>>>>>            End
