76969>>>        Procedure CheckFileExtension String sExtension
76972>>>            String sFileName sFileExtension
76972>>>
76972>>>            Get Value to sFileName
76973>>>            Get DRPathFindExtension sFileName to sFileExtension
76974>>>            Move (Lowercase (sFileExtension)) to sFileExtension
76975>>>            If (sFileExtension <> sExtension) Begin
76977>>>                Move (sFileName - sExtension) to sFileName
76978>>>                Set Value to sFileName
76979>>>            End
76979>>>>
76979>>>        End_Procedure
