83403>>>    // Assigns a default class identifier to the phcPreviewer property if not set by the developer
83403>>>    Procedure SetDefaultPreviewerClass
83405>>>        Integer ePreviewStyle
83405>>>        Handle hcPreviewer
83405>>>
83405>>>        Get phcPreviewer to hcPreviewer
83406>>>        If (hcPreviewer = 0) Begin
83408>>>            Get pePreviewStyle to ePreviewStyle
83409>>>            Case Begin
83409>>>                Case (ePreviewStyle = C_DRPREVIEW_VIEW)
83411>>>                    Set phcPreviewer to (RefClass (cDRPreview))
83412>>>                    Case Break
83413>>>                Case (ePreviewStyle = C_DRPREVIEW_TOOLPANEL)
83416>>>                    Set phcPreviewer to (RefClass (cDRToolPanelPreview))
83417>>>                    Case Break
83418>>>                Case (ePreviewStyle = C_DRPREVIEW_DESKTOPVIEW)
83421>>>                    Set phcPreviewer to (RefClass (cDRDesktopPreview))
83422>>>                    Case Break
83423>>>            Case End
83423>>>        End
83423>>>>
83423>>>    End_Procedure
