83296>>>        Handle hoWorkspace
83296>>>        String sHomeFolder sReportsFolder
83296>>>        Boolean bIsDirectory
83296>>>
83296>>>        If (ghoApplication <> 0) Begin
83298>>>            Get phoWorkspace of ghoApplication to hoWorkspace
83299>>>            Get psHome of hoWorkspace to sHomeFolder
83300>>>            If (Right (sHomeFolder, 1) <> SysConf (SYSCONF_DIR_SEPARATOR)) Begin
83302>>>                Move (sHomeFolder - SysConf (SYSCONF_DIR_SEPARATOR)) to sHomeFolder
83303>>>            End
83303>>>>
83303>>>
83303>>>            Move (sHomeFolder - "Reports\") to sReportsFolder
83304>>>            Get IsDirectory sReportsFolder to bIsDirectory
83305>>>            If (bIsDirectory) Begin
83307>>>                Function_Return sReportsFolder
83308>>>            End
83308>>>>
83308>>>        End
83308>>>>
83308>>>
83308>>>        Function_Return ''
83309>>>    End_Function
