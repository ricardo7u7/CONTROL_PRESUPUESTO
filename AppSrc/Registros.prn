85491>>>>>>>    //***
85491>>>>>>>    //*** Function: CLIDFDateToSQLDate
85491>>>>>>>    //*** Purpose : Convert a DataFlex date to a SQL date using the dummy zero date value.
85491>>>>>>>    //***
85491>>>>>>>
85491>>>>>>>    Function CLIDFDateToSQLDate String sDRiver Date dDFDate Returns String
85493>>>>>>>        Local String sSQLDate
85493>>>>>>>        Local Integer iOrgDateFmt
85493>>>>>>>        Local Integer iOrgDateSep
85493>>>>>>>
85493>>>>>>>        //*** Change date format to military, SQL dates are military dates
85493>>>>>>>        Get_Attribute DF_DATE_FORMAT To iOrgDateFmt
85496>>>>>>>        Get_Attribute DF_DATE_SEPARATOR To iOrgDateSep
85499>>>>>>>        Set_Attribute DF_DATE_FORMAT To DF_DATE_MILITARY
85502>>>>>>>        Set_Attribute DF_DATE_SEPARATOR To (Ascii('-'))
85505>>>>>>>
85505>>>>>>>        //*** We only need to convert if the date is 0
85505>>>>>>>        If (Integer(dDFDate = 0)) ;            CLI_Get_Driver_Attribute sDRiver DRVR_DUMMY_ZERO_DATE_VALUE To sSQLDate
85514>>>>>>>        Else ;            Move dDFDate To sSQLDate
85516>>>>>>>
85516>>>>>>>        //*** Change date format back to original
85516>>>>>>>        Set_Attribute DF_DATE_FORMAT To iOrgDateFmt
85519>>>>>>>        Set_Attribute DF_DATE_SEPARATOR To iOrgDateSep
85522>>>>>>>
85522>>>>>>>        Function_Return sSQLDate
85523>>>>>>>    End_Function // CLIDFDateToSQLDate
85524>>>>>>>
85524>>>>>>>
85524>>>>>>>
85524>>>>>>>    //***
85524>>>>>>>    //*** Function: CLISQLDateToDFDate
85524>>>>>>>    //*** Purpose : Convert a SQL date to a DataFlex date using the dummy zero date value.
85524>>>>>>>    //***
85524>>>>>>>
85524>>>>>>>    Function CLISQLDateToDFDate String sDRiver String sSQLDate Returns Date
85526>>>>>>>        Local Date dDFDate
85526>>>>>>>        Local String sDummyDateValue
85526>>>>>>>        Local Integer iOrgDateFmt
85526>>>>>>>        Local Integer iOrgDateSep
85526>>>>>>>
85526>>>>>>>        //*** Change date format to military, SQL dates are military dates
85526>>>>>>>        Get_Attribute DF_DATE_FORMAT To iOrgDateFmt
85529>>>>>>>        Get_Attribute DF_DATE_SEPARATOR To iOrgDateSep
85532>>>>>>>        Set_Attribute DF_DATE_FORMAT To DF_DATE_MILITARY
85535>>>>>>>        Set_Attribute DF_DATE_SEPARATOR To (Ascii('-'))
85538>>>>>>>
85538>>>>>>>        //*** We only need to convert if the date is the dummy zero date value
85538>>>>>>>        CLI_Get_Driver_Attribute sDRiver DRVR_DUMMY_ZERO_DATE_VALUE To sDummyDateValue
85545>>>>>>>        If (sDummyDateValue = sSQLDate) ;            Move 0 To dDFDate
85548>>>>>>>        Else ;            Move sSQLDate To dDFDate
85550>>>>>>>
85550>>>>>>>        //*** Change date format back to original
85550>>>>>>>        Set_Attribute DF_DATE_FORMAT To iOrgDateFmt
85553>>>>>>>        Set_Attribute DF_DATE_SEPARATOR To iOrgDateSep
85556>>>>>>>
85556>>>>>>>        Function_Return dDFDate
85557>>>>>>>    End_Function // CLISQLDateToDFDate
