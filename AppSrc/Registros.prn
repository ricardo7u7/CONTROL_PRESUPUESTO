83744>>>    // Loops through all tables of a report and if any of its table names matches
83744>>>    // with the passed table name (case insensitive) it will return its offset/number
83744>>>    Function TableNumber String sReportId String sTableName Returns Integer
83746>>>        Integer iTables iTable
83746>>>        String  sReportTableName
83746>>>        Boolean bComObjectCreated
83746>>>
83746>>>        Send RedirectErrorsToLocalHandler True
83747>>>
83747>>>        If (sReportId = C_USEMAINDRREPORTID) Begin
83749>>>            Get psReportId to sReportId
83750>>>        End
83750>>>>
83750>>>
83750>>>        If (sReportId <> "") Begin
83752>>>            Get IsComObjectCreated to bComObjectCreated
83753>>>            If (bComObjectCreated) Begin
83755>>>                Get ComTableCount sReportId to iTables
83756>>>                If (iTables > 0) Begin
83758>>>                    Decrement iTables
83759>>>                    Move (Uppercase (sTableName)) to sTableName
83760>>>                    For iTable from 0 to iTables
83766>>>>
83766>>>                        Get ComTableNameAlias sReportId iTable to sReportTableName
83767>>>                        If (Uppercase (sReportTableName) = sTableName) Begin
83769>>>                            Send RedirectErrorsToLocalHandler False
83770>>>                            Function_Return iTable
83771>>>                        End
83771>>>>
83771>>>                    Loop
83772>>>>
83772>>>                End
83772>>>>
83772>>>            End
83772>>>>
83772>>>            Else Begin
83773>>>                Error DFERR_DATAFLEX_REPORTS (Sformat (C_$DRReportOCXNotInitialised, Name (Self)))
83774>>>>
83774>>>            End
83774>>>>
83774>>>        End
83774>>>>
83774>>>        Else Begin
83775>>>            Error DFERR_DATAFLEX_REPORTS C_$DRNoReportIdSpecified
83776>>>>
83776>>>        End
83776>>>>
83776>>>
83776>>>        Send RedirectErrorsToLocalHandler False
83777>>>
83777>>>        Function_Return -1
83778>>>    End_Function
83779>>>
83779>>>    // Developers can override this function to return a different name, especially
83779>>>    // in case of P.SQL this make sense
83779>>>    Function DataFlexTableName Handle hTable Returns String
83781>>>        String sDriver sTableName
83781>>>
83781>>>        Get_Attribute DF_FILE_DRIVER of hTable to sDriver
83784>>>        Case Begin
83784>>>            Case (sDriver = "DATAFLEX")
83786>>>                // DataFlex Reports works with the tablename on disk
83786>>>                Get_Attribute DF_FILE_ROOT_NAME of hTable to sTableName
83789>>>                Case Break
83790>>>            Case (sDriver = "MSSQLDRV")
83793>>>            Case (sDriver = "DB2_DRV")
83796>>>            Case (sDriver = "ODBC_DRV")
83799>>>                // Returns the name of the table specified in the INT file
83799>>>                Get_Attribute DF_FILE_TABLE_NAME of hTable to sTableName
83802>>>                Case Break
83803>>>            Case (sDriver = "DFBTRDRV")
83806>>>                // rootname most likely contains DFBTRDRV or .INT
83806>>>                Get_Attribute DF_FILE_LOGICAL_NAME of hTable to sTableName
83809>>>                Case Break
83810>>>        Case End
83810>>>
83810>>>        Function_Return sTableName
83811>>>    End_Function
