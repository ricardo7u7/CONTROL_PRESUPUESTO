82339>>>    Function OCXVersion Returns String
82341>>>        Handle hoVersionInfo
82341>>>        String sModuleName sVersionInfo
82341>>>        String[] sModuleNames
82342>>>        Integer iVoid iModule iModules iLength
82342>>>        Integer iVersionMajor iVersionMinor iVersionRelease iVersionBuild
82342>>>        Boolean bOk
82342>>>
82342>>>        Get ProcessModules to sModuleNames
82343>>>        Move (SizeOfArray (sModuleNames)) to iModules
82344>>>        Decrement iModules
82345>>>        For iModule from 0 to iModules
82351>>>>
82351>>>            Move (Repeat (Character (0), MAX_PATH)) to sModuleName
82352>>>            Move (DR_WinAPI_GetLongPathName (AddressOf (sModuleNames[iModule]), AddressOf (sModuleName), MAX_PATH)) to iLength
82353>>>            If (sModuleName contains C_DR_OCX_NAME) Begin
82355>>>                Get Create (RefClass (cVersionInfo)) to hoVersionInfo
82356>>>                Send DoCreate of hoVersionInfo sModuleName
82357>>>                Get pbIncluded of hoVersionInfo to bOk
82358>>>                If (bOk) Begin
82360>>>                    Get piVersionMajor of hoVersionInfo to iVersionMajor
82361>>>                    Get piVersionMinor of hoVersionInfo to iVersionMinor
82362>>>                    Get piVersionRelease of hoVersionInfo to iVersionRelease
82363>>>                    Get piVersionBuild of hoVersionInfo to iVersionBuild
82364>>>                    Move (SFormat ("%1.%2.%3.%4", iVersionMajor, iVersionMinor, iVersionRelease, iVersionBuild)) to sVersionInfo
82365>>>                End
82365>>>>
82365>>>                Send Destroy of hoVersionInfo
82366>>>                Function_Return sVersionInfo
82367>>>            End
82367>>>>
82367>>>        Loop
82368>>>>
82368>>>
82368>>>        Function_Return ""
82369>>>    End_Function
82370>>>
82370>>>    // Opens a report
82370>>>    Function OpenReport Returns String
82372>>>        Boolean bOk bCreated bExists bCanceled bAutoLocateDFFiles
82372>>>        String sReportId sReport sReportPath sDataPath sSep
82372>>>        Handle hoWorkspace
82372>>>        Handle hoFocus
82372>>>        Integer iPaths iPath
82372>>>
82372>>>        Send RedirectErrorsToLocalHandler True
82373>>>
82373>>>        Set pbCanceled to False // default
82374>>>
82374>>>        // Create com object if not done yet
82374>>>        Get IsComObjectCreated to bCreated
82375>>>        If (not (bCreated)) Begin
82377>>>            Send CreateComObject
82378>>>        End
82378>>>>
82378>>>
82378>>>        Move True to bOk
82379>>>
82379>>>        Get psReportId to sReportId
82380>>>        If (sReportId <> "") Begin
82382>>>            Send CloseReport sReportId
82383>>>            Move '' to sReportId
82384>>>        End
82384>>>>
82384>>>
82384>>>        Send OnPreOpenReport
82385>>>
82385>>>        // Open report
82385>>>        Get psReportName to sReport
82386>>>
82386>>>        Move (SysConf (SYSCONF_DIR_SEPARATOR)) to sSep
82387>>>        If (Pos (sSep, sReport) > 0) Begin
82389>>>            Move (DoesFileExist (sReport)) to bExists
82390>>>        End
82390>>>>
82390>>>        Else Begin
82391>>>            Move False to bExists
82392>>>        End
82392>>>>
82392>>>
82392>>>        If (bExists) Begin
82394>>>            Move sReport to sReportPath
82395>>>        End
82395>>>>
82395>>>        Else Begin
82396>>>            Get psReportPath to sReportPath
82397>>>            If (sReportPath <> "") Begin
82399>>>                // Make sure path ends with a DirSep before the report name will be added.
82399>>>                If (Right (sReportPath, 1) <> sSep) Begin
82401>>>                    Move (sReportPath - sSep) to sReportPath
82402>>>                End
82402>>>>
82402>>>                Move (sReportPath - sReport) to sReportPath
82403>>>                Move (DoesFileExist (sReportPath)) to bExists
82404>>>            End
82404>>>>
82404>>>
82404>>>            If (not (bExists)) Begin
82406>>>                If (ghoApplication) Begin
82408>>>                    // If no path was given, see if the report sits in a folder named Reports sub-folder of the workspace root
82408>>>                    Get ReportsFolder to sReportPath
82409>>>                    If (sReportPath <> '') Begin
82411>>>                        Move (sReportPath - sReport) to sReportPath
82412>>>                        Move (DoesFileExist (sReportPath)) to bExists
82413>>>                    End
82413>>>>
82413>>>
82413>>>                    If (not (bExists)) Begin
82415>>>                        // If the report is still not found, see if it resides in one of the datapaths of the workspace
82415>>>                        Get phoWorkspace of ghoApplication to hoWorkspace
82416>>>                        Get psDataPath of hoWorkspace to sDataPath
82417>>>                        Get CountOfPaths of hoWorkspace sDataPath to iPaths
82418>>>                        // Iterate through each datapath until report is located
82418>>>                        For iPath from 1 to iPaths
82424>>>>
82424>>>                            Get PathAtIndex of hoWorkspace sDataPath iPath to sReportPath
82425>>>                            // Make sure path ends with a DirSep before the report name will be added.
82425>>>                            If (Right (sReportPath, 1) <> sSep) Begin
82427>>>                                Move (sReportPath - sSep) to sReportPath
82428>>>                            End
82428>>>>
82428>>>                            Move (sReportPath - sReport) to sReportPath
82429>>>                            Move (DoesFileExist (sReportPath)) to bExists
82430>>>                        Until ((bExists) or (iPath = iPaths))
82432>>>                    End
82432>>>>
82432>>>                End
82432>>>>
82432>>>            End
82432>>>>
82432>>>        End
82432>>>>
82432>>>
82432>>>        If (not (bExists)) Begin
82434>>>            Move False to bOk
82435>>>            Error DFERR_DATAFLEX_REPORTS (SFormat (C_$UnabletoLocateReport, sReport))
82436>>>>
82436>>>        End
82436>>>>
82436>>>
82436>>>        // If Report was found, open it.
82436>>>        If (bOk) Begin
82438>>>            Send DisplayStatusPanel True
82439>>>            Send ShowReportLoadingStatusText
82440>>>            // open report
82440>>>            Get ComReportOpen sReportPath to sReportId
82441>>>            Move (sReportId <> "") to bOk
82442>>>            If (bOk) Begin
82444>>>                Set psReportId to sReportId
82445>>>                Send InitExportStructures
82446>>>                Get pbAutoLocateDFFiles to bAutoLocateDFFiles
82447>>>                If (bAutoLocateDFFiles) Begin
82449>>>                    Send AutoLocateDFFiles sReportId
82450>>>                End
82450>>>>
82450>>>            End
82450>>>>
82450>>>            If (not (bOk)) Begin
82452>>>                Get pbHasErrors to bOk
82453>>>                If (not (bOk)) Begin
82455>>>                    Error DFERR_DATAFLEX_REPORTS (SFormat (C_$ErrorOpeningReport, sReportPath))
82456>>>>
82456>>>                End
82456>>>>
82456>>>            End
82456>>>>
82456>>>        End
82456>>>>
82456>>>
82456>>>        If (bOk) Begin
82458>>>            // Set report location
82458>>>            Move (ExtractFilePath (sReportPath)) to sReportPath
82459>>>            Set psReportLocation to sReportPath
82460>>>        End
82460>>>>
82460>>>
82460>>>        If (bOk) Begin
82462>>>            Send OnInitializeReport
82463>>>            Get pbCanceled to bCanceled
82464>>>            If (bCanceled) Begin
82466>>>                Move False to bOk
82467>>>            End
82467>>>>
82467>>>        End
82467>>>>
82467>>>
82467>>>        // we check pbCanceled once more at the at end of the process. It is possible that OnError is setting this
82467>>>        // to True and that could happen any time. So we check at the very last moment here.
82467>>>        If (bOk) Begin
82469>>>            Get pbCanceled to bCanceled
82470>>>            If (bCanceled) Begin
82472>>>                Move False to bOk
82473>>>            End
82473>>>>
82473>>>        End
82473>>>>
82473>>>
82473>>>        If (not (bOk)) Begin
82475>>>            If (sReportId <> "") Begin
82477>>>                Send CloseReport sReportId
82478>>>                Move "" to sReportId
82479>>>            End
82479>>>>
82479>>>        End
82479>>>>
82479>>>
82479>>>        Send RedirectErrorsToLocalHandler False
82480>>>
82480>>>        Send DisplayStatusPanel False
82481>>>
82481>>>        Function_Return sReportId
82482>>>    End_Function
82483>>>
82483>>>    // Outputs the report
82483>>>    Procedure OutputReport
82485>>>        Integer eDestination eExportType
82485>>>        String sFileName
82485>>>        Handle hPrintDlg hoExportOptionsDialog
82485>>>
82485>>>        Send RedirectErrorsToLocalHandler True
82486>>>
82486>>>        Send RefreshReport
82487>>>
82487>>>        Get peOutputDestination to eDestination
82488>>>        Case Begin
82488>>>            Case (eDestination = PRINT_TO_WINDOW)
82490>>>                Send DisplayReport
82491>>>                Case Break
82492>>>            Case (eDestination = PRINT_TO_PRINTER)
82495>>>                Get phPrintDlg to hPrintDlg
82496>>>                Send PrintReport hPrintDlg
82497>>>                Case Break
82498>>>            Case (eDestination = PRINT_TO_PRINTER_NO_DIALOG)
82501>>>                Send PrintToDefaultPrinter
82502>>>                Case Break
82503>>>            Case (eDestination = PRINT_TO_FILE)
82506>>>                Get peExportType to eExportType
82507>>>                If (eExportType >= C_DRPDF and eExportType <= C_DRRTF) Begin
82509>>>                    Get psExportFileName to sFileName
82510>>>                    If (sFileName <> "") Begin
82512>>>                        Send ExportReport eExportType sFileName
82513>>>                    End
82513>>>>
82513>>>                    Else Begin
82514>>>                        Get phoExportOptionsDialog to hoExportOptionsDialog
82515>>>                        If (hoExportOptionsDialog <> 0) Begin
82517>>>                            Send ExportReport of hoExportOptionsDialog Self
82518>>>                        End
82518>>>>
82518>>>                        Else Begin
82519>>>                            Error DFERR_DATAFLEX_REPORTS C_$DRNoExportOptionsDialog
82520>>>>
82520>>>                        End
82520>>>>
82520>>>                    End
82520>>>>
82520>>>                End
82520>>>>
82520>>>                Else Begin
82521>>>                    Error DFERR_DATAFLEX_REPORTS (SFormat (C_$DRNoValidExportTypeSpecified, eExportType))
82522>>>>
82522>>>                End
82522>>>>
82522>>>                Case Break
82523>>>            Case Else
82523>>>                Error DFERR_DATAFLEX_REPORTS (SFormat (C_$DRNoValidPrintDestinationDefined, eDestination))
82524>>>>
82524>>>                Case Break
82525>>>        Case End
82525>>>
82525>>>        Send RedirectErrorsToLocalHandler False
82526>>>    End_Procedure
