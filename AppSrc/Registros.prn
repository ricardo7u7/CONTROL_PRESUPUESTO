89835>>>    Procedure Calcula_disponible
89838>>>        Local String sQ 
89838>>>        Local Handle hdbc69 hstmt69
89838>>>        Local Number nValor_Disponible nValor_Liquidar
89838>>>        
89838>>>        Move '' to sQ
89839>>>        Move 0  to nValor_Disponible
89840>>>        Append sQ " SELECT DISPONIBLE FROM dbo.fn_ObtenerTotalesPresupuesto(" PRESUPUESTO.NUMERO ",3, 'todos'); " 
89843>>>        SQLFileConnect EGRESOS to hdbc69
89844>>>        SQLOpen hdbc69 to hstmt69
89847>>>        SQLExecDirect hstmt69 sQ
89850>>>        Repeat
89850>>>>
89850>>>           SQLFileFetch hstmt69
89856>>>           If (SQLResult) Begin
89858>>>              Get SQLColumnValue of hstmt69   1 to nValor_Disponible
89859>>>           End
89859>>>>
89859>>>        Until (not(SQLResult))
89861>>>        SQLClose hstmt69
89864>>>        SQLDisconnect hdbc69
89867>>>        
89867>>>        Set Value of oDISPONIBLE to nValor_Disponible
89868>>>    End_Procedure
89869>>>    
89869>>>    Procedure Totales
89872>>>        Local String sQ 
89872>>>        Local Handle hdbc69 hstmt69
89872>>>        Local Number nValor_Disponible nValor_Liquidar
89872>>>        
89872>>>        Move '' to sQ
89873>>>        Move 0  to nValor_Liquidar
89874>>>        Append sQ " SELECT SUM(MONTO) FROM EGRESOS WHERE LIQUIDAR = 'S' "  
89875>>>        SQLFileConnect EGRESOS to hdbc69
89876>>>        SQLOpen hdbc69 to hstmt69
89879>>>        SQLExecDirect hstmt69 sQ
89882>>>        Repeat
89882>>>>
89882>>>           SQLFileFetch hstmt69
89888>>>           If (SQLResult) Begin
89890>>>              Get SQLColumnValue of hstmt69   1 to nValor_Liquidar
89891>>>           End
89891>>>>
89891>>>        Until (not(SQLResult))
89893>>>        SQLClose hstmt69
89896>>>        SQLDisconnect hdbc69
89899>>>        
89899>>>        Set Value of oVLR_LIQUIDAR to nValor_Liquidar
89900>>>    End_Procedure
89901>>>    
89901>>>    Procedure Liquidar 
89904>>>        Local String sQ 
89904>>>        Local Handle hdbc69 hstmt69
89904>>>        Local Number nValor_Disponible nValor_Liquidar
89904>>>        
89904>>>        Move '' to sQ
89905>>>        Move 0  to nValor_Disponible
89906>>>        Append sQ " SELECT DISPONIBLE FROM dbo.fn_ObtenerTotalesPresupuesto(" PRESUPUESTO.NUMERO ",3, 'todos'); " 
89909>>>        SQLFileConnect EGRESOS to hdbc69
89910>>>        SQLOpen hdbc69 to hstmt69
89913>>>        SQLExecDirect hstmt69 sQ
89916>>>        Repeat
89916>>>>
89916>>>           SQLFileFetch hstmt69
89922>>>           If (SQLResult) Begin
89924>>>              Get SQLColumnValue of hstmt69   1 to nValor_Disponible
89925>>>           End
89925>>>>
89925>>>        Until (not(SQLResult))
89927>>>        SQLClose hstmt69
89930>>>        SQLDisconnect hdbc69
89933>>>        
89933>>>        Move '' to sQ
89934>>>        Move 0  to nValor_Liquidar
89935>>>        Append sQ " SELECT SUM(MONTO) FROM EGRESOS WHERE LIQUIDAR = 'S' AND PRESUPUESTO = " PRESUPUESTO.NUMERO 
89937>>>        SQLFileConnect EGRESOS to hdbc69
89938>>>        SQLOpen hdbc69 to hstmt69
89941>>>        SQLExecDirect hstmt69 sQ
89944>>>        Repeat
89944>>>>
89944>>>           SQLFileFetch hstmt69
89950>>>           If (SQLResult) Begin
89952>>>              Get SQLColumnValue of hstmt69   1 to nValor_Liquidar
89953>>>           End
89953>>>>
89953>>>        Until (not(SQLResult))
89955>>>        SQLClose hstmt69
89958>>>        SQLDisconnect hdbc69
89961>>>        
89961>>>        Set Value of oDISPONIBLE to nValor_Disponible
89962>>>        Set Value of oVLR_LIQUIDAR to nValor_Liquidar
89963>>>        
89963>>>        If (nValor_Disponible < nValor_Liquidar) Begin
89965>>>            Local Integer iRespuesta
89965>>>            Get Confirm 'Monto a liquidar es mayor al disponible. Desea usar todo el disponible?' to iRespuesta
89966>>>            
89966>>>            If (iRespuesta eq 1) Begin
89968>>>                Send Stop_Box 'Liquidacion detenida...' '!'
89969>>>                Procedure_Return
89970>>>            End
89970>>>>
89970>>>        End
89970>>>>
89970>>>    
89970>>>        Move '' to sQ
