86205>>>>>//*** Possible SQL Column type values
86205>>>>>Define SQL_UNKNOWN_TYPE   For    0
86205>>>>>Define SQL_CHAR           For    1
86205>>>>>Define SQL_NUMERIC        For    2
86205>>>>>Define SQL_DECIMAL        For    3
86205>>>>>Define SQL_INTEGER        For    4
86205>>>>>Define SQL_SMALLINT       For    5
86205>>>>>Define SQL_FLOAT          For    6
86205>>>>>Define SQL_REAL           For    7
86205>>>>>Define SQL_DOUBLE         For    8
86205>>>>>Define SQL_DATETIME       For    9
86205>>>>>Define SQL_VARCHAR        For   12
86205>>>>>Define SQL_TYPE_DATE      For   91
86205>>>>>Define SQL_TYPE_TIME      For   92
86205>>>>>Define SQL_TYPE_TIMESTAMP For   93
86205>>>>>
86205>>>>>Define SQL_DATE           For    9
86205>>>>>Define SQL_INTERVAL       For   10
86205>>>>>Define SQL_TIME           For   10
86205>>>>>Define SQL_TIMESTAMP      For   11
86205>>>>>Define SQL_LONGVARCHAR    For  (-1)
86205>>>>>Define SQL_BINARY         For  (-2)
86205>>>>>Define SQL_VARBINARY      For  (-3)
86205>>>>>Define SQL_LONGVARBINARY  For  (-4)
86205>>>>>Define SQL_BIGINT         For  (-5)
86205>>>>>Define SQL_TINYINT        For  (-6)
86205>>>>>Define SQL_BIT            For  (-7)
86205>>>>>Define SQL_GUID           For (-11)
86205>>>>>
86205>>>>>
86205>>>>>
86205>>>>>//*****************************************************************************
86205>>>>>//*** Class  : cSQLStatement                                                ***
86205>>>>>//*** Purpose: Statement object for embedded sql                            ***
86205>>>>>//***                                                                       ***
86205>>>>>//*** Description:                                                          ***
86205>>>>>//***   An object is created for each statement. These will be children     ***
86205>>>>>//***   of cSQLConnection objects which manage the create and destruction   ***
86205>>>>>//***   of these.                                                           ***
86205>>>>>//*****************************************************************************
86205>>>>>
86205>>>>>Class cSQLStatement is an Array
86206>>>>>
86206>>>>>    Procedure Construct_object Integer Image
86208>>>>>        Forward Send Construct_object Image
86210>>>>>
86210>>>>>        Property Integer phCLIHandle      public 0
86211>>>>>        Property String  psDriverID       Public ""
86212>>>>>        Property Integer phStmtConnection Public 0
86213>>>>>        Property Integer piLastColumn     Public 0
86214>>>>>        Property Integer piLastArgument   Public 0
86215>>>>>        Property Integer piBindFile       Public 0
86216>>>>>
86216>>>>>        Set Delegation_mode To NO_Delegation
86217>>>>>    End_procedure // Construct_object
86218>>>>>
86218>>>>>
86218>>>>>
86218>>>>>    //***
86218>>>>>    //*** Procedure: StoreHandleInfo
86218>>>>>    //*** Purpose  : Store basic information about the statement handle.
86218>>>>>    //***
86218>>>>>
86218>>>>>    Procedure StoreHandleInfo Integer iCLIHandle String sDrvrId Integer iParentHandle
86220>>>>>        Set phCLIHandle      To iCLIHandle
86221>>>>>        Set psDriverID       To sDrvrId
86222>>>>>        Set phStmtConnection To iParentHandle
86223>>>>>    End_Procedure // StoreHandleInfo
86224>>>>>
86224>>>>>
86224>>>>>
86224>>>>>    //***
86224>>>>>    //*** Procedure: FreeHandle
86224>>>>>    //*** Purpose  : Free a handle. Since a handle is stored in an
86224>>>>>    //***            cSQLStatement object, we destroy the object.
86224>>>>>    //***
86224>>>>>
86224>>>>>    Procedure FreeHandle
86226>>>>>        Send Destroy_Object
86227>>>>>    End_Procedure // FreeHandle
86228>>>>>
86228>>>>>
86228>>>>>
86228>>>>>    //***
86228>>>>>    //*** Procedure: HandleError
86228>>>>>    //*** Puprose  : Handle an error that has occured while checking properties.
86228>>>>>    //***
86228>>>>>
86228>>>>>    Procedure HandleError Integer ihstmt Integer ihdbc String sDrvrId String sOriginMsg
86230>>>>>        Local Integer iErrHandle
86230>>>>>        Local Integer iErrNum
86230>>>>>        Local String  sLocationInfo
86230>>>>>
86230>>>>>        //*** Get the DataFlex statement identifier
86230>>>>>        Move Current_object To iErrHandle
86231>>>>>
86231>>>>>        //*** Determine error number
86231>>>>>        If (ihstmt = 0) ;            Move CLIERR_SQLINVALID_CLI_STMT_HANDLE To iErrNum
86234>>>>>        Else If (ihdbc = 0) ;            Move CLIERR_SQLINVALID_CLI_CONN_HANDLE To iErrNum
86238>>>>>        Else If (sDrvrId = "") ;            Move CLIERR_SQLINVALID_DRIVER_ID To iErrNum
86242>>>>>        Else ;            Move CLIERR_SQL_ERROR To iErrNum
86244>>>>>
86244>>>>>        //*** Create location ifnormation
86244>>>>>        Move "[" To sLocationInfo
86245>>>>>        If (sOriginMsg <> "") Begin
86247>>>>>            Move (Append(sLocationInfo, sOriginMsg)) To sLocationInfo
86248>>>>>            Move (Append(sLocationInfo, ", "))       To sLocationInfo
86249>>>>>        End
86249>>>>>>
86249>>>>>        Move (Append(sLocationInfo, "DataFlex hstmt = ")) To sLocationInfo
86250>>>>>        Move (Append(sLocationInfo, iErrHandle))          To sLocationInfo
86251>>>>>        Move (Append(sLocationInfo, "]"))                 To sLocationInfo
86252>>>>>
86252>>>>>        //*** Generate the error
86252>>>>>        Error iErrNum sLocationInfo
86253>>>>>>
86253>>>>>    End_Procedure // HandleError
86254>>>>>
86254>>>>>
86254>>>>>
86254>>>>>    //***
86254>>>>>    //*** Procedure: StmtError
86254>>>>>    //*** Purpose  : Handle general error not related to the properties
86254>>>>>    //***
86254>>>>>
86254>>>>>    Procedure StmtError Integer iErrNum String sErrText String sOriginMsg
86256>>>>>        Local Integer iErrHandle
86256>>>>>        Local String  sLocationInfo
86256>>>>>
86256>>>>>        //*** Get the DataFlex statement identifier
86256>>>>>        Move Current_object To iErrHandle
86257>>>>>
86257>>>>>
86257>>>>>        //*** Create location information
86257>>>>>        Move "[" To sLocationInfo
86258>>>>>        If (sOriginMsg <> "") Begin
86260>>>>>            Move (Append(sLocationInfo, sOriginMsg)) To sLocationInfo
86261>>>>>            Move (Append(sLocationInfo, ", "))       To sLocationInfo
86262>>>>>        End
86262>>>>>>
86262>>>>>        If (sErrtext <> "") Begin
86264>>>>>            Move (Append(sLocationInfo, sErrtext)) To sLocationInfo
86265>>>>>            Move (Append(sLocationInfo, ", "))     To sLocationInfo
86266>>>>>        End
86266>>>>>>
86266>>>>>        Move (Append(sLocationInfo, "DataFlex hstmt = ")) To sLocationInfo
86267>>>>>        Move (Append(sLocationInfo, iErrHandle))          To sLocationInfo
86268>>>>>        Move (Append(sLocationInfo, "]"))                 To sLocationInfo
86269>>>>>
86269>>>>>        //*** Generate the error
86269>>>>>        Error iErrNum sLocationInfo
86270>>>>>>
86270>>>>>    End_Procedure // StmtError
86271>>>>>
86271>>>>>
86271>>>>>
86271>>>>>    //***
86271>>>>>    //*** Procedure: SQLIllegalAttribute
86271>>>>>    //*** Purpose  : Handle an illegal attribute error
86271>>>>>    //***
86271>>>>>
86271>>>>>    Procedure SQLIllegalAttribute String sErrText String sOriginMsg
86273>>>>>        Local Integer bReport
86273>>>>>
86273>>>>>        Get_attribute DF_REPORT_UNSUPPORTED_ATTRIBUTES To bReport
86276>>>>>        If (bReport) ;            Send StmtError CLIERR_SQLINVALID_ATTRIBUTE sErrtext sOriginMsg
86279>>>>>    End_Procedure // SQLIllegalAttribute
86280>>>>>
86280>>>>>
86280>>>>>
86280>>>>>    //***
86280>>>>>    //*** Function: SQLPrivateColumnIsLegal
86280>>>>>    //*** Purpose : Check if a column number is legal
86280>>>>>    //***
86280>>>>>
86280>>>>>    Function SQLPrivateColumnIsLegal Integer ihdbc String sDrvrId Integer ihstmt Integer iCol Returns Integer
86282>>>>>        Local Integer bLegal
86282>>>>>        Local Integer iNumColumns
86282>>>>>
86282>>>>>        Get SQLPrivateStmtAttribute SQLSTMTATTRIB_COLUMNCOUNT ihdbc sDrvrId ihstmt To iNumColumns
86283>>>>>        If (iCol > 0 And iCol <= iNumColumns) ;            Move DFTRUE To bLegal
86286>>>>>        Else ;            Move DFFALSE To bLegal
86288>>>>>
86288>>>>>        Function_Return bLegal
86289>>>>>    End_Function // SQLPrivateColumnIsLegal
86290>>>>>
86290>>>>>
86290>>>>>
86290>>>>>    //***
86290>>>>>    //*** Procedure: SQLClose
86290>>>>>    //*** Purpose  : Close a statement and free all alllocated resources
86290>>>>>    //***
86290>>>>>
86290>>>>>    Procedure SQLClose
86292>>>>>        Local Integer ihdbc
86292>>>>>        Local Integer ihstmt
86292>>>>>        Local Integer iVoid
86292>>>>>        Local String  sDrvrId
86292>>>>>        Local String  sEmpty
86292>>>>>
86292>>>>>        //*** Initialize
86292>>>>>        Move "" To sEmpty
86293>>>>>
86293>>>>>        //*** Get the cli handle to the connection
86293>>>>>        Get phCLIHandle        To ihstmt
86294>>>>>        Get psDriverId         To sDrvrId
86295>>>>>        Get phStmtConnection   To ihdbc
86296>>>>>
86296>>>>>        //*** Free the CLI handle
86296>>>>>        If (ihstmt <> 0 And ihdbc <> 0 And sDrvrId <> "") Begin
86298>>>>>            //*** Call the driver function to close
86298>>>>>            Call_driver 0 sDrvrId Function FUNC_SQLCLOSE ;                        Callback Current_Object ;                        Passing ihdbc sEmpty ihstmt ;                        Result iVoid
86303>>>>>
86303>>>>>            //*** Free the DataFlex handle
86303>>>>>            Send FreeHandle
86304>>>>>        End
86304>>>>>>
86304>>>>>        Else ;            Send HandleError ihstmt ihdbc sDrvrId "SQLClose"
86306>>>>>    End_procedure // SQLClose
86307>>>>>
86307>>>>>
86307>>>>>
86307>>>>>    //***
86307>>>>>    //*** Procedure: SQLPrepare
86307>>>>>    //*** Purpose  : Prepare a statement for execution
86307>>>>>    //***
86307>>>>>
86307>>>>>    Procedure SQLPrepare String sStatement
86309>>>>>        Local Integer ihdbc
86309>>>>>        Local Integer ihstmt
86309>>>>>        Local Integer iVoid
86309>>>>>        Local String  sDrvrId
86309>>>>>
86309>>>>>        //*** Get the cli handle to the connection
86309>>>>>        Get phCLIHandle       To ihstmt
86310>>>>>        Get psDriverId        To sDrvrId
86311>>>>>        Get phStmtConnection  To ihdbc
86312>>>>>
86312>>>>>        //*** Prepare
86312>>>>>        If (ihstmt <> 0 And ihdbc <> 0 And sDrvrId <> "") Begin
86314>>>>>            //*** Call the driver function to prepare
86314>>>>>            Call_driver 0 sDrvrId Function FUNC_SQLPREPARE ;                        Callback Current_Object ;                        Passing ihdbc sStatement ihstmt ;                        Result iVoid
86319>>>>>        End
86319>>>>>>
86319>>>>>        Else ;            Send HandleError ihstmt ihdbc sDrvrId "SQLPrepare"
86321>>>>>    End_procedure // SQLPrepare
86322>>>>>
86322>>>>>
86322>>>>>
86322>>>>>    //***
86322>>>>>    //*** Procedure: SQLExecute
86322>>>>>    //*** Purpose  : Execute a prepared statement
86322>>>>>    //***
86322>>>>>
86322>>>>>    Procedure SQLExecute
86324>>>>>        Local Integer ihdbc
86324>>>>>        Local Integer ihstmt
86324>>>>>        Local Integer iVoid
86324>>>>>        Local String  sDrvrId
86324>>>>>        Local String  sEmpty
86324>>>>>
86324>>>>>        //*** Initialize
86324>>>>>        Move "" To sEmpty
86325>>>>>
86325>>>>>        //*** Get the cli handle to the connection
86325>>>>>        Get phCLIHandle       To ihstmt
86326>>>>>        Get psDriverId        To sDrvrId
86327>>>>>        Get phStmtConnection  To ihdbc
86328>>>>>
86328>>>>>        //*** Execute
86328>>>>>        If (ihstmt <> 0 And ihdbc <> 0 And sDrvrId <> "") Begin
86330>>>>>            //*** Call the driver function to execute
86330>>>>>            Call_driver 0 sDrvrId Function FUNC_SQLEXECUTE ;                        Callback Current_Object ;                        Passing ihdbc sEmpty ihstmt ;                        Result iVoid
86335>>>>>        End
86335>>>>>>
86335>>>>>        Else ;            Send HandleError ihstmt ihdbc sDrvrId "SQLExecute"
86337>>>>>    End_Procedure // SQLExecute
86338>>>>>
86338>>>>>
86338>>>>>
86338>>>>>    //***
86338>>>>>    //*** Procedure: SQLExecDirect
86338>>>>>    //*** Purpose  : Prepare and execute a statement
86338>>>>>    //***
86338>>>>>
86338>>>>>    Procedure SQLExecDirect String sStatement
86340>>>>>        Local Integer ihdbc
86340>>>>>        Local Integer ihstmt
86340>>>>>        Local Integer iVoid
86340>>>>>        Local String  sDrvrId
86340>>>>>
86340>>>>>        //*** Get the cli handle to the connection
86340>>>>>        Get phCLIHandle        To ihstmt
86341>>>>>        Get psDriverId         To sDrvrId
86342>>>>>        Get phStmtConnection   To ihdbc
86343>>>>>
86343>>>>>        //*** ExecDirect
86343>>>>>        If (ihstmt <> 0 And ihdbc <> 0 And sDrvrId <> "") Begin
86345>>>>>            //*** Call the driver function to execdirect
86345>>>>>            Call_driver 0 sDrvrId Function FUNC_SQLEXECDIRECT ;                        Callback Current_Object ;                        Passing ihdbc sStatement ihstmt ;                        Result iVoid
86350>>>>>        End
86350>>>>>>
86350>>>>>        Else ;            Send HandleError ihstmt ihdbc sDrvrId "SQLExecDirect"
86352>>>>>    End_procedure // SQLExecDirect
86353>>>>>
86353>>>>>
86353>>>>>
86353>>>>>    //***
86353>>>>>    //*** Procedure: SQLFetch
86353>>>>>    //*** Purpose  : Fetch the next row
86353>>>>>    //*** Returns  : 0   = No more data
86353>>>>>    //***            <>0 = Success
86353>>>>>    //***
86353>>>>>
86353>>>>>    Function SQLFetch Returns Integer
86355>>>>>        Local Integer ihdbc
86355>>>>>        Local Integer ihstmt
86355>>>>>        Local Integer iResult
86355>>>>>        Local String  sDrvrId
86355>>>>>        Local String  sEmpty
86355>>>>>
86355>>>>>        //*** Initialize
86355>>>>>        Move "" To sEmpty
86356>>>>>        Move 0  To iResult
86357>>>>>
86357>>>>>        //*** Get the cli handle to the connection
86357>>>>>        Get phCLIHandle        To ihstmt
86358>>>>>        Get psDriverId         To sDrvrId
86359>>>>>        Get phStmtConnection   To ihdbc
86360>>>>>
86360>>>>>        //*** Fetch
86360>>>>>        If (ihstmt <> 0 And ihdbc <> 0 And sDrvrId <> "") Begin
86362>>>>>            Indicate Err False
86363>>>>>
86363>>>>>            //*** Call the driver function to fetch
86363>>>>>            Call_driver 0 sDrvrId Function FUNC_SQLFETCH ;                        Callback Current_Object ;                        Passing ihdbc sEmpty ihstmt ;                        Result iResult
86368>>>>>
86368>>>>>            //*** If something went wrong, adjust the result
86368>>>>>            If (Err) ;                Move 0 To iResult
86371>>>>>
86371>>>>>            Set piLastcolumn To 0
86372>>>>>        End
86372>>>>>>
86372>>>>>        Else ;            Send HandleError ihstmt ihdbc sDrvrId "SQLFetch"
86374>>>>>
86374>>>>>        Function_return iResult
86375>>>>>    End_Function // SQLFetch
86376>>>>>
86376>>>>>
86376>>>>>
86376>>>>>    //***
86376>>>>>    //*** Function: SQLNextColumn
86376>>>>>    //*** Purpose : Get the next column
86376>>>>>    //***
86376>>>>>
86376>>>>>    Function SQLNextColumn Returns String
86378>>>>>        Local Integer iCol
86378>>>>>        Local String  sResult
86378>>>>>
86378>>>>>        Get piLastColumn To iCol
86379>>>>>        Increment iCol
86380>>>>>        Get SQLColumnValue iCol To sResult
86381>>>>>        Set piLastColumn To iCol
86382>>>>>
86382>>>>>        Function_return sResult
86383>>>>>    End_Function // SQLNextColumn
86384>>>>>
86384>>>>>
86384>>>>>
86384>>>>>    //***
86384>>>>>    //*** Function: SQLColumnValue
86384>>>>>    //*** Purpose : Return the value of a column in a fetched row of a given
86384>>>>>    //***           statement.
86384>>>>>    //***
86384>>>>>
86384>>>>>    Function SQLColumnValue Integer iCol Returns String
86386>>>>>        Local Integer ihdbc
86386>>>>>        Local Integer ihstmt
86386>>>>>        Local String  sDrvrId
86386>>>>>        Local String  sResult
86386>>>>>
86386>>>>>        //*** Initialize
86386>>>>>        Move "" To sResult
86387>>>>>
86387>>>>>        //*** Get the cli handle to the connection
86387>>>>>        Get phCLIHandle       To ihstmt
86388>>>>>        Get psDriverId        To sDrvrId
86389>>>>>        Get phStmtConnection  To ihdbc
86390>>>>>
86390>>>>>        //*** Get the value
86390>>>>>        If (ihstmt <> 0 And ihdbc <> 0 And sDrvrId <> "") ;            Get SQLPrivateColumnValue iCol ihdbc sDRvrId ihstmt To sResult
86393>>>>>        Else ;            Send HandleError ihstmt ihdbc sDrvrId "SQLColumnValue"
86395>>>>>
86395>>>>>        Function_return sResult
86396>>>>>    End_Function // SQLColumnValue
86397>>>>>
86397>>>>>    Function SQLPrivateColumnValue Integer iCol Integer ihdbc String sDrvrId Integer ihstmt Returns String
86399>>>>>        Local Integer iVoid
86399>>>>>        Local Integer iColSize
86399>>>>>        Local String  sResult
86399>>>>>        Local String  sEmpty
86399>>>>>        Local Integer bLegalColumn
86399>>>>>
86399>>>>>        //*** Initialize
86399>>>>>        Move "" To sEmpty
86400>>>>>
86400>>>>>        //*** Get the value
86400>>>>>        If (ihstmt <> 0 And ihdbc <> 0 And sDrvrId <> "") Begin
86402>>>>>            //*** Check if the column exists
86402>>>>>            Get SQLPrivateColumnIsLegal ihdbc sDrvrId ihstmt iCol To bLegalColumn
86403>>>>>            If (bLegalColumn) Begin
86405>>>>>                //*** Determine the column size
86405>>>>>                Get SQLPrivateColAttribute iCol SQLCOLATTRIB_SIZE ihdbc sDrvrId ihstmt To iColSize
86406>>>>>                If (iColSize > 0) Begin
86408>>>>>                    //*** Setup function arguments
86408>>>>>                    Call_driver 0 sDrvrId Function FUNC_SQLCOLUMNINFO ;                                Callback Current_Object ;                                Passing ihdbc iCol ihstmt ;                                Result iVoid
86413>>>>>
86413>>>>>                    //*** Allocate
86413>>>>>                    Move (Repeat(' ', iColSize)) To sResult
86414>>>>>
86414>>>>>                    //*** Call the driver function to get the value
86414>>>>>                    Call_driver 0 sDrvrId Function FUNC_SQLCOLUMNVALUE ;                                Callback Current_Object ;                                Passing sResult sEmpty 0 ;                                Result iVoid
86419>>>>>                End
86419>>>>>>
86419>>>>>            End
86419>>>>>>
86419>>>>>            Else ;                Send StmtError CLIERR_SQLINVALID_COLUMN ("(Column number = " + String(iCol) + ")") "SQLPrivateColumnValue"
86421>>>>>        End
86421>>>>>>
86421>>>>>        Else ;            Send HandleError ihstmt ihdbc sDrvrId "SQLPrivateColumnValue"
86423>>>>>
86423>>>>>        Function_return sResult
86424>>>>>    End_Function // SQLColumnValue
86425>>>>>
86425>>>>>
86425>>>>>
86425>>>>>    //***
86425>>>>>    //*** Procedure: SQLBindFile
86425>>>>>    //*** Purpose  : Add a file to the files used to place the statement result in.
86425>>>>>    //***
86425>>>>>
86425>>>>>    Procedure SQLBindFile Integer iFileNum
86427>>>>>        Local Integer ihdbc
86427>>>>>        Local Integer ihstmt
86427>>>>>        Local Integer iVoid
86427>>>>>        Local String  sDrvrId
86427>>>>>        Local String  sFileType
86427>>>>>        Local Integer bIsOpen
86427>>>>>
86427>>>>>        //*** Get the cli handle to the connection
86427>>>>>        Get phCLIHandle       To ihstmt
86428>>>>>        Get psDriverId        To sDrvrId
86429>>>>>        Get phStmtConnection  To ihdbc
86430>>>>>
86430>>>>>        //*** If a file number is not passed see if we can use the statement's
86430>>>>>        //*** default file number which is usually set with SetFileConnection
86430>>>>>        If (iFileNum = 0) Begin
86432>>>>>            Get piBindFile To iFileNum
86433>>>>>            If (iFileNum = 0) Begin
86435>>>>>                //*** Logic error, if 0 is passed as filenumber, piBindFile should be set.
86435>>>>>                Send StmtError CLIERR_SQLINVALID_BIND_FILE "piBindFile should be set" "SQLBindFile"
86436>>>>>
86436>>>>>                Move 0 to SQLResult
86437>>>>>                Procedure_Return
86438>>>>>            End
86438>>>>>>
86438>>>>>        End
86438>>>>>>
86438>>>>>
86438>>>>>        //*** Bind the file
86438>>>>>        If (ihstmt <> 0 And ihdbc <> 0 And sDrvrId <> "") Begin
86440>>>>>            //*** Chek if the file is open
86440>>>>>            Get_attribute DF_FILE_OPENED Of iFileNum To bIsOpen
86443>>>>>            If (bIsOpen) Begin
86445>>>>>                //*** Check if the file has the correct type
86445>>>>>                Get_attribute DF_FILE_DRIVER Of iFileNum To sFileType
86448>>>>>                If (sFileType = sDrvrId) Begin
86450>>>>>                    //*** Call the driver function to add a file to a statement
86450>>>>>                    Call_driver 0 sDrvrId Function FUNC_SQLBINDFILE ;                                Callback Current_Object ;                                Passing ihdbc iFileNum ihstmt ;                                Result iVoid
86455>>>>>                End
86455>>>>>>
86455>>>>>                Else ;                    Send StmtError CLIERR_SQLINVALID_BIND_FILE ("File" * String(iFileNum) * "type incompatible with statement ("  + sFileType + ")") "SQLBindFile"
86457>>>>>            End
86457>>>>>>
86457>>>>>            Else ;                Send StmtError CLIERR_SQLINVALID_BIND_FILE ("File not open (number =" * String(iFileNum) + ")") "SQLBindFile"
86459>>>>>        End
86459>>>>>>
86459>>>>>        Else ;            Send HandleError ihstmt ihdbc sDrvrId "SQLBindFile"
86461>>>>>    End_Procedure // SQLBindFile
86462>>>>>
86462>>>>>
86462>>>>>
86462>>>>>    //*************************************************************************
86462>>>>>    //*** Function: SQLGetData                                              ***
86462>>>>>    //*** Purpose : Get data of a column.                                   ***
86462>>>>>    //*************************************************************************
86462>>>>>
86462>>>>>    Function SQLGetData Integer iCol Integer iLen Returns String
86464>>>>>        Local Integer ihdbc
86464>>>>>        Local Integer ihstmt
86464>>>>>        Local Integer iVoid
86464>>>>>        Local Integer iColSize
86464>>>>>        Local Integer iResult
86464>>>>>        Local String  sDrvrId
86464>>>>>        Local String  sResult
86464>>>>>        Local String  sEmpty
86464>>>>>        Local Integer bLegalColumn
86464>>>>>
86464>>>>>        //*** Initialize
86464>>>>>        Move "" To sEmpty
86465>>>>>        Move 0 To iResult
86466>>>>>
86466>>>>>        //*** Get the cli handle to the connection
86466>>>>>        Get phCLIHandle       To ihstmt
86467>>>>>        Get psDriverId        To sDrvrId
86468>>>>>        Get phStmtConnection  To ihdbc
86469>>>>>
86469>>>>>        //*** Get the data
86469>>>>>        If (ihstmt <> 0 And ihdbc <> 0 And sDrvrId <> "") Begin
86471>>>>>            //*** Check if the column exists
86471>>>>>            Get SQLPrivateColumnIsLegal ihdbc sDrvrId ihstmt iCol To bLegalColumn
86472>>>>>            If (bLegalColumn) Begin
86474>>>>>                If (iLen = 0) ;                    Get SQLPrivateColumnValue iCol ihdbc sDrvrId ihstmt To sResult
86477>>>>>                Else Begin
86478>>>>>                    //*** Setup function arguments
86478>>>>>                    Call_driver 0 sDrvrId Function FUNC_SQLCOLUMNINFO ;                                Callback Current_Object ;                                Passing ihdbc iCol ihstmt ;                                Result iVoid
86483>>>>>
86483>>>>>                    //*** Allocate
86483>>>>>                    Move (Repeat(' ', iLen)) To sResult
86484>>>>>
86484>>>>>                    Indicate Err False
86485>>>>>
86485>>>>>                    //*** Call the driver function to get the data
86485>>>>>                    Call_driver 0 sDrvrId Function FUNC_SQLGETDATA ;                                Callback Current_Object ;                                Passing sResult sEmpty iLen ;                                Result iResult
86490>>>>>
86490>>>>>                    //*** If something went wrong, adjust the result
86490>>>>>                    If (Err) ;                        Move 0 To iResult
86493>>>>>                End
86493>>>>>>
86493>>>>>            End
86493>>>>>>
86493>>>>>            Else ;                Send StmtError CLIERR_SQLINVALID_COLUMN ("(Column number = " + String(iCol) + ")") "SQLGetData"
86495>>>>>        End
86495>>>>>>
86495>>>>>        Else ;            Send HandleError ihstmt ihdbc sDrvrId "SQLGetData"
86497>>>>>
86497>>>>>        //*** Fill global result
86497>>>>>        Move iResult To SQLResult
86498>>>>>
86498>>>>>        Function_Return sResult
86499>>>>>    End_Function // SQLGetData
86500>>>>>
86500>>>>>
86500>>>>>
86500>>>>>    //***
86500>>>>>    //*** Function: SQLColumnMap
86500>>>>>    //*** Purpose : Map a column name to a number, if the name id not found no
86500>>>>>    //***           error is generated the returned number will be 0 (zero) in
86500>>>>>    //***           that case
86500>>>>>    //***
86500>>>>>
86500>>>>>    Function SQLColumnMap String sColname Returns Integer
86502>>>>>        Local Integer ihdbc
86502>>>>>        Local Integer ihstmt
86502>>>>>        Local Integer iNumColumns
86502>>>>>        Local Integer iColCount
86502>>>>>        Local Integer iColNum
86502>>>>>        Local String  sDrvrId
86502>>>>>        Local String  sCurColName
86502>>>>>
86502>>>>>        //*** Get the cli handle to the connection
86502>>>>>        Get phCLIHandle       To ihstmt
86503>>>>>        Get psDriverId        To sDrvrId
86504>>>>>        Get phStmtConnection  To ihdbc
86505>>>>>
86505>>>>>        //*** Get the number by looping through the column names
86505>>>>>        Move 0 To iColNum
86506>>>>>        Get SQLPrivateStmtAttribute SQLSTMTATTRIB_COLUMNCOUNT ihdbc sDrvrId ihstmt To iNumColumns
86507>>>>>        For iColCount From 1 To iNumColumns
86513>>>>>>
86513>>>>>            Get SQLPrivateColAttribute iColCount SQLCOLATTRIB_LABEL ihdbc sDrvrId ihstmt To sCurColName
86514>>>>>            If (Uppercase(Trim(sColName)) = Uppercase(Trim(sCurColName))) ;                Move iColCount To iColNum
86517>>>>>
86517>>>>>            If (iColNum) ;                Break
86520>>>>>        Loop
86521>>>>>>
86521>>>>>
86521>>>>>        Function_return iColNum
86522>>>>>    End_Function // SQLColumnMap
86523>>>>>
86523>>>>>
86523>>>>>
86523>>>>>    //***
86523>>>>>    //*** Function: SQLStmtAttribute
86523>>>>>    //*** Purpose : Get a statement attribute
86523>>>>>    //***
86523>>>>>
86523>>>>>    Function SQLStmtAttribute Integer iAttribId Returns String
86525>>>>>        Local Integer ihdbc
86525>>>>>        Local Integer ihstmt
86525>>>>>        Local String  sResult
86525>>>>>        Local String  sDrvrId
86525>>>>>
86525>>>>>        //*** Initialize
86525>>>>>        Move "" To sResult
86526>>>>>
86526>>>>>        //*** Get the cli handle to the connection
86526>>>>>        Get phCLIHandle       To ihstmt
86527>>>>>        Get psDriverId        To sDrvrId
86528>>>>>        Get phStmtConnection  To ihdbc
86529>>>>>
86529>>>>>        //*** Get the attribute
86529>>>>>        If (ihstmt <> 0 And ihdbc <> 0 And sDrvrId <> "") ;            Get SQLPrivateStmtAttribute iAttribId ihdbc sDrvrId ihstmt To sResult
86532>>>>>        Else ;            Send HandleError ihstmt ihdbc sDrvrId "SQLStmtAttribute"
86534>>>>>
86534>>>>>        Function_Return sResult
86535>>>>>    End_Function // SQLStmtAttibute
86536>>>>>
86536>>>>>    Function SQLPrivateStmtAttribute Integer iAttribId Integer ihdbc String sDrvrId Integer ihstmt Returns String
86538>>>>>        Local String  sResult
86538>>>>>        Local Integer iLen
86538>>>>>        Local Integer bLegalAttrib
86538>>>>>
86538>>>>>        //*** Initialize
86538>>>>>        Move ""     To sResult
86539>>>>>
86539>>>>>        //*** Get the attribute
86539>>>>>        If (ihstmt <> 0 And ihdbc <> 0 And sDrvrId <> "") Begin
86541>>>>>            Case Begin
86541>>>>>                Case (iAttribId = SQLSTMTATTRIB_COLUMNCOUNT)
86543>>>>>                Case (iAttribId = SQLSTMTATTRIB_ROWCOUNT)
86546>>>>>                Case (iAttribId = SQLSTMTATTRIB_ROWCOUNT_TYPE)
86549>>>>>                    Move DFTRUE To bLegalAttrib
86550>>>>>                    Break
86551>>>>>
86551>>>>>                Case Else
86551>>>>>                    Move DFFALSE To bLegalAttrib
86552>>>>>                    Send SQLIllegalAttribute ("Attribute is = " + String(iAttribId) + ")") "SQLPrivateStmtAttribute"
86553>>>>>            Case End
86553>>>>>
86553>>>>>            If (bLegalAttrib) Begin
86555>>>>>                //*** Setup function arguments
86555>>>>>                Call_driver 0 sDrvrId Function FUNC_SQLSTMTINTATTRIB ;                            Callback Current_Object ;                            Passing ihdbc iAttribId ihstmt ;                            Result sResult
86560>>>>>            End
86560>>>>>>
86560>>>>>        End
86560>>>>>>
86560>>>>>        Else ;            Send HandleError ihstmt ihdbc sDrvrId "SQLPrivateStmtAttribute"
86562>>>>>
86562>>>>>        Function_Return sResult
86563>>>>>    End_Function // SQLPrivateStmtAttribute
86564>>>>>
86564>>>>>
86564>>>>>
86564>>>>>    //***
86564>>>>>    //*** Function: SQLColAttribute
86564>>>>>    //*** Purpose : Get a column's attribute
86564>>>>>    //***
86564>>>>>
86564>>>>>    Function SQLColAttribute Integer iCol Integer iAttribId Returns String
86566>>>>>        Local Integer ihdbc
86566>>>>>        Local Integer ihstmt
86566>>>>>        Local String  sResult
86566>>>>>        Local String  sDrvrId
86566>>>>>
86566>>>>>        //*** Initialize
86566>>>>>        Move "" To sResult
86567>>>>>
86567>>>>>        //*** Get the cli handle to the connection
86567>>>>>        Get phCLIHandle       To ihstmt
86568>>>>>        Get psDriverId        To sDrvrId
86569>>>>>        Get phStmtConnection  To ihdbc
86570>>>>>
86570>>>>>        //*** Get the attribute
86570>>>>>        If (ihstmt <> 0 And ihdbc <> 0 And sDrvrId <> "") ;            Get SQLPrivateColAttribute iCol iAttribId ihdbc sDrvrId ihstmt To sResult
86573>>>>>        Else ;            Send HandleError ihstmt ihdbc sDrvrId "SQLColAttribute"
86575>>>>>
86575>>>>>        Function_Return sResult
86576>>>>>    End_Function // SQLColAttribute
86577>>>>>
86577>>>>>    Function SQLPrivateColAttribute Integer iCol Integer iAttribId Integer ihdbc String sDrvrId Integer ihstmt Returns String
86579>>>>>        Local String  sResult
86579>>>>>        Local String  sEmpty
86579>>>>>        Local Integer bIsStringAttribute
86579>>>>>        Local Integer iLen
86579>>>>>        Local Integer iVoid
86579>>>>>        Local Integer bLegalAttrib
86579>>>>>        Local Integer bLegalColumn
86579>>>>>
86579>>>>>        //*** Initialize
86579>>>>>        Move "" To sResult
86580>>>>>        Move "" To sEmpty
86581>>>>>        MOve 0  To iLen
86582>>>>>
86582>>>>>        //*** Get the attribute
86582>>>>>        If (ihstmt <> 0 And ihdbc <> 0 And sDrvrId <> "") Begin
86584>>>>>            Get SQLPrivateColumnIsLegal ihdbc sDrvrId ihstmt iCol To bLegalColumn
86585>>>>>            If (bLegalColumn) Begin
86587>>>>>                //*** Determine the atributes type
86587>>>>>                Case Begin
86587>>>>>                    Case (iAttribId = SQLCOLATTRIB_SIZE)
86589>>>>>                    Case (iAttribId = SQLCOLATTRIB_LENGTH)
86592>>>>>                    Case (iAttribId = SQLCOLATTRIB_PRECISION)
86595>>>>>                    Case (iAttribId = SQLCOLATTRIB_SQLTYPE)
86598>>>>>                    Case (iAttribId = SQLCOLATTRIB_NULLABLE)
86601>>>>>                    Case (iAttribId = SQLCOLATTRIB_DFTYPE)
86604>>>>>                        Move DFFALSE To bIsStringAttribute
86605>>>>>                        Move DFTRUE To bLegalAttrib
86606>>>>>                        Break
86607>>>>>
86607>>>>>                    Case (iAttribId = SQLCOLATTRIB_LABEL)
86610>>>>>                    Case (iAttribId = SQLCOLATTRIB_BASECOLUMNNAME)
86613>>>>>                    Case (iAttribId = SQLCOLATTRIB_BASETABLENAME)
86616>>>>>                        Move DFTRUE To bIsStringAttribute
86617>>>>>                        Move DFTRUE To bLegalAttrib
86618>>>>>                        Break
86619>>>>>
86619>>>>>                    Case Else
86619>>>>>                        Move DFFALSE To bLegalAttrib
86620>>>>>                        Send SQLIllegalAttribute ("Attribute is = " + String(iAttribId) + ")") "SQLPrivateColAttribute"
86621>>>>>                Case End
86621>>>>>
86621>>>>>                If (bLegalAttrib) Begin
86623>>>>>                    //*** Setup function arguments
86623>>>>>                    Call_driver 0 sDrvrId Function FUNC_SQLCOLUMNINFO ;                                Callback Current_Object ;                                Passing ihdbc iCol ihstmt ;                                Result iVoid
86628>>>>>
86628>>>>>                    If (bIsStringAttribute) Begin
86630>>>>>                        //*** Call the driver function to get the data length
86630>>>>>                        Call_driver 0 sDrvrId Function FUNC_SQLCOLSTRINGATTRIBLEN ;                                    Callback Current_Object ;                                    Passing sEmpty sEmpty iAttribId ;                                    Result iLen
86635>>>>>
86635>>>>>                        If (iLen) Begin
86637>>>>>                            //*** Allocate
86637>>>>>                            Move (Repeat(' ', iLen)) To sResult
86638>>>>>
86638>>>>>                            //*** Call the driver function to get the name
86638>>>>>                            Call_driver 0 sDrvrId Function FUNC_SQLCOLSTRINGATTRIB ;                                        Callback Current_Object ;                                        Passing sResult sEmpty iAttribId ;                                        Result iVoid
86643>>>>>                        End
86643>>>>>>
86643>>>>>                    End
86643>>>>>>
86643>>>>>                    Else Begin
86644>>>>>                        //*** get the attribute
86644>>>>>                        Call_driver 0 sDrvrId Function FUNC_SQLCOLINTATTRIB ;                                    Callback Current_Object ;                                    Passing sEmpty sEmpty iAttribId ;                                    Result sResult
86649>>>>>                    End
86649>>>>>>
86649>>>>>                End
86649>>>>>>
86649>>>>>            End
86649>>>>>>
86649>>>>>            Else ;                Send StmtError CLIERR_SQLINVALID_COLUMN ("(Column number = " + String(iCol) + ")") "SQLPrivateColAttribute"
86651>>>>>        End
86651>>>>>>
86651>>>>>        Else ;            Send HandleError ihstmt ihdbc sDrvrId "SQLPrivateColAttribute"
86653>>>>>
86653>>>>>        Function_Return sResult
86654>>>>>    End_Function // SQLPrivateColAttribute
86655>>>>>
