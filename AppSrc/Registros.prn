81332>>>            Move (Sformat ("%1-Page%2.%3", sBaseName, iPageNumber, sExtension)) to sFileNames[iElement]
81333>>>        End
81333>>>>
81333>>>        Else Begin
81334>>>            For iPage from 1 to iPages
81340>>>>
81340>>>                Move (Sformat ("%1-Page%2.%3", sBaseName, iPage, sExtension)) to sFileNames[iElement]
81341>>>                Increment iElement
81342>>>            Loop
81343>>>>
81343>>>        End
81343>>>>
81343>>>
81343>>>        Function_Return sFileNames
