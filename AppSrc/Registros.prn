84891>//FUNCIONES GLOBALES
84891>Function fSQL_date Global Date d_Fecha Returns String
84893>    Local String  s_Fecha
84893>    Local Integer i_Formato
84893>
84893>    Get_date_format to i_formato
84894>
84894>    Move "'" to s_Fecha
84895>    //Move "" to s_Fecha
84895>
84895>    If i_Formato eq 0 Begin  // Fecha formato USA mes/dia/año
84897>        Append s_Fecha (Mid(d_Fecha,4,7))
84898>        Append s_Fecha (Mid(d_Fecha,2,1))
84899>        Append s_Fecha (Mid(d_Fecha,2,4))
84900>    End
84900>    If i_formato eq 1 Begin  // Fecha formato europeo dia/mes/año
84902>        Append s_Fecha (Mid(d_Fecha,4,7))
84903>        Append s_Fecha (Mid(d_Fecha,2,4))
84904>        Append s_Fecha (Mid(d_Fecha,2,1))
84905>    End
84905>    If i_formato eq 2 Begin  // Fecha formato militar año/mes/dia
84907>        Append s_Fecha (Mid(d_Fecha,4,1))
84908>        Append s_Fecha (Mid(d_Fecha,2,6))
84909>        Append s_Fecha (Mid(d_Fecha,2,9))
84910>    End
84910>
84910>    Append s_Fecha "'"
84911>    Function_Return s_Fecha
84912>End_Function
