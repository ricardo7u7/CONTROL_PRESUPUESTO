81424>>>    // Returns a text string which contains information about the filters defined in the report
81424>>>    Function FilterInformation String sReportId Returns String
81426>>>        Integer iFilters iFilter eFilterOperator
81426>>>        String sFilterField sFilterValue sInfo
81426>>>        
81426>>>        Get FilterCount sReportId to iFilters
81427>>>        If (iFilters > 0) Begin
81429>>>            Decrement iFilters
81430>>>            For iFilter from 0 to iFilters
81436>>>>
81436>>>                Get psFilterField sReportId iFilter to sFilterField
81437>>>                Move (Mid (sFilterField, Length(sFilterField) - 2, 2)) to sFilterField
81438>>>                If (sInfo <> '') Begin
81440>>>                    Move (sInfo + "+Chr(10)+") to sInfo
81441>>>                End
81441>>>>
81441>>>                Get peFilterOperator sReportId iFilter to eFilterOperator
81442>>>                Get psFilterValue sReportId iFilter to sFilterValue
81443>>>                Move (sInfo + Sformat ("'%1 %2 %3'", sFilterField, Mid ("= <>> >=< <=", 2, eFilterOperator - 1 * 2 + 1), sFilterValue)) to sInfo
81444>>>            Loop
81445>>>>
81445>>>        End
81445>>>>
81445>>>        
81445>>>        Function_Return sInfo
81446>>>    End_Function
